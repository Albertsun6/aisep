@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .

# AISEP module manifest — code & delivery traceability extension (spec §6.7): CodeLocation,
# Implementation (CodeLocation -> design element), Deployable (⊑ am4:Artifact).
# aisep:ownsNamespace is NOT declared: aisep# is shared with aisep-core and the other ext-* modules.
# Deployable inherits the am4 relationship tables through its am4:Artifact superclass
# (am4rt: Artifact permitsDirectRealization ApplicationComponent — checked in the vendored tables).

<https://aisep.example/module/ext-code>
    a                arch:Metamodel ;
    skos:prefLabel   "代码与交付追溯扩展"@zh ;
    skos:altLabel    "Code and delivery traceability extension"@en ;
    aisep:moduleKind aisep:Extension ;
    owl:versionInfo  "0.2.0" ;
    aisep:loads      "vendor/meta.linked.archi/ttl/core.ttl" ,
                     "vendor/meta.linked.archi/ttl/archimate4_onto.ttl" ,
                     "modules/ext-code/onto.ttl" ;
    aisep:shapesFile "modules/ext-code/shapes.ttl" ;
    aisep:impactFile "modules/ext-code/impact.ttl" .   # spec v0.2 §5/§9: only declared overrides take effect
