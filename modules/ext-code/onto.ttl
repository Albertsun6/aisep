@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix arch:   <https://meta.linked.archi/core#> .
@prefix am4:    <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep:  <https://aisep.example/ont/aisep#> .

# Code & delivery traceability vocabulary (spec §6.7). License: CC-BY-4.0.
# schema:codeRepository is used as-is (schema: = <https://schema.org/>; spec v0.2 §6.7
# fixes the https form for every AISEP file — v0.1 mixed http/https). SPDX 3.0.1 IRIs are mapping targets only (not loaded).
# Build/deploy provenance: prov:Activity (PROV-O) as-is; no AISEP terms needed in batch 1.

<https://aisep.example/ont/aisep/ext-code> a owl:Ontology ;
    rdfs:label "AISEP code and delivery traceability extension"@en ;
    owl:versionInfo "0.1.0" .

# A node (location in a source repository). An arch:Element so it can be the source of a qualified
# relationship and so the closed-world rules apply. NOT an am4:Artifact: the repository is a property
# of the location, never a second Artifact competing for realizes (spec §6.7).
aisep:CodeLocation a owl:Class ;
    rdfs:subClassOf arch:Element ;
    skos:prefLabel "代码位置"@zh , "Code location"@en ;
    skos:definition "A path (and optionally a symbol) inside a source repository; properties schema:codeRepository, aisep:path, aisep:symbol, aisep:swhid."@en .

aisep:path a owl:DatatypeProperty ;
    rdfs:domain aisep:CodeLocation ; rdfs:range xsd:string ;
    skos:prefLabel "路径"@zh , "path"@en ;
    skos:definition "Repository-relative file or directory path."@en .

aisep:symbol a owl:DatatypeProperty ;
    rdfs:domain aisep:CodeLocation ; rdfs:range xsd:string ;
    skos:prefLabel "符号"@zh , "symbol"@en ;
    skos:definition "Optional fully qualified code symbol (class, function) within the path."@en .

aisep:swhid a owl:DatatypeProperty ;
    rdfs:domain aisep:CodeLocation ; rdfs:range xsd:string ;
    skos:prefLabel "软件遗产标识"@zh , "SWHID"@en ;
    skos:definition "Optional Software Heritage identifier (swh:1:<type>:<40 hex>[;qualifiers]) anchoring the location to a commit."@en .

aisep:Implementation a owl:Class ;
    rdfs:subClassOf arch:QualifiedRelationship ;
    arch:unqualifiedForm aisep:implements ;
    skos:prefLabel "实现"@zh , "Implementation"@en ;
    skos:definition "Qualified relationship from a CodeLocation (source) to the design element it implements (target)."@en .

aisep:implements a owl:ObjectProperty ;
    rdfs:domain aisep:CodeLocation ;
    rdfs:range arch:Element ;
    skos:prefLabel "实现"@zh , "implements"@en ;
    skos:definition "Direct form of aisep:Implementation. Generated by `aisep build`; never authored."@en .

aisep:Deployable a owl:Class ;
    rdfs:subClassOf am4:Artifact ;
    skos:prefLabel "可部署包"@zh , "Deployable"@en ;
    skos:definition "A deployable package identified by a package URL (purl)."@en ;
    skos:closeMatch <https://spdx.org/rdf/3.0.1/terms/Software/Package> .

aisep:packageUrl a owl:DatatypeProperty ;
    rdfs:domain aisep:Deployable ; rdfs:range xsd:string ;
    skos:prefLabel "包 URL"@zh , "package URL"@en ;
    skos:definition "Package URL (purl), e.g. pkg:npm/quote-service@1.4.0."@en ;
    skos:exactMatch <https://spdx.org/rdf/3.0.1/terms/Software/packageUrl> .
