# expect: EC5:
# Invalid: Implementation drawn from an application component instead of a CodeLocation.
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix arch:   <https://meta.linked.archi/core#> .
@prefix am4:    <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep:  <https://aisep.example/ont/aisep#> .
@prefix :       <https://aisep.example/model/ext-code-test/> .

:model a arch:Model ;
    skos:prefLabel "代码追溯测试模型"@zh .

:quoteSvc a am4:ApplicationComponent ;
    arch:inModel :model ;
    skos:prefLabel "报价服务"@zh .

:otherSvc a am4:ApplicationComponent ;
    arch:inModel :model ;
    skos:prefLabel "审批服务"@zh .

:implBad a aisep:Implementation ;
    arch:inModel :model ;
    arch:source :otherSvc ;
    arch:target :quoteSvc .
