# expect: one notation per element
# modules: ddd
# R2 (audit a16): a DDD aggregate also typed am4:DataObject; use two nodes + arch:Refines instead.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix ddd:  <https://aisep.example/ont/ddd#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:ag a ddd:Aggregate , am4:DataObject ; arch:inModel :t ; skos:prefLabel "聚合"@zh .
