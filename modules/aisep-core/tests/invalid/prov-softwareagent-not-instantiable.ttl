# expect: type prov:SoftwareAgent is not a class declared
# T28: the aisep-core alignment axiom prov:SoftwareAgent ⊑ prov:Agent does not make prov:SoftwareAgent instantiable.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:ac a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件"@zh .
:boss a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "架构师"@zh .
:bot a aisep:AIAgent ; arch:inModel :t ; skos:prefLabel "编码代理"@zh .
:sw a prov:SoftwareAgent ; arch:inModel :t ; skos:prefLabel "软件代理"@zh .
