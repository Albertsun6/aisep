# expect: a 40-hex git commit id or sha256:<64 hex>
# G3 (audit n07, n20): aisep:evidence must match ^[0-9a-f]{40}$ or ^sha256:[0-9a-f]{64}$ (not empty, blank or 'git:abc').
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:ac a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件"@zh .
:boss a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "架构师"@zh .
:ac2 a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件二"@zh .
:rec a aisep:ApprovalRecord ; arch:inModel :t ; skos:prefLabel "记录rec"@zh ;
    aisep:gate aisep:GateArchitecture ; aisep:decision aisep:DecisionApproved ; aisep:approvedBy :boss ; aisep:approves :ac ;
    aisep:evidence "git:abc" ; prov:generatedAtTime "2026-11-19T10:00:00Z"^^xsd:dateTime .
:rec2 a aisep:ApprovalRecord ; arch:inModel :t ; skos:prefLabel "记录rec2"@zh ;
    aisep:gate aisep:GateArchitecture ; aisep:decision aisep:DecisionApproved ; aisep:approvedBy :boss ; aisep:approves :ac2 ;
    aisep:evidence "   " ; prov:generatedAtTime "2026-11-19T10:00:00Z"^^xsd:dateTime .
