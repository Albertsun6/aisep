# expect: model files must not add members to module concept schemes
# G2 (audit n11): gate membership is judged on module files only; a model file adding a member to aisep:Gates is R1.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:ac a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件"@zh .
:boss a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "架构师"@zh .
:myGate a skos:Concept ; skos:inScheme aisep:Gates ; skos:prefLabel "我的关口"@zh .
:rec a aisep:ApprovalRecord ; arch:inModel :t ; skos:prefLabel "记录rec"@zh ;
    aisep:gate :myGate ; aisep:decision aisep:DecisionApproved ; aisep:approvedBy :boss ; aisep:approves :ac ;
    aisep:evidence "3f2a9c1e7b4d5a6f8e9c0b1a2d3e4f5a6b7c8d9e" ; prov:generatedAtTime "2026-11-19T10:00:00Z"^^xsd:dateTime .
