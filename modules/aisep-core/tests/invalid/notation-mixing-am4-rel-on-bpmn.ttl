# expect: only through arch:Refines
# modules: bpmn
# Audit case I (spec §7.3): an am4:Triggering between two BPMN tasks (BPMN does not inherit the hub rules).
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix am4vp: <https://meta.linked.archi/archimate4/viewpoints#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:first a bpmn:UserTask ; arch:inModel :t ; skos:prefLabel "一级审批"@zh .
:second a bpmn:UserTask ; arch:inModel :t ; skos:prefLabel "二级审批"@zh .
:rel-first-triggers-second a am4:Triggering ; arch:inModel :t ; arch:source :first ; arch:target :second .
