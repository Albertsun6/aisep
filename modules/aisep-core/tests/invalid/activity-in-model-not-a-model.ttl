# expect: agent activity must be a model element, an IRI with arch:inModel
# #78 评审 minor 3 invalid: an IRI agent activity whose arch:inModel names a resource that is not an arch:Model.
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .
:t a arch:Model ; skos:prefLabel "测试模型"@zh .
:ac a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件"@zh .
:boss a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "架构师"@zh .
:bot a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "编码代理"@zh .
:nowhere skos:prefLabel "不是模型"@zh .
:act a aisep:AgentActivity ; prov:wasAssociatedWith :bot ; prov:startedAtTime "2026-11-20T01:00:00Z"^^xsd:dateTime ; prov:endedAtTime "2026-11-20T02:00:00Z"^^xsd:dateTime ; aisep:sessionRef "s" ; aisep:branch "b" ; aisep:baseCommit "0a1b2c3d4e5f60718293a4b5c6d7e8f901234567" ; aisep:headCommit "3f2a9c1e7b4d5a6f8e9c0b1a2d3e4f5a6b7c8d9e" ; arch:inModel :nowhere ; skos:prefLabel "AI 活动"@zh .
