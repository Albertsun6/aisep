# modules: bpmn
# G5 valid: arch:Association within BPMN, arch:HasPart within am4, and between two notation-neutral nodes.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:t1 a bpmn:Task ; arch:inModel :t ; skos:prefLabel "任务一"@zh .
:t2 a bpmn:Task ; arch:inModel :t ; skos:prefLabel "任务二"@zh .
:r1 a arch:Association ; arch:inModel :t ; arch:source :t1 ; arch:target :t2 .
:a1 a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件一"@zh .
:a2 a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件二"@zh .
:r2 a arch:HasPart ; arch:inModel :t ; arch:source :a1 ; arch:target :a2 .
:s1 a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "干系人一"@zh .
:s2 a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "干系人二"@zh .
:r3 a arch:Association ; arch:inModel :t ; arch:source :s1 ; arch:target :s2 .
