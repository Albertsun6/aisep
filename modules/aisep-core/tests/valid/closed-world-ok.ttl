:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:crm a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "客户关系系统"@zh .
:billing a am4:ApplicationComponent , am4:ActiveStructureElement , arch:Element ; arch:inModel :t ;
    skos:prefLabel "计费系统"@zh ; skos:altLabel "Billing"@en .
:CloudServer rdfs:subClassOf am4:Device .
:srv1 a :CloudServer ; arch:inModel :t ; skos:prefLabel "云服务器一号"@zh ; skos:altLabel "Cloud server 1"@en ;
    arch:architectureState arch:Baseline .
:crmV2 a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "客户关系系统 V2"@zh .
:crm dcterms:isReplacedBy :crmV2 .
:rel-crm-serving-billing a am4:Serving ; arch:source :crm ; arch:target :billing ; arch:inModel :t ;
    arch:inView :view-apps .
:view-apps a arch:Diagram ; arch:inModel :t ; skos:prefLabel "应用协作视图"@zh ;
    arch:viewConformsToViewpoint am4vp:ApplicationCooperationViewpoint .
:crm arch:inView :view-apps . :billing arch:inView :view-apps .
:alice a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "张架构师"@zh .
:approval-20261101-crm a aisep:ApprovalRecord ; arch:inModel :t ; skos:prefLabel "客户关系系统架构评审"@zh ;
    aisep:gate aisep:GateArchitecture ; aisep:decision aisep:DecisionRejected ; aisep:approvedBy :alice ;
    prov:generatedAtTime "2026-11-01T10:00:00Z"^^xsd:dateTime ; aisep:approves :crm , :srv1 ;
    aisep:evidence "1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d" .
:approval-20261115-srv1 a aisep:ApprovalRecord ; arch:inModel :t ; skos:prefLabel "云服务器复审"@zh ;
