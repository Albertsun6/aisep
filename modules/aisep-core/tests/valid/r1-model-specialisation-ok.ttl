# R1 valid: single-parent specialisations (a chain is fine) with labels/definition, optionally typed owl:Class;
# owl:deprecated / rdfs:comment on instances are instance data, not metamodel changes.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix ddd:  <https://aisep.example/ont/ddd#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:CloudServer a owl:Class ; rdfs:subClassOf am4:Device ; skos:prefLabel "云服务器"@zh ; skos:altLabel "Cloud server"@en ;
    skos:definition "A rented virtual machine."@en .
:GpuServer rdfs:subClassOf :CloudServer ; rdfs:label "GPU server"@en .
:gpu1 a :GpuServer ; arch:inModel :t ; skos:prefLabel "推理服务器"@zh ; rdfs:comment "rack 3"@en .
:gpu0 a :GpuServer ; arch:inModel :t ; skos:prefLabel "旧推理服务器"@zh ; owl:deprecated true ; dcterms:isReplacedBy :gpu1 .
