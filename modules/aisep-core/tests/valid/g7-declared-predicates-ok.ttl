:t a arch:Model ; skos:prefLabel "测试模型"@zh .
:ac a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "组件"@zh ; skos:altLabel "Component"@en ;
    skos:definition "一个组件"@zh ; skos:note "备注"@zh ; rdfs:label "c" ; rdfs:comment "c" .
:boss a arch:Stakeholder ; arch:inModel :t ; skos:prefLabel "架构师"@zh .
:rec a aisep:ApprovalRecord ; arch:inModel :t ; skos:prefLabel "记录"@zh ;
    aisep:gate aisep:GateArchitecture ; aisep:decision aisep:DecisionApproved ; aisep:approvedBy :boss ; aisep:approves :ac ;
    aisep:evidence "0123456789abcdef0123456789abcdef01234567" ; prov:generatedAtTime "2026-11-19T10:00:00Z"^^xsd:dateTime .
