# Hub basics: qualified relationships only, legal by the ArchiMate 4.0 table; Grouping (patched) and a junction.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix am4:  <https://meta.linked.archi/archimate4/onto#> .
@prefix am4vp: <https://meta.linked.archi/archimate4/viewpoints#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix : <https://aisep.example/model/t/> .

:t a arch:Model ; skos:prefLabel "测试模型"@zh .

:crm a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "客户关系系统"@zh ; skos:altLabel "CRM"@en ;
    arch:architectureState arch:Target .
:billing a am4:ApplicationComponent ; arch:inModel :t ; skos:prefLabel "计费系统"@zh .
:customer a am4:DataObject ; arch:inModel :t ; skos:prefLabel "客户数据"@zh .
:sales a am4:Grouping ; arch:inModel :t ; skos:prefLabel "销售域"@zh .
:j1 a am4:OrJunction ; arch:inModel :t .
:rel-crm-serving-billing a am4:Serving ; arch:source :crm ; arch:target :billing ; arch:inModel :t .
:rel-crm-access-customer a am4:Access ; arch:source :crm ; arch:target :customer ; arch:inModel :t .
:rel-sales-aggregation-crm a am4:Aggregation ; arch:source :sales ; arch:target :crm ; arch:inModel :t .
:rel-crm-serving-j1 a am4:Serving ; arch:source :crm ; arch:target :j1 ; arch:inModel :t .
:rel-j1-serving-billing a am4:Serving ; arch:source :j1 ; arch:target :billing ; arch:inModel :t .
