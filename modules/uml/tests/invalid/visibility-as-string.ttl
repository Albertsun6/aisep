# expect: visibility must be a single member of the VisibilityKind enumeration
# Invalid per uml_shapes :NamedElementShape — uml:visibility takes an enumeration IRI (uml:Public), not a string.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix :     <https://aisep.example/model/uml-bad/> .

:model a arch:Model ; skos:prefLabel "UML 负例"@zh .
:Quotation a uml:Class ; arch:inModel :model ; skos:prefLabel "报价单"@zh ; uml:visibility "public" .
