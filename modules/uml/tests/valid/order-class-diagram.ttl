@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix uml:  <https://meta.linked.archi/uml/onto#> .
@prefix :     <https://aisep.example/model/uml-test/> .

# Valid UML class diagram: two classes, an association, a generalization, an interface
# (realized via uml:InterfaceRealization). Relationships are qualified resources with
# arch:source/arch:target only (direct triples uml:associatedWith etc. are generated by build).
# One @zh label per element: uml_shapes :NamedElementShape allows at most one skos:prefLabel.

:model a arch:Model ;
    skos:prefLabel "UML 测试模型"@zh .

:Quotation a uml:Class ;
    arch:inModel :model ;
    skos:prefLabel "报价单"@zh ;
    uml:visibility uml:Public ;
    uml:isAbstract false .

:Document a uml:Class ;
    arch:inModel :model ;
    skos:prefLabel "单据"@zh ;
    uml:isAbstract true .

:Supplier a uml:Class ;
    arch:inModel :model ;
    skos:prefLabel "供应商"@zh .

:Priceable a uml:Interface ;
    arch:inModel :model ;
    skos:prefLabel "可计价"@zh .

:assoc-quotation-supplier a uml:Association ;
    arch:inModel :model ;
    arch:source :Quotation ;
    arch:target :Supplier .

:gen-quotation-document a uml:Generalization ;
    arch:inModel :model ;
    arch:source :Quotation ;      # specific
    arch:target :Document .       # general

:real-quotation-priceable a uml:InterfaceRealization ;
    arch:inModel :model ;
    arch:source :Quotation ;
    arch:target :Priceable .
