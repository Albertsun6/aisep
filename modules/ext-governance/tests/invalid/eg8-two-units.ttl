# expect: EG8:
# Invalid: two aisep:unit values.
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix am4:   <https://meta.linked.archi/archimate4/onto#> .
@prefix ad:    <https://meta.linked.archi/arch-decision#> .
@prefix iso:   <https://meta.linked.archi/iso25010#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix :      <https://aisep.example/model/ext-governance-test/> .

:model a arch:Model ;
    skos:prefLabel "治理扩展测试模型"@zh .

:quoteSvc a am4:ApplicationComponent ;
    arch:inModel :model ;
    skos:prefLabel "报价服务"@zh ;
    arch:hasQualityMeasure :qmLatency .

:qmLatency a arch:QualityMeasure ;
    arch:inModel :model ;
    skos:prefLabel "报价审批 P95 延迟"@zh ;
    arch:measuredQualityAttribute iso:TimeBehaviour ;
    aisep:value "180"^^xsd:decimal ;
    aisep:unit "ms" , "s" ;
    aisep:target "200"^^xsd:decimal ;
    prov:generatedAtTime "2026-11-19T10:00:00Z"^^xsd:dateTime .
