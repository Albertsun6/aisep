# expect: EG4:
# Invalid: ad:RelatedConcept target is an untyped external IRI.
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix am4:   <https://meta.linked.archi/archimate4/onto#> .
@prefix ad:    <https://meta.linked.archi/arch-decision#> .
@prefix iso:   <https://meta.linked.archi/iso25010#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix :      <https://aisep.example/model/ext-governance-test/> .

:model a arch:Model ;
    skos:prefLabel "治理扩展测试模型"@zh .

:adrQueue a ad:Decision ;
    arch:inModel :model ;
    skos:prefLabel "报价审批改用消息队列"@zh ;
    ad:decisionState ad:Proposed .

:rel a ad:RelatedConcept ;
    arch:inModel :model ;
    arch:source :adrQueue ;
    arch:target <https://example.org/not-a-model-concept> .
