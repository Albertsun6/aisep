@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .

# AISEP module manifest — governance, decisions, quality (spec §6.6).
# Adopts the vendored Linked.Archi arch-decision ontology + its shapes unchanged
# (cc:license "http://creativecommons.org/licenses/by/4.0/" in arch-decision.ttl and arch-decision-shapes.ttl;
# arch-decision-shapes is SHACL Core only — no MINUS, no sh:sparql — and pyshacl 0.40 runs it).
# iso25010.ttl (CC-BY-4.0) supplies the quality characteristics used as arch:measuredQualityAttribute values.
# modules/aisep-core/onto.ttl supplies aisep:Rejected / aisep:Superseded (the approval states core lacks).
# aisep:ownsNamespace is NOT declared: aisep# is shared with aisep-core and the other ext-* modules.

<https://aisep.example/module/ext-governance>
    a                arch:Metamodel ;
    skos:prefLabel   "治理、决策与质量扩展"@zh ;
    skos:altLabel    "Governance, decision and quality extension"@en ;
    aisep:moduleKind aisep:Extension ;
    owl:versionInfo  "0.3.0" ;
    aisep:loads      "vendor/meta.linked.archi/ttl/core.ttl" ,
                     "vendor/meta.linked.archi/ttl/archimate4_onto.ttl" ,
                     "vendor/meta.linked.archi/ttl/arch-decision.ttl" ,
                     "vendor/meta.linked.archi/ttl/iso25010.ttl" ,
                     "modules/aisep-core/onto.ttl" ,
                     "modules/ext-governance/onto.ttl" ;
    aisep:shapesFile "vendor/meta.linked.archi/ttl/arch-decision-shapes.ttl" ,
                     "modules/ext-governance/shapes.ttl" ;
    aisep:impactFile "modules/ext-governance/impact.ttl" .   # spec §5/§9: only declared overrides take effect
