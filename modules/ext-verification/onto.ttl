@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix am4:   <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .

# Verification extension vocabulary (spec §6.5). License: CC-BY-4.0.
# OSLC QM 2.1 (http://open-services.net/ns/qm#) and RM 2.1 (http://open-services.net/ns/rm#) IRIs are
# mapping targets only; their vocabulary files are not loaded (spec §12).

<https://aisep.example/ont/aisep/ext-verification> a owl:Ontology ;
    rdfs:label "AISEP verification extension"@en ;
    owl:versionInfo "0.3.1" .

########## Classes ##########

# Deliberately NOT under any am4 class: ArchiMate has no test concept (spec §6.5).
aisep:TestCase a owl:Class ;
    rdfs:subClassOf arch:Element ;
    skos:prefLabel "测试用例"@zh , "Test case"@en ;
    skos:definition "A specification of a test that verifies one or more model concepts."@en ;
    skos:exactMatch <http://open-services.net/ns/qm#TestCase> .

aisep:Verification a owl:Class ;
    rdfs:subClassOf arch:QualifiedRelationship ;
    arch:unqualifiedForm aisep:verifies ;
    skos:prefLabel "验证"@zh , "Verification"@en ;
    skos:definition "Qualified relationship from a TestCase (source) to the model concept it verifies (target)."@en .

aisep:verifies a owl:ObjectProperty ;
    rdfs:domain aisep:TestCase ;
    rdfs:range arch:ModelConcept ;
    skos:prefLabel "验证"@zh , "verifies"@en ;
    skos:definition "Direct form of aisep:Verification. Generated by `aisep build`; never authored."@en ;
    # oslc_qm:validatesRequirement only targets requirements; aisep:verifies targets any ModelConcept.
    skos:narrowMatch <http://open-services.net/ns/qm#validatesRequirement> .

# A criterion is a Requirement aggregated by its parent Requirement (am4:Aggregation,
# am4rt:permitsDirectAggregation Requirement->Requirement). OSLC RM has no acceptance-criterion term;
# the closest is an oslc_rm:Requirement reached by oslc_rm:decomposedBy.
aisep:AcceptanceCriterion a owl:Class ;
    rdfs:subClassOf am4:Requirement ;
    skos:prefLabel "验收标准"@zh , "Acceptance criterion"@en ;
    skos:definition "A testable condition a parent Requirement must meet; aggregated by that Requirement."@en ;
    skos:broadMatch <http://open-services.net/ns/rm#Requirement> .

aisep:gherkin a owl:DatatypeProperty ;
    rdfs:domain aisep:AcceptanceCriterion ;
    rdfs:range xsd:string ;
    skos:prefLabel "Gherkin 文本"@zh , "gherkin"@en ;
    skos:definition "Optional Given/When/Then text of the acceptance criterion."@en .

# A node, not a view element: but it is an arch:Element so that the closed-world rules (single type,
# arch:inModel, @zh label) apply uniformly.
aisep:TestResult a owl:Class ;
    rdfs:subClassOf arch:Element ;
    skos:prefLabel "测试结果"@zh , "Test result"@en ;
    skos:definition "The outcome of one execution of a TestCase."@en ;
    skos:exactMatch <http://open-services.net/ns/qm#TestResult> .

aisep:resultOf a owl:ObjectProperty ;
    rdfs:domain aisep:TestResult ;
    rdfs:range aisep:TestCase ;
    skos:prefLabel "结果所属用例"@zh , "result of"@en ;
    skos:exactMatch <http://open-services.net/ns/qm#reportsOnTestCase> .

aisep:verdict a owl:ObjectProperty ;
    rdfs:domain aisep:TestResult ;
    rdfs:range skos:Concept ;
    skos:prefLabel "判定"@zh , "verdict"@en ;
    skos:definition "Outcome of the run; one concept of aisep:VerdictScheme. Timestamp: prov:generatedAtTime."@en ;
    # oslc_qm:status is a provider-defined literal; ours is a closed SKOS scheme.
    skos:closeMatch <http://open-services.net/ns/qm#status> .

# Provenance of one run (v0.3.0): which commit was tested and which CI run produced the result. The repository is
# schema:codeRepository (an authoring-profile predicate, G7). Both optional; EV11–EV14 in shapes.ttl. They anchor a
# result to a commit without touching the (approved, long-lived) aisep:CodeLocation.
aisep:testedCommit a owl:DatatypeProperty ;
    rdfs:domain aisep:TestResult ;
    rdfs:range xsd:string ;
    skos:prefLabel "被测提交"@zh , "tested commit"@en ;
    skos:definition "The 40-hex git commit id the run tested (same form as aisep:headCommit)."@en .

aisep:ciRun a owl:ObjectProperty ;
    rdfs:domain aisep:TestResult ;
    skos:prefLabel "CI 运行"@zh , "CI run"@en ;
    skos:definition "IRI of the CI run (e.g. a GitHub Actions run or job URL) that produced the result."@en .

########## Verdict scheme ##########

aisep:VerdictScheme a skos:ConceptScheme ;
    skos:prefLabel "测试判定"@zh , "Test verdict"@en .

aisep:VerdictPassed  a skos:Concept ; skos:inScheme aisep:VerdictScheme ; skos:notation "passed" ;
    skos:prefLabel "通过"@zh , "passed"@en .
aisep:VerdictFailed  a skos:Concept ; skos:inScheme aisep:VerdictScheme ; skos:notation "failed" ;
    skos:prefLabel "失败"@zh , "failed"@en .
aisep:VerdictBlocked a skos:Concept ; skos:inScheme aisep:VerdictScheme ; skos:notation "blocked" ;
    skos:prefLabel "受阻"@zh , "blocked"@en .
aisep:VerdictSkipped a skos:Concept ; skos:inScheme aisep:VerdictScheme ; skos:notation "skipped" ;
    skos:prefLabel "跳过"@zh , "skipped"@en .
aisep:VerdictError   a skos:Concept ; skos:inScheme aisep:VerdictScheme ; skos:notation "error" ;
    skos:prefLabel "出错"@zh , "error"@en .

########## MoSCoW priority (spec v0.2 §6.5) ##########
# Only Must-level requirements / acceptance criteria without a TestCase are L4 trace gaps.

aisep:priority a owl:ObjectProperty ;
    rdfs:domain am4:Requirement ;
    rdfs:range skos:Concept ;
    skos:prefLabel "优先级"@zh ; skos:altLabel "priority"@en ;
    skos:definition "MoSCoW priority of a requirement or acceptance criterion; one concept of aisep:Priorities."@en ;
    skos:closeMatch <http://open-services.net/ns/rm#priority> .

aisep:Priorities a skos:ConceptScheme ;
    skos:prefLabel "MoSCoW 优先级"@zh ; skos:altLabel "MoSCoW priorities"@en ;
    skos:hasTopConcept aisep:Must , aisep:Should , aisep:Could , aisep:Wont .
aisep:Must   a skos:Concept ; skos:inScheme aisep:Priorities ; skos:notation "M" ; skos:prefLabel "必须"@zh ; skos:altLabel "Must have"@en .
aisep:Should a skos:Concept ; skos:inScheme aisep:Priorities ; skos:notation "S" ; skos:prefLabel "应该"@zh ; skos:altLabel "Should have"@en .
aisep:Could  a skos:Concept ; skos:inScheme aisep:Priorities ; skos:notation "C" ; skos:prefLabel "可以"@zh ; skos:altLabel "Could have"@en .
aisep:Wont   a skos:Concept ; skos:inScheme aisep:Priorities ; skos:notation "W" ; skos:prefLabel "暂不"@zh ; skos:altLabel "Won't have (this time)"@en .
