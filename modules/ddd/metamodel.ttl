@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix ddd:   <https://aisep.example/ont/ddd#> .

ddd:metamodel a arch:Metamodel ;
    skos:prefLabel "领域驱动设计"@zh ; skos:altLabel "DDD"@en ;
    aisep:moduleKind aisep:Language ;
    owl:versionInfo "0.3.0" ;
    aisep:loads "vendor/meta.linked.archi/ttl/core.ttl" ,
                "vendor/meta.linked.archi/ttl/archimate4_onto.ttl" ,
                "modules/ddd/onto.ttl" ,
                "modules/ddd/align.ttl" ;
    aisep:shapesFile "modules/ddd/shapes.ttl" ;
    aisep:alignmentFile "modules/ddd/align.ttl" ;
    aisep:inheritsHubRules true ;
    aisep:notationLevel aisep:LevelDesign ;   # spec v0.2 §5/§7.2
    aisep:ownsNamespace "https://aisep.example/ont/ddd#" .
