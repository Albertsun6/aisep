# expect: EA5:
# Invalid: a list and member written as IRI nodes, the member untyped. sh:nodeKind sh:BlankNode fires; an untyped blank-node member (sh:class aisep:ActionStep alone) is covered by test_gate_names_the_shape_of_each_catalogue_defect.
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix aisep:   <https://aisep.example/ont/aisep#> .
@prefix ap:      <https://aisep.example/ont/ext-actions#> .
@prefix :        <https://aisep.example/model/ext-actions-test/> .

aisep:ActionTestBad a aisep:ActionType ;
    dcterms:identifier "bad" ;
    skos:prefLabel "坏动作"@zh ;
    owl:versionInfo "1.0.0" ;
    aisep:steps :list .
:list rdf:first :member ;
    rdf:rest rdf:nil .
:member aisep:invokes aisep:BasicRemove .
