@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix am4:   <https://meta.linked.archi/archimate4/onto#> .
@prefix :      <https://aisep.example/model/ext-actions-test/> .

# Valid: a minimal model. The manifest lists modules/ext-actions/catalog.ttl in aisep:toolingLoads, which puts it into
# this module's L3 data graph (ADR-030), so this fixture passes only when the shipped catalogue satisfies EA1-EA11.

:model a arch:Model ;
    skos:prefLabel "动作扩展测试模型"@zh .

:req a am4:Requirement ;
    arch:inModel :model ;
    skos:prefLabel "需求"@zh .
