{
  "version": 1,
  "actions": [
    {
      "id": "register-acceptance-criterion",
      "title": "登记验收标准并挂到需求",
      "description": "新增一个 aisep:AcceptanceCriterion 元素，并用一条 am4:Aggregation（源 = 父需求，目标 = 验收标准）把它挂到指定需求。等价于依次调用 model_add_element 与 model_add_relationship，但两步在一次写入里全有或全无。",
      "params": {
        "type": "object",
        "properties": {
          "requirement": {"type": "string", "description": "父需求的完整 IRI（https://aisep.example/model/<slug>/<名>）"},
          "prefLabel": {"type": "string", "description": "验收标准的中文名称"},
          "altLabel": {"type": "string", "description": "英文名称；没给 slug 时用它生成 IRI"},
          "slug": {"type": "string", "description": "IRI 的本地名，^[A-Za-z][A-Za-z0-9]*$"},
          "definition": {"type": "string", "description": "中文定义"},
          "gherkin": {"type": "string", "description": "Given / When / Then 文本，写入 aisep:gherkin"},
          "file": {"type": "string", "description": "验收标准落在哪个文件；缺省按 model_add_element 的规则"},
          "relationshipFile": {"type": "string", "description": "聚合关系落在哪个文件；缺省按 model_add_relationship 的规则"}
        },
        "required": ["requirement", "prefLabel"],
        "additionalProperties": false
      },
      "iriParams": ["requirement"],
      "guards": [
        {
          "id": "parent-is-not-a-criterion",
          "ask": "ASK { ?requirement a aisep:AcceptanceCriterion }",
          "bind": {"requirement": {"param": "requirement"}},
          "expect": false,
          "hint": "requirement 指向的是另一条验收标准。验收标准应挂在它所属的需求上，请把 requirement 换成那条需求的 IRI。"
        },
        {
          "id": "parent-is-not-deprecated",
          "ask": "ASK { ?requirement owl:deprecated true }",
          "bind": {"requirement": {"param": "requirement"}},
          "expect": false,
          "hint": "requirement 指向的需求已退役（owl:deprecated true）。请挂到替代它的需求上（见它的 dcterms:isReplacedBy）。"
        }
      ],
      "steps": [
        {
          "id": "criterion",
          "op": "add_element",
          "args": {
            "model": {"modelOf": "requirement"},
            "type": {"const": "aisep:AcceptanceCriterion"},
            "prefLabel": {"param": "prefLabel"},
            "altLabel": {"param": "altLabel"},
            "slug": {"param": "slug"},
            "definition": {"param": "definition"},
            "attributes": [
              {"predicate": {"const": "aisep:gherkin"}, "value": {"value": {"param": "gherkin"}}}
            ],
            "file": {"param": "file"}
          }
        },
        {
          "id": "aggregation",
          "op": "add_relationship",
          "args": {
            "type": {"const": "am4:Aggregation"},
            "source": {"param": "requirement"},
            "target": {"stepIri": "criterion"},
            "file": {"param": "relationshipFile"}
          }
        }
      ]
    },
    {
      "id": "remove-element",
      "title": "删除元素",
      "description": "删除一个元素、关系或视图，连带以它为端点的关系并摘除成员关系（同 model_remove 的 cascade）。破坏性动作：必须先 dryRun 看计划与影响摘要，再带 planDigest 执行。",
      "params": {
        "type": "object",
        "properties": {
          "iri": {"type": "string", "description": "要删除的资源的完整 IRI"}
        },
        "required": ["iri"],
        "additionalProperties": false
      },
      "iriParams": ["iri"],
      "guards": [],
      "steps": [
        {"id": "remove", "op": "remove", "args": {"iri": {"param": "iri"}}}
      ]
    }
  ]
}
