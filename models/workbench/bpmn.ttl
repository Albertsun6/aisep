@prefix : <https://aisep.example/model/workbench/> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix bpmn: <https://meta.linked.archi/bpmn/onto#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:bpmnApvStart a bpmn:StartEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "打开关口页"@zh .

:bpmnApvChooseModel a bpmn:UserTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "选择被批模型"@zh .

:bpmnApvApproverGateway a bpmn:ExclusiveGateway ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "被批模型有几个人类干系人？"@zh ;
    bpmn:gatewayDirection "Diverging" .

:bpmnApvBlocked a bpmn:EndEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "不能批准"@zh .

:bpmnApvPreselect a bpmn:ServiceTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "自动选上唯一的批准人"@zh .

:bpmnApvPickApprover a bpmn:UserTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "自己选批准人"@zh .

:bpmnApvDecide a bpmn:UserTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "选关口、勾元素并批准或驳回"@zh .

:bpmnApvRecorded a bpmn:EndEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准记录写入分支"@zh .

:rel-bpmnApvStart-sequenceFlow-bpmnApvChooseModel a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvStart ;
    arch:target :bpmnApvChooseModel .

:rel-bpmnApvChooseModel-sequenceFlow-bpmnApvApproverGateway a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvChooseModel ;
    arch:target :bpmnApvApproverGateway .

:rel-bpmnApvApproverGateway-sequenceFlow-bpmnApvPickApprover a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvApproverGateway ;
    arch:target :bpmnApvPickApprover ;
    skos:prefLabel "两个及以上"@zh .

:rel-bpmnApvApproverGateway-sequenceFlow-bpmnApvPreselect a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvApproverGateway ;
    arch:target :bpmnApvPreselect ;
    skos:prefLabel "恰好一个"@zh .

:rel-bpmnApvApproverGateway-sequenceFlow-bpmnApvBlocked a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvApproverGateway ;
    arch:target :bpmnApvBlocked ;
    skos:prefLabel "没有或读不到"@zh .

:rel-bpmnApvPreselect-sequenceFlow-bpmnApvDecide a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvPreselect ;
    arch:target :bpmnApvDecide .

:rel-bpmnApvPickApprover-sequenceFlow-bpmnApvDecide a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvPickApprover ;
    arch:target :bpmnApvDecide .

:rel-bpmnApvDecide-sequenceFlow-bpmnApvRecorded a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApvDecide ;
    arch:target :bpmnApvRecorded .

:bpmnApproverSelection a bpmn:Process ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口页选批准人并批准"@zh ;
    bpmn:processType "Private" ;
    bpmn:isExecutable "false"^^xsd:boolean ;
    bpmn:flowElements :bpmnApvStart ;
    bpmn:flowElements :bpmnApvChooseModel ;
    bpmn:flowElements :bpmnApvApproverGateway ;
    bpmn:flowElements :bpmnApvBlocked ;
    bpmn:flowElements :bpmnApvPreselect ;
    bpmn:flowElements :bpmnApvPickApprover ;
    bpmn:flowElements :bpmnApvDecide ;
    bpmn:flowElements :bpmnApvRecorded ;
    bpmn:flowElements :rel-bpmnApvStart-sequenceFlow-bpmnApvChooseModel ;
    bpmn:flowElements :rel-bpmnApvChooseModel-sequenceFlow-bpmnApvApproverGateway ;
    bpmn:flowElements :rel-bpmnApvApproverGateway-sequenceFlow-bpmnApvPickApprover ;
    bpmn:flowElements :rel-bpmnApvApproverGateway-sequenceFlow-bpmnApvPreselect ;
    bpmn:flowElements :rel-bpmnApvApproverGateway-sequenceFlow-bpmnApvBlocked ;
    bpmn:flowElements :rel-bpmnApvPreselect-sequenceFlow-bpmnApvDecide ;
    bpmn:flowElements :rel-bpmnApvPickApprover-sequenceFlow-bpmnApvDecide ;
    bpmn:flowElements :rel-bpmnApvDecide-sequenceFlow-bpmnApvRecorded .

:rel-bpmnApproverSelection-refines-gateApprovalFlow a arch:Refines ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnApproverSelection ;
    arch:target :gateApprovalFlow .


:bpmnRelStart a bpmn:StartEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "准备发布"@zh .

:bpmnRelPrepare a bpmn:ServiceTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "会话脚本：从 origin/main 最新提交拉发布批准分支"@zh .

:bpmnRelOpenGate a bpmn:UserTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "Albert 在关口页打开发布批准分支"@zh .

:bpmnRelStaleGateway a bpmn:ExclusiveGateway ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "分支基于的提交还是 origin/main 最新提交吗？"@zh ;
    bpmn:gatewayDirection "Diverging" .

:bpmnRelStale a bpmn:EndEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "提示重新准备分支"@zh .

:bpmnRelDecide a bpmn:UserTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "Albert 批准（gate 通过时）或驳回发布"@zh .

:bpmnRelDecisionGateway a bpmn:ExclusiveGateway ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "结论是批准吗？"@zh ;
    bpmn:gatewayDirection "Diverging" .

:bpmnRelTag a bpmn:ServiceTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "会话脚本：跑合并时校验，批准才打 release 标签"@zh .

:bpmnRelPublish a bpmn:ServiceTask ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "会话脚本：推送并开批准专用 PR"@zh .

:bpmnRelOpened a bpmn:EndEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准专用 PR 已开出"@zh .

:rel-bpmnRelStart-sequenceFlow-bpmnRelPrepare a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelStart ;
    arch:target :bpmnRelPrepare .

:rel-bpmnRelPrepare-sequenceFlow-bpmnRelOpenGate a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelPrepare ;
    arch:target :bpmnRelOpenGate .

:rel-bpmnRelOpenGate-sequenceFlow-bpmnRelStaleGateway a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelOpenGate ;
    arch:target :bpmnRelStaleGateway .

:rel-bpmnRelStaleGateway-sequenceFlow-bpmnRelDecide a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelStaleGateway ;
    arch:target :bpmnRelDecide ;
    skos:prefLabel "仍是最新"@zh .

:rel-bpmnRelStaleGateway-sequenceFlow-bpmnRelStale a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelStaleGateway ;
    arch:target :bpmnRelStale ;
    skos:prefLabel "已前进"@zh .

:rel-bpmnRelDecide-sequenceFlow-bpmnRelDecisionGateway a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelDecide ;
    arch:target :bpmnRelDecisionGateway .

:rel-bpmnRelDecisionGateway-sequenceFlow-bpmnRelTag a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelDecisionGateway ;
    arch:target :bpmnRelTag ;
    skos:prefLabel "批准"@zh .

:rel-bpmnRelDecisionGateway-sequenceFlow-bpmnRelPublish a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelDecisionGateway ;
    arch:target :bpmnRelPublish ;
    skos:prefLabel "驳回"@zh .


:rel-bpmnRelPublish-sequenceFlow-bpmnRelOpened a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelPublish ;
    arch:target :bpmnRelOpened .



:bpmnRelCheckGateway a bpmn:ExclusiveGateway ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "核对通过且标签不冲突吗？"@zh ;
    bpmn:gatewayDirection "Diverging" .

:bpmnRelStopped a bpmn:EndEvent ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "停下由人处理，什么都不推"@zh .

:rel-bpmnRelTag-sequenceFlow-bpmnRelCheckGateway a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelTag ;
    arch:target :bpmnRelCheckGateway .

:rel-bpmnRelCheckGateway-sequenceFlow-bpmnRelPublish a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelCheckGateway ;
    arch:target :bpmnRelPublish ;
    skos:prefLabel "通过"@zh .

:rel-bpmnRelCheckGateway-sequenceFlow-bpmnRelStopped a bpmn:SequenceFlow ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnRelCheckGateway ;
    arch:target :bpmnRelStopped ;
    skos:prefLabel "不通过或标签冲突"@zh .

:bpmnReleaseApproval a bpmn:Process ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准或驳回发布并打 release 标签"@zh ;
    bpmn:processType "Private" ;
    bpmn:isExecutable "false"^^xsd:boolean ;
    bpmn:flowElements :bpmnRelStart ;
    bpmn:flowElements :bpmnRelPrepare ;
    bpmn:flowElements :bpmnRelOpenGate ;
    bpmn:flowElements :bpmnRelStaleGateway ;
    bpmn:flowElements :bpmnRelStale ;
    bpmn:flowElements :bpmnRelDecide ;
    bpmn:flowElements :bpmnRelDecisionGateway ;
    bpmn:flowElements :bpmnRelTag ;
    bpmn:flowElements :bpmnRelCheckGateway ;
    bpmn:flowElements :bpmnRelStopped ;
    bpmn:flowElements :bpmnRelPublish ;
    bpmn:flowElements :bpmnRelOpened ;
    bpmn:flowElements :rel-bpmnRelStart-sequenceFlow-bpmnRelPrepare ;
    bpmn:flowElements :rel-bpmnRelPrepare-sequenceFlow-bpmnRelOpenGate ;
    bpmn:flowElements :rel-bpmnRelOpenGate-sequenceFlow-bpmnRelStaleGateway ;
    bpmn:flowElements :rel-bpmnRelStaleGateway-sequenceFlow-bpmnRelDecide ;
    bpmn:flowElements :rel-bpmnRelStaleGateway-sequenceFlow-bpmnRelStale ;
    bpmn:flowElements :rel-bpmnRelDecide-sequenceFlow-bpmnRelDecisionGateway ;
    bpmn:flowElements :rel-bpmnRelDecisionGateway-sequenceFlow-bpmnRelTag ;
    bpmn:flowElements :rel-bpmnRelDecisionGateway-sequenceFlow-bpmnRelPublish ;
    bpmn:flowElements :rel-bpmnRelPublish-sequenceFlow-bpmnRelOpened ;
    bpmn:flowElements :rel-bpmnRelTag-sequenceFlow-bpmnRelCheckGateway ;
    bpmn:flowElements :rel-bpmnRelCheckGateway-sequenceFlow-bpmnRelPublish ;
    bpmn:flowElements :rel-bpmnRelCheckGateway-sequenceFlow-bpmnRelStopped .

:rel-bpmnReleaseApproval-refines-gateApprovalFlow a arch:Refines ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :bpmnReleaseApproval ;
    arch:target :gateApprovalFlow .
