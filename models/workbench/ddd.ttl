@prefix : <https://aisep.example/model/workbench/> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix ddd: <https://aisep.example/ont/ddd#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix am4: <https://meta.linked.archi/archimate4/onto#> .

:governanceSubdomain a ddd:Subdomain ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "治理与批准"@zh ;
    skos:altLabel "Governance and approval"@en ;
    ddd:subdomainType ddd:Core .

:rel-gateApprovalFlow-realizes-governanceSubdomain a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :governanceSubdomain .

:workbenchGovernanceBC a ddd:BoundedContext ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台治理上下文"@zh ;
    skos:altLabel "Workbench governance"@en ;
    ddd:contextType ddd:Application .

:rel-workbenchGovernanceBC-implements-governanceSubdomain a ddd:SubdomainImplementation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :workbenchGovernanceBC ;
    arch:target :governanceSubdomain .

:workbenchLauncherBC a ddd:BoundedContext ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台本地启动与预检上下文"@zh ;
    skos:altLabel "Workbench local launch and preflight"@en ;
    skos:definition "一键启动脚本所在的上下文：起 aisep MCP 服务与工作台网页版，区分预览模式与批准模式的 allow-root，批准前只读预检。语言是进程、端口、专用检出、allow-root，与关口页的关口、批准记录、进度不同，所以和工作台治理上下文分开。"@zh ;
    ddd:contextType ddd:Application .

:rel-workbenchLauncherBC-implements-governanceSubdomain a ddd:SubdomainImplementation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :workbenchLauncherBC ;
    arch:target :governanceSubdomain .
