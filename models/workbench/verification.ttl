:acCoverageUnknownConfirm a aisep:AcceptanceCriterion ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "读不到批准记录时退回确认框"@zh ;
    skos:altLabel "Falls back to the confirmation when approval records cannot be read"@en ;
    aisep:gherkin "Given 关口页读不到分支上的批准记录\nWhen 用户准备批准或驳回\nThen 批准与驳回默认不可点，勾选「我确认要在这个分支上再写一条记录」后可点（与没有防护时的确认框行为一致）" .

:tcRepeatApprovalSameSelection a aisep:TestCase ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "同一选择重复批准被禁用测试"@zh ;
    skos:altLabel "Same-selection repeat approval is blocked test"@en ;
    skos:definition "aisep-workbench 仓库 frontend/src/renderer/aisep/AisepGatePage.test.tsx 中 describe「repeat approval guard: same selection」下的测试，以及 frontend/src/renderer/aisep/data/approval-progress.test.ts 中 describe「approval coverage」下的测试：刷新后同关口同元素不可批；先批架构再批设计后重批架构不可批；覆盖范围取有效内容提交到分支顶端之间的全部 Approved 记录，按关口取已批元素的并集。"@zh .

:tcRepeatApprovalOtherGateOrReject a aisep:TestCase ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "换关口、新元素、驳回与内容改动后仍可操作测试"@zh ;
    skos:altLabel "Another gate, a new element, a rejection or new content stays possible test"@en ;
    skos:definition "aisep-workbench 仓库 frontend/src/renderer/aisep/AisepGatePage.test.tsx 中 describe「repeat approval guard: other gate or reject」下的测试：换关口、勾选新元素、驳回经确认框后可点；批准之后又有内容提交时可以再批。"@zh .

