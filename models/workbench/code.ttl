@prefix : <https://aisep.example/model/workbench/> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix arch: <https://meta.linked.archi/core#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

:approvalProgressCode a aisep:CodeLocation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准进度展示前端代码"@zh ;
    skos:altLabel "Approval progress UI code"@en ;
    schema:codeRepository <https://github.com/Albertsun6/aisep-workbench> ;
    aisep:path "frontend/src/renderer/aisep/data/approval-progress.ts" .

:rel-approvalProgressCode-implements-workbenchGovernanceBC a aisep:Implementation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :approvalProgressCode ;
    arch:target :workbenchGovernanceBC .

:devLauncherCode a aisep:CodeLocation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台一键启动脚本"@zh ;
    skos:altLabel "Workbench one-step launcher script"@en ;
    schema:codeRepository <https://github.com/Albertsun6/aisep-workbench> ;
    aisep:path "scripts/aisep-dev.mjs" .

:rel-devLauncherCode-implements-workbenchLauncherBC a aisep:Implementation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :devLauncherCode ;
    arch:target :workbenchLauncherBC .

:gatePageCode a aisep:CodeLocation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口页前端代码"@zh ;
    skos:altLabel "Gate page UI code"@en ;
    schema:codeRepository <https://github.com/Albertsun6/aisep-workbench> ;
    aisep:path "frontend/src/renderer/aisep/AisepGatePage.tsx" .

:rel-gatePageCode-implements-workbenchGovernanceBC a aisep:Implementation ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gatePageCode ;
    arch:target :workbenchGovernanceBC .
