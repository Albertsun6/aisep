# AISEP 工作台模型 — 治理部分。
# 手写的只有人类批准人（不是 aisep:AIAgent）。批准记录只能由批准人本人在工作台关口页做出，不在这里手写。
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix :      <https://aisep.example/model/workbench/> .
@prefix ad: <https://meta.linked.archi/arch-decision#> .

:projectLead a arch:Stakeholder ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "项目负责人"@zh ; skos:altLabel "Project Lead"@en .

:optApproverFilterInWorkbench a ad:Option ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台关口页按被批模型过滤批准人"@zh .

:optApproverEnforcedByServer a ad:Option ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准工具与形状规则强制批准人属于被批模型"@zh .





:forceKeepApprovalCriteriaFrozen a ad:Force ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "不动批准与合并判据"@zh .

:forceBlockAllEntryPoints a ad:Force ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "所有批准入口都挡住误选"@zh .

:rel-optApproverFilterInWorkbench-addressesForce-forceKeepApprovalCriteriaFrozen a ad:AddressesForce ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :optApproverFilterInWorkbench ;
    arch:target :forceKeepApprovalCriteriaFrozen .



:rel-optApproverEnforcedByServer-addressesForce-forceBlockAllEntryPoints a ad:AddressesForce ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :optApproverEnforcedByServer ;
    arch:target :forceBlockAllEntryPoints .

:adrApproverScopeInWorkbench a ad:Decision ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准人范围先在工作台关口页收窄，服务端暂不强制"@zh ;
    ad:decisionState ad:Accepted ;
    ad:justification "已发生的那次误选（aisep #68）来自工作台关口页的批准人下拉：它列出所有模型的干系人并默认选中第一个。在页面上只列被批模型的人类干系人就能堵住这个入口，只改工作台前端，不动 aisep 的批准与合并判据，符合治理加固冻结（docs/decisions.md）。服务端强制属于批准判据的改动，要先排查哪些入口用单模型视图推导批准状态，还要处理已合入的跨模型记录，留给 aisep #73。代价：经 MCP 直接调用批准工具时仍可能写进别的模型的干系人。"@zh .

:rel-adrApproverScopeInWorkbench-hasSelectedOption-optApproverFilterInWorkbench a ad:HasSelectedOption ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :adrApproverScopeInWorkbench ;
    arch:target :optApproverFilterInWorkbench .

:rel-adrApproverScopeInWorkbench-hasAlternative-optApproverEnforcedByServer a ad:HasAlternative ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :adrApproverScopeInWorkbench ;
    arch:target :optApproverEnforcedByServer .

:rel-adrApproverScopeInWorkbench-relatedConcept-bpmnApvApproverGateway a ad:RelatedConcept ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :adrApproverScopeInWorkbench ;
    arch:target :bpmnApvApproverGateway .

:optReleaseStepsBySessionScript a ad:Option ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "会话用 aisep 仓库 tools/ 下的脚本拉分支、打标签、推送、开 PR"@zh .

:optReleaseStepsByWorkbenchBackend a ad:Option ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台加本地后端，照接口规范 §5.9 原文自己完成这些步骤"@zh .

:adrReleaseStepsBySessionScript a ad:Decision ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "发布的 git 步骤由会话调用 aisep 脚本完成，工作台只认出发布批准分支并提供发布关口"@zh ;
    ad:decisionState ad:Accepted ;
    ad:justification "工作台前端只调 MCP，不做 git 写操作，也不持推送凭据；前几条链路的推送、开 PR、合并一直由会话按 AGENTS.md 做。Albert 2026-11-25 定：拉发布批准分支、核对记录后打标签、推送、开批准专用 PR 由会话做，并做成 aisep tools/ 下的脚本，复用 mergecheck 的标签命名与批准提交判据，由脚本测试在 CI 里验证。批准记录仍只由 Albert 在关口页做出，脚本只在记录结论为批准且 evidence 等于被发布提交时打标签。代价：Albert 不能在工作台一处完成全部发布步骤；接口规范 §5.9 第 1、3、5 步改为「工作台或会话脚本」。"@zh .

:rel-adrReleaseStepsBySessionScript-relatedConcept-bpmnRelTag a ad:RelatedConcept ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :adrReleaseStepsBySessionScript ;
    arch:target :bpmnRelTag .

:rel-adrReleaseStepsBySessionScript-hasSelectedOption-optReleaseStepsBySessionScript a ad:HasSelectedOption ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :adrReleaseStepsBySessionScript ;
    arch:target :optReleaseStepsBySessionScript .

:rel-adrReleaseStepsBySessionScript-hasAlternative-optReleaseStepsByWorkbenchBackend a ad:HasAlternative ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :adrReleaseStepsBySessionScript ;
    arch:target :optReleaseStepsByWorkbenchBackend .

:forceWorkbenchNoGitWrites a ad:Force ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台前端不做 git 写操作、不持推送凭据"@zh .

:forceReleaseInOnePlace a ad:Force ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准人在一处完成全部发布步骤"@zh .

:rel-optReleaseStepsBySessionScript-addressesForce-forceWorkbenchNoGitWrites a ad:AddressesForce ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :optReleaseStepsBySessionScript ;
    arch:target :forceWorkbenchNoGitWrites .

:rel-optReleaseStepsByWorkbenchBackend-addressesForce-forceReleaseInOnePlace a ad:AddressesForce ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :optReleaseStepsByWorkbenchBackend ;
    arch:target :forceReleaseInOnePlace .
