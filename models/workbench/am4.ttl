# AISEP 工作台模型 — ArchiMate 4.0（枢纽）部分。
# 第一条端到端链路的载体需求「批准进度展示」。只有 arch:Model 声明是手写的；元素与关系一律经 MCP 写工具写入。
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix am4:   <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix :      <https://aisep.example/model/workbench/> .

<https://aisep.example/model/workbench/> a arch:Model ;
    skos:prefLabel "AISEP 工作台"@zh ; skos:altLabel "AISEP Workbench"@en .

:reqApprovalProgress a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台展示批准进度"@zh ;
    skos:altLabel "Show approval progress in the workbench"@en ;
    skos:definition "工作台显示一次批准走到 待批准、已批准待推送、已推送待合并、已合入 的哪一步；进度一律从 Git 推导，不保存进行中状态（ADR-013）。"@zh ;
    aisep:priority aisep:Must .

:gateApprovalFlow a am4:Process ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口批准流转"@zh ;
    skos:altLabel "Gate approval flow"@en .

:rel-gateApprovalFlow-realizes-reqApprovalProgress a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqApprovalProgress .

:reqNestedCheckoutScan a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "预览模式的嵌套检出检查有界且准确"@zh ;
    skos:altLabel "Bounded and accurate nested-checkout check in preview mode"@en ;
    skos:definition "一键启动脚本在预览模式启动时，检查专用检出里面有没有别的 git 检出（有就拒绝启动，免得上面的分支在预览模式下能被批准）。这项检查必须在有限时间内结束且结果准确：限制下探深度、跳过依赖目录、不跟随符号链接、不把专用检出自身当成另一个检出。"@zh ;
    aisep:priority aisep:Must .

:rel-gateApprovalFlow-realizes-reqNestedCheckoutScan a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqNestedCheckoutScan .
