# AISEP 工作台模型 — ArchiMate 4.0（枢纽）部分。
# 第一条端到端链路的载体需求「批准进度展示」。只有 arch:Model 声明是手写的；元素与关系一律经 MCP 写工具写入。
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix arch:  <https://meta.linked.archi/core#> .
@prefix am4:   <https://meta.linked.archi/archimate4/onto#> .
@prefix aisep: <https://aisep.example/ont/aisep#> .
@prefix :      <https://aisep.example/model/workbench/> .

<https://aisep.example/model/workbench/> a arch:Model ;
    skos:prefLabel "AISEP 工作台"@zh ; skos:altLabel "AISEP Workbench"@en .

:reqApprovalProgress a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台展示批准进度"@zh ;
    skos:altLabel "Show approval progress in the workbench"@en ;
    skos:definition "工作台显示一次批准走到 待批准、已批准待推送、已推送待合并、已合入 的哪一步；进度一律从 Git 推导，不保存进行中状态（ADR-013）。同一分支上，从有效内容提交到分支顶端之间（即批准之后没有内容改动）的全部 Approved 批准记录，按关口取已批元素的并集；当前选择的关口相同、勾选的元素是该关口并集的子集，就算已被覆盖，关口页刷新或重进后不能再批一次。换关口、勾选并集以外的元素、驳回，或批准后分支又有内容改动，仍可操作。"@zh ;
    aisep:priority aisep:Must .

:gateApprovalFlow a am4:Process ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口批准流转"@zh ;
    skos:altLabel "Gate approval flow"@en .

:rel-gateApprovalFlow-realizes-reqApprovalProgress a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqApprovalProgress .

:reqNestedCheckoutScan a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "预览模式的嵌套检出检查有界且准确"@zh ;
    skos:altLabel "Bounded and accurate nested-checkout check in preview mode"@en ;
    skos:definition "一键启动脚本在预览模式启动时，检查专用检出里面有没有别的 git 检出（有就拒绝启动，免得上面的分支在预览模式下能被批准）。这项检查必须在有限时间内结束且结果准确：限制下探深度、跳过依赖目录、不跟随符号链接、不把专用检出自身当成另一个检出。"@zh ;
    aisep:priority aisep:Must .

:rel-gateApprovalFlow-realizes-reqNestedCheckoutScan a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqNestedCheckoutScan .

:drvCrossModelApprover a am4:Driver ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准人可能误选别的模型的干系人"@zh ;
    skos:altLabel "Approver may be a stakeholder of another model"@en ;
    skos:definition "工作台关口页曾列出所有模型的干系人并默认选中第一个，aisep #68 的批准因此签成了采购模型的首席架构师；只看工作台模型时这条批准不算数（aisep #73）。"@zh .

:goalApproverInModel a am4:Goal ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准人属于被批模型"@zh ;
    skos:altLabel "Approver belongs to the approved model"@en .

:outApproverInModel a am4:Outcome ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "工作台做出的批准在被批模型内自洽"@zh ;
    skos:altLabel "Workbench approvals are consistent within the approved model"@en ;
    skos:definition "之后在工作台关口页做出的批准记录，批准人都属于被批模型；只对被批模型跑 gate，不因批准人报错。"@zh .

:approverRole a am4:Role ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准人"@zh ;
    skos:altLabel "Approver"@en .

:reqApproverFromModel a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口页的批准人只能选被批模型的人类干系人"@zh ;
    skos:altLabel "Gate page offers only the approved model's human stakeholders as approvers"@en ;
    skos:definition "关口页批准人下拉只列被批模型自己的人类干系人（不是 aisep:AIAgent）；别的模型的干系人不出现。被批模型没有人类干系人时提示没有可选批准人，不能批准；干系人列表读不到时不显示下拉，不能批准；切换被批模型后，之前为别的模型选的批准人不再生效。"@zh ;
    aisep:priority aisep:Must .

:reqSingleApproverPreselect a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "被批模型只有一个人类干系人时自动选上"@zh ;
    skos:altLabel "Preselect the approver when the model has exactly one human stakeholder"@en ;
    skos:definition "被批模型恰好有一个人类干系人时，批准人自动选上他（含从别的模型切换过来）；有两个及以上时不预选，由人自己选。"@zh ;
    aisep:priority aisep:Should .

:reqServerEnforcesApproverModel a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "服务端强制批准人属于被批模型"@zh ;
    skos:altLabel "Server enforces that the approver belongs to the approved model"@en ;
    skos:definition "本次不做：批准工具与形状规则暂不要求批准人属于被批模型，留给 aisep #73。"@zh ;
    aisep:priority aisep:Wont .

:reqBackfillCrossModelApproval a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "补批已合入的跨模型批准记录"@zh ;
    skos:altLabel "Re-approve the merged cross-model approval record"@en ;
    skos:definition "本次不做：aisep #68 那条批准人为采购模型首席架构师的记录保留原样，不补批。"@zh ;
    aisep:priority aisep:Wont .

:reqApproverPerGate a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "按关口分配批准人"@zh ;
    skos:altLabel "Assign approvers per gate"@en ;
    skos:definition "本次不做：不限定某个关口只能由某个角色批准。"@zh ;
    aisep:priority aisep:Wont .

:rel-drvCrossModelApprover-influences-goalApproverInModel a am4:Influence ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :drvCrossModelApprover ;
    arch:target :goalApproverInModel .

:rel-outApproverInModel-realizes-goalApproverInModel a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :outApproverInModel ;
    arch:target :goalApproverInModel .

:rel-reqApproverFromModel-realizes-outApproverInModel a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :reqApproverFromModel ;
    arch:target :outApproverInModel .

:rel-reqSingleApproverPreselect-realizes-outApproverInModel a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :reqSingleApproverPreselect ;
    arch:target :outApproverInModel .

:rel-gateApprovalFlow-realizes-reqApproverFromModel a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqApproverFromModel .

:rel-gateApprovalFlow-realizes-reqSingleApproverPreselect a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqSingleApproverPreselect .

:rel-approverRole-assignedTo-gateApprovalFlow a am4:Assignment ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :approverRole ;
    arch:target :gateApprovalFlow .

:drvReleaseNeverExercised a am4:Driver ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "发布关口从没走过一次"@zh ;
    skos:altLabel "The release gate has never been exercised"@en ;
    skos:definition "发布关口的规则（短命批准分支、release 标签、批准专用 PR）已写进接口规范 §5.9 和合并校验，但仓库里没有一条发布批准记录，也没有一个 release 标签；工作台关口页也不提供发布关口。"@zh .

:goalIdentifiableRelease a am4:Goal ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "能指认经过批准的发布版本"@zh ;
    skos:altLabel "Approved releases are identifiable"@en .

:outReleaseTagged a am4:Outcome ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "每个批准的发布都有批准记录和 release 标签"@zh ;
    skos:altLabel "Every approved release has an approval record and a release tag"@en ;
    skos:definition "批准的发布在主线上有一条发布关口批准记录，被发布的提交有一个指向它的 release 标签；驳回的发布只有记录，没有标签。"@zh .

:reqApproveRelease a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口页能对发布批准分支批准发布"@zh ;
    skos:altLabel "Gate page approves a release on a release approval branch"@en ;
    skos:definition "会话从 origin/main（模型服务所读仓库最近一次 fetch 时） 的最新提交拉出发布批准分支（approval/release-…）后，工作台首页关口区列出它，点进关口页只提供发布关口；批准对象是整个被批模型；批准人规则同其他关口；gate 不通过时不能批准；分支所基于的提交已不是 origin/main 最新提交时既不能批准也不能驳回，提示重新准备。被批元素是「待批准」也允许发布（照现行规则）。"@zh ;
    aisep:priority aisep:Must .

:reqTagOnlyApprovedRelease a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "只有批准的发布才打 release 标签"@zh ;
    skos:altLabel "Only approved releases get a release tag"@en ;
    skos:definition "发布批准记录的结论是批准、且 evidence 等于被发布的提交时，才给该提交打 release/{yyyymmdd}-{前 7 位} 标签（批准日期，UTC），再推送分支与标签、开批准专用 PR；结论是驳回时不打标签，只推送分支、开批准专用 PR；同名标签已存在且指向同一提交则复用，指向别的提交则停下由人处理。"@zh ;
    aisep:priority aisep:Must .

:reqRejectRelease a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "关口页能驳回发布"@zh ;
    skos:altLabel "Gate page rejects a release"@en ;
    skos:definition "在发布关口可以驳回：记一条结论为驳回的发布关口记录，不打标签，记录照样经批准专用 PR 合入。"@zh ;
    aisep:priority aisep:Should .

:reqReleaseVersionTag a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "用版本号命名 release 标签"@zh ;
    skos:altLabel "Name release tags by version number"@en ;
    skos:definition "本次不做：只用 release/{yyyymmdd}-{前 7 位}，不做 release/v…。"@zh ;
    aisep:priority aisep:Wont .

:reqAutoDeleteReleaseTag a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "批准 PR 关闭未合并时自动删 release 标签"@zh ;
    skos:altLabel "Delete the release tag when the approval PR is closed unmerged"@en ;
    skos:definition "本次不做：规则集禁止删除 release 标签，遗留标签由人清理（规范 §5.9 第 3 步、附录 C）。"@zh ;
    aisep:priority aisep:Wont .

:reqDeployOnRelease a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "发布后自动部署"@zh ;
    skos:altLabel "Deploy automatically on release"@en ;
    skos:definition "本次不做：release 标签只是发布指针，不触发任何部署。"@zh ;
    aisep:priority aisep:Wont .

:reqTagWorkbenchRepo a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "给 workbench 仓库也打 release 标签"@zh ;
    skos:altLabel "Tag the workbench repository on release"@en ;
    skos:definition "本次不做：只给 aisep 主线提交打 release 标签。"@zh ;
    aisep:priority aisep:Wont .

:reqReleaseChangeSummary a am4:Requirement ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    skos:prefLabel "发布关口页显示自上次发布以来的改动"@zh ;
    skos:altLabel "Show changes since the last release on the release gate page"@en ;
    skos:definition "本次不做：第一次发布没有上一版可比，等有了第二版再做。"@zh ;
    aisep:priority aisep:Wont .

:rel-drvReleaseNeverExercised-influences-goalIdentifiableRelease a am4:Influence ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :drvReleaseNeverExercised ;
    arch:target :goalIdentifiableRelease .

:rel-outReleaseTagged-realizes-goalIdentifiableRelease a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :outReleaseTagged ;
    arch:target :goalIdentifiableRelease .

:rel-reqApproveRelease-realizes-outReleaseTagged a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :reqApproveRelease ;
    arch:target :outReleaseTagged .

:rel-reqTagOnlyApprovedRelease-realizes-outReleaseTagged a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :reqTagOnlyApprovedRelease ;
    arch:target :outReleaseTagged .

:rel-reqRejectRelease-realizes-outReleaseTagged a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :reqRejectRelease ;
    arch:target :outReleaseTagged .

:rel-gateApprovalFlow-realizes-reqApproveRelease a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqApproveRelease .

:rel-gateApprovalFlow-realizes-reqTagOnlyApprovedRelease a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqTagOnlyApprovedRelease .

:rel-gateApprovalFlow-realizes-reqRejectRelease a am4:Realization ;
    arch:inModel <https://aisep.example/model/workbench/> ;
    arch:source :gateApprovalFlow ;
    arch:target :reqRejectRelease .
