# adm-phase: 01-vision
# section: 4. 目标与成果
# kind: gap
# title: 目标没有成果或需求与它关联
# source: 01-vision/template.md 出口条件第 2 条
# 用法：经 tools/aisep.py adm 运行；直接交给 model_query 时只改 VALUES ?model 一行。
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX prov:  <http://www.w3.org/ns/prov#>
PREFIX arch:  <https://meta.linked.archi/core#>
PREFIX am4:   <https://meta.linked.archi/archimate4/onto#>
PREFIX bpmn:  <https://meta.linked.archi/bpmn/onto#>
PREFIX ad:    <https://meta.linked.archi/arch-decision#>
PREFIX ddd:   <https://aisep.example/ont/ddd#>
PREFIX aisep: <https://aisep.example/ont/aisep#>
SELECT ?element ?label WHERE {
  VALUES ?model { <https://aisep.example/model/workbench/> }
  ?element arch:inModel ?model ; a/rdfs:subClassOf* am4:Goal .
  FILTER NOT EXISTS {
    ?r arch:source ?o ; arch:target ?element .
    { ?o a/rdfs:subClassOf* am4:Outcome } UNION { ?o a/rdfs:subClassOf* am4:Requirement } }
  OPTIONAL { ?element skos:prefLabel ?label FILTER(lang(?label) = "zh") }
} ORDER BY ?element
