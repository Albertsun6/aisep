# 固定查询：代码位置 → 设计元素 → 业务能力
# 从 aisep:CodeLocation 出发，沿 aisep:Implementation 找到它实现的设计元素，
# 再沿 am4:Realization（含子类，如 ddd:SubdomainImplementation）找到被实现的能力（am4:Capability 及子类，如 ddd:Subdomain）。
# 只用限定关系资源（arch:source / arch:target），不依赖直连三元组。
# 用法：经 MCP 工具 model_query 的 sparql 参数原样传入；改模型范围时只改下面的模型 IRI。
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>
PREFIX arch:   <https://meta.linked.archi/core#>
PREFIX am4:    <https://meta.linked.archi/archimate4/onto#>
PREFIX aisep:  <https://aisep.example/ont/aisep#>

SELECT ?code ?repo ?path ?design ?designLabel ?cap ?capLabel WHERE {
  ?impl a/rdfs:subClassOf* aisep:Implementation ;
        arch:source ?code ;
        arch:target ?design .
  ?code schema:codeRepository ?repo ;
        aisep:path ?path ;
        arch:inModel <https://aisep.example/model/workbench/> .
  ?design skos:prefLabel ?designLabel .
  ?real a/rdfs:subClassOf* am4:Realization ;
        arch:source ?design ;
        arch:target ?cap .
  ?cap a/rdfs:subClassOf* am4:Capability ;
       skos:prefLabel ?capLabel .
}
ORDER BY ?code ?design ?cap
