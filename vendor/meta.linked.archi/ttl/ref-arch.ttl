    <http://prismstandard.org/namespaces/basic/2.1/endingPage>   "1758" ;
    <http://prismstandard.org/namespaces/basic/2.1/startingPage> "1735" ;
    <http://prismstandard.org/namespaces/basic/2.1/volume>       "83" ;
