#################################################################
# Relationship Attribute Properties
#################################################################

:accessType
    a               owl:DatatypeProperty ;
    skos:prefLabel  "Access Type"@en ;
    rdfs:domain     :Access ;
    rdfs:range      xsd:string ;
    owl:deprecated  true ;
    dcterms:isReplacedBy :ReadAccess, :WriteAccess, :ReadWriteAccess ;
    skos:historyNote '''Deprecated 2026-10-10: the kind of access is the relationship's class — am4:ReadAccess,
am4:WriteAccess or am4:ReadWriteAccess, and am4:Access when it is unspecified — so the notation, the palette,
viewpoints, SHACL and SPARQL all see it as a type (DD-31). An importer maps the exchange format's
accessType attribute to these classes.'''@en ;
.

:influenceStrength
    a               owl:DatatypeProperty ;
    skos:prefLabel  "Influence Strength"@en ;
    rdfs:domain     :Influence ;
    rdfs:range      xsd:string ;
.
