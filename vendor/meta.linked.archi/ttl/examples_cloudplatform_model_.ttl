@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix am4:     <https://meta.linked.archi/archimate4/onto#> .
@prefix cp:      <https://meta.linked.archi/examples/cloudplatform/onto#> .
@prefix cpmm:    <https://meta.linked.archi/examples/cloudplatform/metamodel#> .
@prefix :        <https://meta.linked.archi/examples/cloudplatform/model/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

## ═══════════════════════════════════════════════════════════════════════════════
## Example Model — Payment Platform
##
## A realistic model using the Cloud Platform Architecture metamodel.
## 5 microservices, 2 databases, 1 cache, 1 message broker, 3 event topics,
## 1 API gateway, 1 observability stack, 1 Kubernetes cluster, 5 containers.
## ═══════════════════════════════════════════════════════════════════════════════

:PaymentPlatform a arch:Model ;
    skos:prefLabel "Payment Platform"@en ;
    dcterms:title "Payment Platform"@en ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/examples/cloudplatform/model/" ;
    vann:preferredNamespacePrefix "cloudplatform" ;
    dcterms:description "Example architecture model of a payment platform using the Cloud Platform metamodel."@en ;
    dcterms:creator "Kalin Maldzhanski"^^xsd:string ;
    arch:modelConformsToMetamodel cpmm:CloudPlatformMetamodel .


## ─── Microservices ──────────────────────────────────────────────────────────

:OrderService a cp:Microservice ;
    skos:prefLabel "Order Service"@en ;
    skos:definition "Handles the complete order lifecycle including creation, validation, payment orchestration, and fulfillment tracking."@en ;
    cp:resilienceLevel "critical" ;
    cp:deploymentStrategy "blue-green" ;
    cp:serviceTier "tier-1" ;
    arch:inModel :PaymentPlatform .

:PaymentService a cp:Microservice ;
    skos:prefLabel "Payment Service"@en ;
    skos:definition "Processes credit card and bank transfer payments including authorisation, capture, and refund operations."@en ;
    cp:resilienceLevel "critical" ;
    cp:deploymentStrategy "blue-green" ;
    cp:serviceTier "tier-1" ;
    arch:inModel :PaymentPlatform .

:NotificationService a cp:Microservice ;
    skos:prefLabel "Notification Service"@en ;
    skos:definition "Sends email, SMS, and push notifications to customers and internal stakeholders based on payment events."@en ;
    cp:resilienceLevel "medium" ;
    cp:deploymentStrategy "rolling" ;
    cp:serviceTier "tier-2" ;
    arch:inModel :PaymentPlatform .

:FraudDetectionService a cp:Microservice ;
    skos:prefLabel "Fraud Detection Service"@en ;
    skos:definition "ML-based fraud scoring service that evaluates payment transactions in real-time and assigns risk scores."@en ;
    cp:resilienceLevel "high" ;
    cp:deploymentStrategy "canary" ;
    cp:serviceTier "tier-1" ;
    arch:inModel :PaymentPlatform .

:ReportingService a cp:Microservice ;
    skos:prefLabel "Reporting Service"@en ;
    skos:definition "Generates financial reports, transaction analytics dashboards, and settlement reconciliation summaries."@en ;
    cp:resilienceLevel "low" ;
    cp:deploymentStrategy "rolling" ;
    cp:serviceTier "tier-3" ;
    arch:inModel :PaymentPlatform .


## ─── API Gateway ────────────────────────────────────────────────────────────

:PaymentGateway a cp:APIGateway ;
    skos:prefLabel "Payment API Gateway"@en ;
    skos:definition "Kong-based API gateway routing external payment API consumers to internal microservices with authentication and rate limiting."@en ;
    arch:inModel :PaymentPlatform .

:PaymentGateway am4:serves :OrderService .
:PaymentGateway am4:qualifiedServing :qr-PaymentGateway-serves-OrderService .
:qr-PaymentGateway-serves-OrderService a am4:Serving ; arch:inModel :PaymentPlatform ;
    arch:source :PaymentGateway ; arch:target :OrderService ;
    rdf:reifies <<( :PaymentGateway am4:serves :OrderService )>> .
:PaymentGateway am4:serves :PaymentService .
:PaymentGateway am4:qualifiedServing :qr-PaymentGateway-serves-PaymentService .
:qr-PaymentGateway-serves-PaymentService a am4:Serving ; arch:inModel :PaymentPlatform ;
    arch:source :PaymentGateway ; arch:target :PaymentService ;
    rdf:reifies <<( :PaymentGateway am4:serves :PaymentService )>> .


## ─── Databases ──────────────────────────────────────────────────────────────

:OrderDB a cp:ManagedDatabase ;
    skos:prefLabel "Orders Database"@en ;
    cp:databaseEngine "PostgreSQL" ;
    arch:inModel :PaymentPlatform .

:PaymentDB a cp:ManagedDatabase ;
    skos:prefLabel "Payments Database"@en ;
    cp:databaseEngine "PostgreSQL" ;
    arch:inModel :PaymentPlatform .

:OrderService am4:accesses :OrderDB .
:OrderService am4:qualifiedAccess :qr-OrderService-accesses-OrderDB .
:qr-OrderService-accesses-OrderDB a am4:Access ; arch:inModel :PaymentPlatform ;
    arch:source :OrderService ; arch:target :OrderDB ;
    rdf:reifies <<( :OrderService am4:accesses :OrderDB )>> .
:PaymentService am4:accesses :PaymentDB .
:PaymentService am4:qualifiedAccess :qr-PaymentService-accesses-PaymentDB .
:qr-PaymentService-accesses-PaymentDB a am4:Access ; arch:inModel :PaymentPlatform ;
    arch:source :PaymentService ; arch:target :PaymentDB ;
    rdf:reifies <<( :PaymentService am4:accesses :PaymentDB )>> .
:ReportingService am4:accesses :OrderDB .
:ReportingService am4:qualifiedAccess :qr-ReportingService-accesses-OrderDB .
:qr-ReportingService-accesses-OrderDB a am4:Access ; arch:inModel :PaymentPlatform ;
    arch:source :ReportingService ; arch:target :OrderDB ;
    rdf:reifies <<( :ReportingService am4:accesses :OrderDB )>> .
:ReportingService am4:accesses :PaymentDB .
:ReportingService am4:qualifiedAccess :qr-ReportingService-accesses-PaymentDB .
:qr-ReportingService-accesses-PaymentDB a am4:Access ; arch:inModel :PaymentPlatform ;
    arch:source :ReportingService ; arch:target :PaymentDB ;
    rdf:reifies <<( :ReportingService am4:accesses :PaymentDB )>> .


## ─── Cache ──────────────────────────────────────────────────────────────────

:SessionCache a cp:CacheStore ;
    skos:prefLabel "Session Cache (Redis)"@en ;
    arch:inModel :PaymentPlatform .

:OrderService am4:accesses :SessionCache .
:OrderService am4:qualifiedAccess :qr-OrderService-accesses-SessionCache .
:qr-OrderService-accesses-SessionCache a am4:Access ; arch:inModel :PaymentPlatform ;
    arch:source :OrderService ; arch:target :SessionCache ;
    rdf:reifies <<( :OrderService am4:accesses :SessionCache )>> .
:PaymentService am4:accesses :SessionCache .
:PaymentService am4:qualifiedAccess :qr-PaymentService-accesses-SessionCache .
:qr-PaymentService-accesses-SessionCache a am4:Access ; arch:inModel :PaymentPlatform ;
    arch:source :PaymentService ; arch:target :SessionCache ;
    rdf:reifies <<( :PaymentService am4:accesses :SessionCache )>> .


## ─── Message Broker & Event Topics ──────────────────────────────────────────

:KafkaCluster a cp:MessageBroker ;
    skos:prefLabel "Kafka Cluster"@en ;
    arch:inModel :PaymentPlatform .

:OrderEvents a cp:EventTopic ;
    skos:prefLabel "order-events"@en ;
    cp:topicPartitions 12 ;
    arch:inModel :PaymentPlatform .

:PaymentEvents a cp:EventTopic ;
    skos:prefLabel "payment-events"@en ;
    cp:topicPartitions 12 ;
    arch:inModel :PaymentPlatform .

:FraudAlerts a cp:EventTopic ;
    skos:prefLabel "fraud-alerts"@en ;
    cp:topicPartitions 4 ;
    arch:inModel :PaymentPlatform .

## Publishing relationships
:OrderService cp:publishesTo :OrderEvents .
:OrderService cp:qualifiedPublishing :qr-OrderService-publishesTo-OrderEvents .
:qr-OrderService-publishesTo-OrderEvents a cp:Publishing ; arch:inModel :PaymentPlatform ;
    arch:source :OrderService ; arch:target :OrderEvents ;
    rdf:reifies <<( :OrderService cp:publishesTo :OrderEvents )>> .
:PaymentService cp:publishesTo :PaymentEvents .
:PaymentService cp:qualifiedPublishing :qr-PaymentService-publishesTo-PaymentEvents .
:qr-PaymentService-publishesTo-PaymentEvents a cp:Publishing ; arch:inModel :PaymentPlatform ;
    arch:source :PaymentService ; arch:target :PaymentEvents ;
    rdf:reifies <<( :PaymentService cp:publishesTo :PaymentEvents )>> .
:FraudDetectionService cp:publishesTo :FraudAlerts .
:FraudDetectionService cp:qualifiedPublishing :qr-FraudDetectionService-publishesTo-FraudAlerts .
:qr-FraudDetectionService-publishesTo-FraudAlerts a cp:Publishing ; arch:inModel :PaymentPlatform ;
    arch:source :FraudDetectionService ; arch:target :FraudAlerts ;
    rdf:reifies <<( :FraudDetectionService cp:publishesTo :FraudAlerts )>> .

## Subscription relationships
:PaymentService cp:subscribesTo :OrderEvents .
:PaymentService cp:qualifiedSubscription :qr-PaymentService-subscribesTo-OrderEvents .
:qr-PaymentService-subscribesTo-OrderEvents a cp:Subscription ; arch:inModel :PaymentPlatform ;
    arch:source :PaymentService ; arch:target :OrderEvents ;
    rdf:reifies <<( :PaymentService cp:subscribesTo :OrderEvents )>> .
:NotificationService cp:subscribesTo :PaymentEvents .
:NotificationService cp:qualifiedSubscription :qr-NotificationService-subscribesTo-PaymentEvents .
:qr-NotificationService-subscribesTo-PaymentEvents a cp:Subscription ; arch:inModel :PaymentPlatform ;
    arch:source :NotificationService ; arch:target :PaymentEvents ;
    rdf:reifies <<( :NotificationService cp:subscribesTo :PaymentEvents )>> .
:NotificationService cp:subscribesTo :FraudAlerts .
:NotificationService cp:qualifiedSubscription :qr-NotificationService-subscribesTo-FraudAlerts .
:qr-NotificationService-subscribesTo-FraudAlerts a cp:Subscription ; arch:inModel :PaymentPlatform ;
    arch:source :NotificationService ; arch:target :FraudAlerts ;
    rdf:reifies <<( :NotificationService cp:subscribesTo :FraudAlerts )>> .
:FraudDetectionService cp:subscribesTo :PaymentEvents .
:FraudDetectionService cp:qualifiedSubscription :qr-FraudDetectionService-subscribesTo-PaymentEvents .
:qr-FraudDetectionService-subscribesTo-PaymentEvents a cp:Subscription ; arch:inModel :PaymentPlatform ;
    arch:source :FraudDetectionService ; arch:target :PaymentEvents ;
    rdf:reifies <<( :FraudDetectionService cp:subscribesTo :PaymentEvents )>> .
:ReportingService cp:subscribesTo :OrderEvents .
:ReportingService cp:qualifiedSubscription :qr-ReportingService-subscribesTo-OrderEvents .
:qr-ReportingService-subscribesTo-OrderEvents a cp:Subscription ; arch:inModel :PaymentPlatform ;
    arch:source :ReportingService ; arch:target :OrderEvents ;
    rdf:reifies <<( :ReportingService cp:subscribesTo :OrderEvents )>> .
:ReportingService cp:subscribesTo :PaymentEvents .
:ReportingService cp:qualifiedSubscription :qr-ReportingService-subscribesTo-PaymentEvents .
:qr-ReportingService-subscribesTo-PaymentEvents a cp:Subscription ; arch:inModel :PaymentPlatform ;
    arch:source :ReportingService ; arch:target :PaymentEvents ;
    rdf:reifies <<( :ReportingService cp:subscribesTo :PaymentEvents )>> .


## ─── Observability ──────────────────────────────────────────────────────────

:Observability a cp:ObservabilityStack ;
    skos:prefLabel "Observability Stack (Prometheus + Grafana + Jaeger)"@en ;
    arch:inModel :PaymentPlatform .


## ─── Infrastructure ─────────────────────────────────────────────────────────

:ProdCluster a cp:KubernetesCluster ;
    skos:prefLabel "Production Cluster (eu-west-1)"@en ;
    arch:inModel :PaymentPlatform .

## Containers
:OrderContainer a cp:Container ;
    skos:prefLabel "order-service container"@en ;
    cp:containerImage "registry.example.com/order-service:2.1.0" ;
    cp:replicaCount 3 ;
    am4:assignedTo :OrderService ;
    cp:deployedIn :ProdCluster .

:OrderContainer am4:qualifiedAssignment :qr-OrderContainer-assignedTo-OrderService .
:qr-OrderContainer-assignedTo-OrderService a am4:Assignment ;
    arch:source :OrderContainer ; arch:target :OrderService ;
    rdf:reifies <<( :OrderContainer am4:assignedTo :OrderService )>> .
:OrderContainer cp:qualifiedDeployment :qr-OrderContainer-deployedIn-ProdCluster .
:qr-OrderContainer-deployedIn-ProdCluster a cp:Deployment ;
    arch:source :OrderContainer ; arch:target :ProdCluster ;
    rdf:reifies <<( :OrderContainer cp:deployedIn :ProdCluster )>> .

:PaymentContainer a cp:Container ;
    skos:prefLabel "payment-service container"@en ;
    cp:containerImage "registry.example.com/payment-service:1.8.2" ;
    cp:replicaCount 4 ;
    am4:assignedTo :PaymentService ;
    cp:deployedIn :ProdCluster .

:PaymentContainer am4:qualifiedAssignment :qr-PaymentContainer-assignedTo-PaymentService .
:qr-PaymentContainer-assignedTo-PaymentService a am4:Assignment ;
    arch:source :PaymentContainer ; arch:target :PaymentService ;
    rdf:reifies <<( :PaymentContainer am4:assignedTo :PaymentService )>> .
:PaymentContainer cp:qualifiedDeployment :qr-PaymentContainer-deployedIn-ProdCluster .
:qr-PaymentContainer-deployedIn-ProdCluster a cp:Deployment ;
    arch:source :PaymentContainer ; arch:target :ProdCluster ;
    rdf:reifies <<( :PaymentContainer cp:deployedIn :ProdCluster )>> .

:NotificationContainer a cp:Container ;
    skos:prefLabel "notification-service container"@en ;
    cp:containerImage "registry.example.com/notification-service:1.3.0" ;
    cp:replicaCount 2 ;
    am4:assignedTo :NotificationService ;
    cp:deployedIn :ProdCluster .

:NotificationContainer am4:qualifiedAssignment :qr-NotificationContainer-assignedTo-NotificationService .
:qr-NotificationContainer-assignedTo-NotificationService a am4:Assignment ;
    arch:source :NotificationContainer ; arch:target :NotificationService ;
    rdf:reifies <<( :NotificationContainer am4:assignedTo :NotificationService )>> .
:NotificationContainer cp:qualifiedDeployment :qr-NotificationContainer-deployedIn-ProdCluster .
:qr-NotificationContainer-deployedIn-ProdCluster a cp:Deployment ;
    arch:source :NotificationContainer ; arch:target :ProdCluster ;
    rdf:reifies <<( :NotificationContainer cp:deployedIn :ProdCluster )>> .

:FraudContainer a cp:Container ;
    skos:prefLabel "fraud-detection container"@en ;
    cp:containerImage "registry.example.com/fraud-detection:3.0.1" ;
    cp:replicaCount 2 ;
    am4:assignedTo :FraudDetectionService ;
    cp:deployedIn :ProdCluster .

:FraudContainer am4:qualifiedAssignment :qr-FraudContainer-assignedTo-FraudDetectionService .
:qr-FraudContainer-assignedTo-FraudDetectionService a am4:Assignment ;
    arch:source :FraudContainer ; arch:target :FraudDetectionService ;
    rdf:reifies <<( :FraudContainer am4:assignedTo :FraudDetectionService )>> .
:FraudContainer cp:qualifiedDeployment :qr-FraudContainer-deployedIn-ProdCluster .
:qr-FraudContainer-deployedIn-ProdCluster a cp:Deployment ;
    arch:source :FraudContainer ; arch:target :ProdCluster ;
    rdf:reifies <<( :FraudContainer cp:deployedIn :ProdCluster )>> .

:ReportingContainer a cp:Container ;
    skos:prefLabel "reporting-service container"@en ;
    cp:containerImage "registry.example.com/reporting-service:1.1.0" ;
    cp:replicaCount 1 ;
    am4:assignedTo :ReportingService ;
    cp:deployedIn :ProdCluster .

:ReportingContainer am4:qualifiedAssignment :qr-ReportingContainer-assignedTo-ReportingService .
:qr-ReportingContainer-assignedTo-ReportingService a am4:Assignment ;
    arch:source :ReportingContainer ; arch:target :ReportingService ;
    rdf:reifies <<( :ReportingContainer am4:assignedTo :ReportingService )>> .
:ReportingContainer cp:qualifiedDeployment :qr-ReportingContainer-deployedIn-ProdCluster .
:qr-ReportingContainer-deployedIn-ProdCluster a cp:Deployment ;
    arch:source :ReportingContainer ; arch:target :ProdCluster ;
    rdf:reifies <<( :ReportingContainer cp:deployedIn :ProdCluster )>> .

