@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix ad:      <https://meta.linked.archi/arch-decision#> .
@prefix :        <https://meta.linked.archi/arch-decision/metamodel#> .

<https://meta.linked.archi/arch-decision/metamodel#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/arch-decision/metamodel#" ;
    vann:preferredNamespacePrefix "admm" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi Architecture Decisions Metamodel Definition"@en ;
    dcterms:description           '''Metamodel manifest for the Architecture Decisions extension. Ties together
the decision ontology, the relationship types that draw its links, the SKOS taxonomy and the SHACL
shapes into a single discoverable resource. Designed to be added beside a modelling language: a
decision record links to the elements of the architecture it decides about.'''@en ;
    dcterms:created               "2026-11-16"^^xsd:date ;
    dcterms:modified              "2026-11-16"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/arch-decision/metamodel/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
.

:ArchitectureDecisions
    a                             arch:Metamodel ;
    skos:prefLabel                "Architecture Decisions Metamodel"@en ;
    dcterms:description           '''The Architecture Decisions metamodel definition, aggregating the decision
ontology — decisions, issues, options and the forces on them — the relationship types that draw the
links between them and to the architecture, the SKOS taxonomy and the SHACL shapes.'''@en ;
    arch:modelConcepts            <https://meta.linked.archi/arch-decision#> ;
    arch:conceptClassification    <https://meta.linked.archi/arch-decision/tax#> ;
    arch:formalRules              <https://meta.linked.archi/arch-decision-shapes#> ;
.
