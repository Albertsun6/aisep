@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix arch-vis: <https://meta.linked.archi/core-vis#> .
@prefix amtax:   <https://meta.linked.archi/archimate3/tax#> .
@prefix amvp:    <https://meta.linked.archi/archimate3/viewpoints#> .
@prefix amdt:    <https://meta.linked.archi/archimate3/deliverable-templates#> .
@prefix amrd:    <https://meta.linked.archi/archimate3/reference-data#> .
@prefix amrm:    <https://meta.linked.archi/archimate3/reference-models#> .
@prefix ampc:    <https://meta.linked.archi/archimate3/presentation-contexts#> .
@prefix amnot:   <https://meta.linked.archi/archimate3/notation#> .
@prefix amfw:    <https://meta.linked.archi/archimate/framework#> .
@prefix :        <https://meta.linked.archi/archimate3/metamodel#> .

#################################################################
# Ontology Declaration
#################################################################

<https://meta.linked.archi/archimate3/metamodel#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate3/metamodel#" ;
    vann:preferredNamespacePrefix "ammm" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi ArchiMate 3.2 Metamodel Definition"@en ;
    dcterms:description                '''Metamodel manifest for ArchiMate 3.2. This file ties together all
the ArchiMate semantic resources — the element/relationship ontology, SKOS taxonomy,
SHACL shapes, derivation rules, viewpoints, deliverable templates, reference data,
reference models, and presentation contexts — into a single arch:Metamodel instance.

This is the entry point for tools that need to discover all resources that make up
the ArchiMate modeling language definition.'''@en ;
    dcterms:created               "2022-11-14"^^xsd:date ;
    dcterms:modified              "2025-12-01"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/archimate3/metamodel/3.2#> ;
    owl:versionInfo               "3.2"@en ;
    dcterms:source  <https://pubs.opengroup.org/architecture/archimate3-doc> ;
    prov:wasDerivedFrom <https://pubs.opengroup.org/architecture/archimate3-doc> ;
.


#################################################################
# ArchiMate Framework Individual — DEPRECATED, moved
#
# The framework identity is now version-neutral and lives at
# amfw:ArchiMateFramework, declared in
# modelingLanguages/archimate/archimate-framework.ttl.
#
# It moved because "ArchiMate, the language" had two IRIs that nothing
# related: this one and archimate4/metamodel#ArchiMateFramework, each
# with a version in its skos:prefLabel. So
# arch:modelConformsToMetamodel/arch:basedOnFramework could not answer a
# language-level question, and consumers had to enumerate the metamodels
# by hand and grow that list with every release.
#
# The IRI is retained, owl:deprecated, with owl:sameAs to the new one so
# published references still resolve to something meaningful. It is NOT
# typed arch:Framework any more — that way `?fw a arch:Framework` yields
# one ArchiMate framework, not three. Do not put the type back.
#################################################################

:ArchiMateFramework
    owl:deprecated     true ;
    owl:sameAs         amfw:ArchiMateFramework ;
    rdfs:seeAlso       amfw:ArchiMateFramework ;
    skos:editorialNote '''Deprecated. Use amfw:ArchiMateFramework
(https://meta.linked.archi/archimate/framework#ArchiMateFramework), which identifies
ArchiMate the language rather than the 3.2 release. Version detail belongs on
:ArchiMate3.2, which carries owl:versionInfo "3.2".'''@en ;
.


#################################################################
# ArchiMate 3.2 Metamodel Instance
#################################################################

:ArchiMate3.2
    a                             arch:Metamodel ;
    skos:prefLabel                "ArchiMate 3.2 Metamodel"@en ;
    dcterms:description               '''The complete ArchiMate 3.2 metamodel definition, aggregating
the element/relationship ontology, SKOS taxonomy, SHACL shapes, derivation rules,
viewpoints, deliverable templates, reference data, reference models, and presentation
contexts into a single discoverable resource.'''@en ;

    ## Foundation — the language, not this release
    ## File: ../archimate-framework.ttl
    ##
    ## Points at the version-neutral framework IRI so that
    ## arch:modelConformsToMetamodel/arch:basedOnFramework answers "is this an ArchiMate
    ## model?" in one hop, for 3.2 and 4.0 alike. The release-level answer is this
    ## resource itself, plus owl:versionInfo below.
    arch:basedOnFramework         amfw:ArchiMateFramework ;
    owl:versionInfo               "3.2" ;

    ## Model concepts — elements, relationships, abstract classes
    ## File: archimate3.2-onto.ttl
    arch:modelConcepts            <https://meta.linked.archi/archimate3/onto#> ;

    ## Viewpoints — viewpoint individuals and their properties
    ## File: archimate3.2-viewpoints.ttl
    arch:architectureViewpoints   <https://meta.linked.archi/archimate3/viewpoints#> ;

    ## Formal rules — SHACL shapes for validation, and the relationship tables: the
    ## relationship shapes' rules as lookups, which the derivation rules read as data
    ## Files: archimate3.2-relationship-shapes.ttl, archimate3.2-relationship-tables.ttl,
    ##        archimate3.2-element-shapes.ttl, archimate3.2-principle-shapes.ttl
    arch:formalRules              <https://meta.linked.archi/archimate3/shapes#>,
                                  <https://meta.linked.archi/archimate3/relationship-tables#>,
                                  <https://meta.linked.archi/archimate3/element-shapes#>,
                                  <https://meta.linked.archi/archimate3/principle-shapes#> ;

    ## Viewpoint conformance rules
    ## File: archimate3.2-viewpoint-shapes.ttl
    arch:architectureViewpointsRestrictions
                                  <https://meta.linked.archi/archimate3/viewpoint-shapes#> ;

    ## Derivation rules — SHACL rules for inferring derived relationships
    ## File: archimate3.2-derivation-rules.ttl
    arch:derivationRules          <https://meta.linked.archi/archimate3/derivation#> ;

    ## Concept classification — SKOS taxonomy (by layer, by aspect)
    ## File: archimate3.2-tax.ttl
    arch:conceptClassification    <https://meta.linked.archi/archimate3/tax#> ;

    ## Palette grouping — sections by layer, each in order of aspect
    ## Diagram group order — the groups a diagram keeps in bands, motivation and strategy first
    ## File: archimate3.2-tax.ttl
    arch:paletteGrouping          amtax:PaletteGrouping ;
    arch:diagramGroupOrder        amtax:DiagramGroupOrder ;

    ## Relationship proposal order — the orders a modelling tool proposes relationships in, the general one
    ## and those for the kinds of element they name
    ## File: archimate3.2-tax.ttl
    arch:relationshipProposalOrder amtax:ProposalOrder, amtax:BehaviorProposalOrder,
                                   amtax:BehaviorServiceProposalOrder, amtax:StrategyBehaviorProposalOrder,
                                   amtax:CapabilityProposalOrder, amtax:CollaborationProposalOrder,
                                   amtax:MotivationProposalOrder, amtax:MeaningValueProposalOrder,
                                   amtax:CompositeProposalOrder ;

    ## Viewpoint library — SKOS scheme grouping viewpoints
    ## File: archimate3.2-viewpoints.ttl
    arch:viewpointLibrary         amvp:ViewpointCatalog ;

    ## Deliverable templates
    ## File: archimate3.2-deliverable-templates.ttl
    arch:hasDeliverableTemplate   amdt:ArchitectureDefinitionDocument,
                                  amdt:ArchitectureRequirementsSpec,
                                  amdt:ArchitecturePrinciplesDocument,
                                  amdt:ChangeImpactAssessment ;

    ## Model questions: what ArchiMate 3.2 stakeholders ask of a model
    ## File: archimate3.2-questions.ttl
    arch:hasQuestionSet           <https://meta.linked.archi/archimate3/questions#> ;

    ## Reference data — controlled vocabularies for model content
    ## File: archimate3.2-reference-data.ttl
    arch:referenceData            amrd:ArchiMateReferenceData ;

    ## Reference models — reusable architecture patterns
    ## File: archimate3.2-reference-models.ttl
    arch:referenceModels          amrm:ArchiMateReferenceModels ;

    ## Presentation context — stakeholder-specific rendering themes
    ## File: archimate3.2-presentation-contexts.ttl
    arch:presentationContextScheme ampc:ArchiMatePresentationContexts ;

    ## Visual notation set — default element/relationship appearance
    ## File: archimate3.2-notation.ttl
    arch:notationSet              amnot:ArchiMate32StandardNotation ;

    ## Stakeholders identified by this metamodel
    arch:metamodelIdentifiesStakeholder
        amvp:EnterpriseArchitect, amvp:ProcessArchitect, amvp:DomainArchitect,
        amvp:ApplicationArchitect, amvp:SolutionArchitect, amvp:InformationArchitect,
        amvp:InfrastructureArchitect, amvp:BusinessArchitect, amvp:ICTArchitect,
        amvp:Manager, amvp:OperationalManager, amvp:BusinessManager,
        amvp:ProductManager, amvp:RequirementsManager, amvp:ProductDeveloper,
        amvp:BusinessAnalyst, amvp:CxO, amvp:Employee,
        amvp:Shareholder, amvp:Stakeholders ;

    ## Concerns identified by this metamodel
    arch:metamodelIdentifiesConsideration
        amvp:CompetenciesAuthorityResponsibilities, amvp:ApplicationStructure, amvp:Consistency,
        amvp:Completeness, amvp:ReductionOfComplexity, amvp:InformationStructure,
        amvp:InfrastructureQuality, amvp:ImpactOfChange, amvp:Flexibility,
        amvp:PhysicalEnvironment, amvp:ProductDevelopment, amvp:ProductValue,
        amvp:Dependencies, amvp:Performance, amvp:Scalability,
        amvp:ProcessDependencies, amvp:Responsibilities, amvp:ApplicationDependencies,
        amvp:ServiceOrchestration, amvp:AddedValueOfProcesses, amvp:ApplicationPlatforms,
        amvp:ArchitectureMission, amvp:ArchitectureStrategy, amvp:ArchitectureTactics,
        amvp:Motivation, amvp:StrategyDevelopment, amvp:BusinessResults,
        amvp:ArchitectureVision, amvp:ArchitecturePolicies, amvp:ModelHistory ;
.
