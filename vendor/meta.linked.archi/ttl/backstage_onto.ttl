    rdfs:seeAlso         <https://backstage.io/docs/next/features/software-catalog/well-known-annotations#backstageioldap-rdn-backstageioldap-uuid-backstageioldap-dn> ;
    rdfs:subPropertyOf  :externalIdentifier ;
    skos:prefLabel      "LDAP DN"@en ;
    skos:definition     "Distinguished name found when ingesting the entity from LDAP (backstage.io/ldap-dn)."@en ;
    arch:domainIncludes :User, :Group ;
    rdfs:range          xsd:string ;
.

:msGraphTenantId
    a                   owl:DatatypeProperty ;
    dcterms:source       <https://backstage.io/docs/features/software-catalog/well-known-annotations#graphmicrosoftcomtenant-id-graphmicrosoftcomgroup-id-graphmicrosoftcomuser-id> ;
    rdfs:seeAlso         <https://backstage.io/docs/next/features/software-catalog/well-known-annotations#graphmicrosoftcomtenant-id-graphmicrosoftcomgroup-id-graphmicrosoftcomuser-id> ;
