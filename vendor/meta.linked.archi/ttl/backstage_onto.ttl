.

#################################################################
# Entity Metadata (descriptor format, common to all kinds)
#
# The reserved metadata fields. Retained as their own properties
# per DD-24: skos:prefLabel is the canonical label, and the
# notation's own name attribute is kept verbatim alongside it
# rather than folded into it. Here that matters more than usual,
# because metadata.name is not decoration — it is part of the
# entity reference that identifies the entity across the
# catalogue, so losing it loses the join key.
#################################################################

:name
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#name-required> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#name-required> ,
                        <https://backstage.io/docs/features/software-catalog/references> ;
    skos:prefLabel      "Name"@en ;
    skos:definition     "The name of the entity, unique per kind within its namespace."@en ;
    skos:scopeNote      '''Retained source data (DD-24), not a substitute for skos:prefLabel — emit both.
Together with kind and namespace this forms the entity reference, so it is the field a federation lift joins
on. Backstage constrains it to 1-63 characters of [a-z0-9A-Z] separated by [-_.], which is why an entity
reference needs no percent-encoding to sit in an IRI path.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:namespace
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#namespace-optional> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#namespace-optional> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel      "Namespace"@en ;
    skos:definition     "The namespace the entity belongs to; bounds the uniqueness constraint on the name."@en ;
    skos:scopeNote      '''Absent means "default". A lift should materialise the default rather than leave it
implicit, so an entity reference reconstructs without the consumer having to know the rule.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:apiVersion
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#apiversion-and-kind-required> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityEnvelope.schema.json> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#apiversion-and-kind-required> ,
                        <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-template> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/Entity.schema.json> ,
                        <https://github.com/backstage/backstage/blob/master/plugins/scaffolder-common/src/Template.v1beta3.schema.json> ;
    skos:prefLabel      "API Version"@en ;
    skos:definition     "The descriptor schema version the entity declares, e.g. backstage.io/v1alpha1."@en ;
    skos:scopeNote      '''Retained source data (DD-24). The other half of the descriptor's envelope, beside
:kind, and published in 0.5.0 for a concrete reason rather than for completeness: the eight catalog kinds
are on backstage.io/v1alpha1, and Template is on scaffolder.backstage.io/v1beta3 because the scaffolder
plugin owns that kind and versions it separately. A graph that records the kind and not the apiVersion
loses the fact that one of its kinds is on a different and less settled schema track.

The value above is the schema's, not the rendered documentation's — the descriptor format page still says
Template is backstage.io/v1beta2, and it is stale. See the scope note on :Template, and the two-sources
editorial note on the ontology header.

Not a version of this ontology and not a version of the entity. It names the schema the descriptor was
written against, which is why it is worth keeping per entity in a merged graph assembled from catalogues
upgraded at different times.

No shape requires it, for the same reason none requires :kind — a natively authored Linked.Archi model has no
descriptor to retain.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:kind
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#apiversion-and-kind-required> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#apiversion-and-kind-required> ,
                        <https://backstage.io/docs/features/software-catalog/references> ;
    skos:prefLabel      "Kind"@en ;
    skos:definition     "The kind token as written in the entity descriptor, e.g. Component, API, Group."@en ;
    skos:scopeNote      '''Retained source data (DD-24), read from the descriptor's kind root field. It is
NOT a duplicate of rdf:type and is not derived from it.

The two answer different questions. :kind is what the catalogue said; rdf:type is how this graph
classifies the entity, which is a modelling decision that may be revised later — a lift maps kind to the
class whose skos:notation matches, but an adopter may retype the entity under a convention adopted
afterwards, or add types from another notation in a merged graph. Recording only rdf:type would lose the
descriptor's own statement the moment either happened, and recording only :kind would leave the entity
unclassified for every shape and subClassOf query in the repository. Both are kept.

Divergence between the two is therefore legitimate and is reported at sh:Info by
bssh:KindTypeAlignmentShape, as an audit aid for reconciling a lift — not as a conformance failure.
Switch that shape off where retyping is deliberate policy.

Title-case, matching the descriptor and the skos:notation on the element classes. Not required by the
shapes even though the descriptor format requires the field, because a natively authored Linked.Archi
model has no descriptor to retain and states its kind by rdf:type; contrast :name, which IS required,
because a minted IRI cannot yield the name back whereas the class can yield a kind token.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:entityRef
    a                   owl:DatatypeProperty ;
    rdfs:subPropertyOf  dcterms:identifier ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/references> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/references> ,
                        <https://backstage.io/docs/features/software-catalog/descriptor-format#name-required> ;
    skos:prefLabel      "Entity Reference"@en ;
    skos:definition     "The compact entity reference, kind:namespace/name, that identifies this entity across the catalogue."@en ;
    skos:scopeNote      '''Retained source data (DD-24), not a computed convenience. This is the form the
catalogue itself circulates: the entity reference is what the relations array, spec.owner, spec.system,
spec.dependsOn and the techdocs-entity annotation all contain, so it is read from the source alongside
kind, namespace and name rather than assembled from them.

Keeping it verbatim is what makes reference resolution honest. The specification defines the
default-namespace rule and case-insensitive comparison; a consumer that rebuilds the reference
reimplements those rules and may diverge from the catalogue, and a reference the catalogue actually
emitted is evidence where a reconstruction is only an assumption. It also makes resolving an incoming
reference one triple pattern instead of a three-way join with string concatenation.

bssh:EntityRefConsistencyShape checks it against :kind, :namespace and :name — the other three retained
fields from the same descriptor, so a mismatch means the lift mangled one of them. It is deliberately
NOT checked against rdf:type: the graph type may legitimately differ from the catalogue kind, and
validating the reference against it would report every intentionally retyped entity as broken.

Not an :externalIdentifier. That super-property is scoped to identifiers assigned by OTHER systems, held
as linkage evidence; this is Backstage's own identity for the entity, so it sits under
dcterms:identifier alongside :uid. Unlike :uid it is stable, and unlike :uid it is the correct
cross-source join key.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:uid
    a                   owl:DatatypeProperty ;
    rdfs:subPropertyOf  dcterms:identifier ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#uid-output> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#uid-output> ;
    skos:prefLabel      "UID"@en ;
    skos:definition     "The globally unique ID the catalog database assigns an entity on first ingestion."@en ;
    skos:scopeNote      '''Output-only, and explicitly NOT stable: the documentation warns it changes when the
identical file is unregistered and re-registered, so it identifies a registration rather than the thing.
Record it for provenance; never derive an IRI from it and never use it as a cross-source join key — the entity
reference (kind + namespace + name) is what serves that purpose.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:etag
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#overall-shape-of-an-entity> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#overall-shape-of-an-entity> ;
    skos:prefLabel      "ETag"@en ;
    skos:definition     "Opaque change marker for the entity as held by the catalog."@en ;
    skos:scopeNote      "Output-only. Useful to a lift for change detection between runs; carries no architectural meaning."@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:title
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#title-optional> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#title-optional> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel      "Title"@en ;
    skos:definition     "A display name shown in user interfaces in place of the name."@en ;
    skos:scopeNote      '''Presentation only — entity references always use the name, never the title. A lift
must not put the title in skos:prefLabel in place of the name, or two entities sharing a title become
indistinguishable in every label-driven view.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:description
    a                   owl:DatatypeProperty ;
    rdfs:subPropertyOf  dcterms:description ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#description-optional> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#description-optional> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel      "Description"@en ;
    skos:definition     "A short human-readable description of the entity."@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:tag
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#tags-optional> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#tags-optional> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel      "Tag"@en ;
    skos:definition     "A single-valued free-text classifier on the entity."@en ;
    skos:scopeNote      '''Multi-valued by design: one triple per tag. Deliberately a literal rather than a
concept — the documentation says tags are user-defined and currently carry no special semantics, so promoting
them to IRIs would assert a shared vocabulary that does not exist. An organisation that governs its tag list
maps the literals to concepts in its own reference data instead.'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

:label
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#labels-optional> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#labels-optional> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel      "Label"@en ;
    skos:definition     "Abstract super-property for the entity's key/value labels."@en ;
    skos:scopeNote      '''Same mechanism as :externalIdentifier, and — stated as intent rather than left to
be inferred, which 0.4.0 and earlier did — ONE PREDICATE PER LABEL KEY, minted in the namespace of whoever
reads the catalogue, with this property as the parent. Label keys are organisation-defined and open-ended, so
no members are published here beyond this root. Backstage reserves the backstage.io/ key prefix for its own
components; a prefixed key maps to whatever namespace the reader has bound that prefix to, a bare key to the
reader's own vocabulary namespace.

A reified Label node with labelKey / labelValue was considered and is NOT the pattern. Reification earns its
extra hop where fields are positional and would otherwise be orphaned from each other — that is why :Link is
a node and why :StatusItem is one. A label is a single scalar value under a single key, so the key IS the
predicate, and a Label node would add a hop that carries nothing while making "every entity whose tier is
gold" a two-triple join instead of one. The same reasoning keeps spec.profile flat.

Why no shape enforces it. The check one would want — was the abstract parent asserted directly, losing the
key? — is not expressible in SHACL over a graph that may have been entailed, because
"acme:tier rdfs:subPropertyOf bs:label" makes every correct per-key assertion entail a :label triple too. A
shape reporting subjects of :label would pass on the malformed graph a validator ran without inference and
fail on the well-formed one it ran with. So the guidance lives here, in the document a converter author
reads, which is where it can be acted on.'''@en ;
    skos:example        '''## An adopter's own namespace, not bs:. One predicate per key, parented on bs:label.
acme:tier    a owl:DatatypeProperty ; rdfs:subPropertyOf bs:label .
acme:podName a owl:DatatypeProperty ; rdfs:subPropertyOf bs:label .

ex:payment-processor
    acme:tier    "gold" ;
    acme:podName "payments" ;
.

## Sweep every label regardless of key:   ?e bs:label ?v
## Query one key:                         ?e acme:tier ?v'''@en ;
    arch:domainIncludes arch:Element ;
    rdfs:range          xsd:string ;
.

#################################################################
# Entity Links
#
# The one metadata field with genuine internal structure — four
# fields whose meaning is positional, so unlike labels it cannot
# be flattened into a family of datatype properties without
# losing which title belongs to which url.
#################################################################

:Link
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#links-optional> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#links-optional> ,
                    <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel  "Link"@en ;
    skos:definition "An external hyperlink related to an entity."@en ;
    skos:scopeNote  '''Not an arch:Element — a link is contextual metadata on a node, not a node in the
architecture. The documentation is explicit that links are not meant to drive functionality and should be used
only where no well-known annotation covers the case, so nothing should be inferred from one.'''@en ;
.

:hasLink
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#links-optional> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#links-optional> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/EntityMeta.schema.json> ;
    skos:prefLabel      "Has Link"@en ;
    skos:definition     "Relates an entity to an external hyperlink."@en ;
    arch:domainIncludes arch:Element ;
    arch:rangeIncludes  :Link ;
.

:linkUrl
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#links-optional> ;
    skos:prefLabel      "Link URL"@en ;
    skos:definition     "The target of the link, in standard URI format. Required on a link."@en ;
    arch:domainIncludes :Link ;
    rdfs:range          xsd:anyURI ;
.

:linkTitle
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#links-optional> ;
    skos:prefLabel      "Link Title"@en ;
    skos:definition     "A user-friendly display name for the link."@en ;
    arch:domainIncludes :Link ;
    rdfs:range          xsd:string ;
.

:linkIcon
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#links-optional> ;
    skos:prefLabel      "Link Icon"@en ;
    skos:definition     "A semantic key naming the icon a UI should render for the link."@en ;
    skos:scopeNote      "A key resolved against an icon library by the Backstage integrator, not an image reference."@en ;
    arch:domainIncludes :Link ;
    rdfs:range          xsd:string ;
.

:linkType
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#links-optional> ;
    skos:prefLabel      "Link Type"@en ;
    skos:definition     "An optional category for the link."@en ;
    skos:scopeNote      "The documentation leaves the semantics of this field undefined and the value set to the adopter, so it stays a literal."@en ;
    arch:domainIncludes :Link ;
    rdfs:range          xsd:string ;
.

#################################################################
# Entity Status
#
# The status root field: a read-only set of statuses reporting the
# current state or health of the entity, and in practice how the
# catalogue's own ingestion of it went.
#
# Published in 0.5.0, reversing the 0.3.0 decision to leave it out.
# That decision's reason was that the catalogue derives status
# rather than an author writing it — but that is not a test applied
# anywhere else in this file. :uid, :etag, :orphan, :managedByLocation
# and the whole catalog provenance family are equally derived and
# equally published. The distinction that matters is whether a lift
# has the data and whether an architecture question needs it, and
# for a lift of the catalog API rather than of authored files the
# answer is yes twice: this is the only place the graph can say
# whether the record beside it was ingested cleanly, so without it
# a stale entity and a current one look identical.
#
# A NODE PER ITEM, on the :Link pattern and for the same reason: a
# level and a message flattened onto the entity lose which belongs
# to which, and the specification is explicit that several systems
# contribute items under their own type keys, so more than one item
# is the ordinary case rather than the edge case.
#
# Scoped to status.items[] and its type, level and message. The rest
# of the status object is, in the specification's words, left
# unrestricted, and the serialised error is out of scope — see the
# scope statement on the ontology header.
#################################################################

:StatusItem
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#common-to-all-kinds-status> ,
                    <https://backstage.io/docs/features/software-catalog/well-known-statuses#common-fields> ,
                    <https://github.com/backstage/backstage/blob/master/docs/features/software-catalog/well-known-statuses.md> ,
                    <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/Entity.schema.json> ;
    skos:prefLabel  "Status Item"@en ;
    skos:definition "One entry in an entity's status, describing some aspect of its state as seen by one specific system."@en ;
    skos:scopeNote  '''Not an arch:Element, on the same grounds as :Link — a status item is a diagnostic
about a node, not a node in the architecture. It therefore carries no naming or identity obligation and does
not appear in any viewpoint.

Read-only in Backstage: descriptor files are not supposed to contain a status key, so an item in the graph
came from the catalog API, and a natively authored Linked.Archi model will have none.

Upstream warns that the status model is in active development and its format may change. That warning is the
reason the terms here stop at the three documented item fields, and the reason to expect this section to move
before the rest of the file does.'''@en ;
.

:hasStatusItem
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#common-to-all-kinds-status> ,
                        <https://github.com/backstage/backstage/blob/master/docs/features/software-catalog/well-known-statuses.md> ;
    skos:prefLabel      "Has Status Item"@en ;
    skos:definition     "Relates an entity to one entry in its status."@en ;
    skos:scopeNote      "Multi-valued by design: status.items is an array and several systems contribute to it independently."@en ;
    arch:domainIncludes arch:Element ;
    arch:rangeIncludes  :StatusItem ;
.

:statusType
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#common-to-all-kinds-status> ,
                        <https://backstage.io/docs/features/software-catalog/well-known-statuses#status-item-types> ;
    skos:prefLabel      "Status Type"@en ;
    skos:definition     "The type of status, as a key unique per contributing source, e.g. backstage.io/catalog-processing."@en ;
    skos:scopeNote      '''A literal rather than a vocabulary of named individuals, unlike :statusLevel beside
it and unlike the spec.type sets. The value identifies the SYSTEM that contributed the item, not a
classification of the item: the specification calls it an arbitrary string, recommends namespacing it to avoid
collisions, and documents exactly one well-known value against an open set that every plugin extends. Minting
individuals for a set that is almost entirely plugin- and organisation-private would publish one member and
imply a vocabulary that does not exist — the reasoning that keeps :tag and :linkType literals too.

The same type may appear on more than one item of one entity, which the specification states explicitly. It is
single-valued per item; it is not a key for the item.'''@en ;
    arch:domainIncludes :StatusItem ;
    rdfs:range          xsd:string ;
.

:StatusLevel
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    skos:prefLabel  "Status Level"@en ;
    skos:definition "The level or severity of a status item: info, warning, or error."@en ;
    skos:scopeNote  '''A DD-23 vocabulary of named individuals, and a closed one: the descriptor format fixes
these three values, so closure is a fact about the language rather than a convention, and it is stated in
SHACL at Violation as :ApiVisibility is rather than with owl:oneOf. An adopter who needs a fourth value
replaces a shape instead of forking a published axiom.

Member IRIs carry the Level suffix because the bare tokens are among the most collision-prone names in any
vocabulary — "Info", "Warning" and "Error" also name SHACL severities, which appear in every shapes file that
validates this data. The bare token is on skos:notation, which is what a lift matches.

Upstream reserves the right to extend the status model. If the level set grows, this closure is the shape to
revisit; the correct response then is to widen the set, not to conclude the closure was wrong to state.'''@en ;
.

:statusLevel
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#common-to-all-kinds-status> ,
                        <https://github.com/backstage/backstage/blob/master/docs/features/software-catalog/well-known-statuses.md> ;
    skos:prefLabel      "Status Level"@en ;
    skos:definition     "The level or severity of the status item."@en ;
    skos:scopeNote      "At most one value, drawn from the StatusLevel vocabulary — enforced in shapes (sh:maxCount 1 + sh:in), never in OWL, per DD-23."@en ;
    arch:domainIncludes :StatusItem ;
    arch:rangeIncludes  :StatusLevel ;
.

:InfoLevel
    a               owl:NamedIndividual, :StatusLevel ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    skos:prefLabel  "info"@en ;
    skos:notation   "info" ;
    skos:definition "An informational status item, reporting state without asserting a problem."@en ;
.

:WarningLevel
    a               owl:NamedIndividual, :StatusLevel ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    skos:prefLabel  "warning"@en ;
    skos:notation   "warning" ;
    skos:definition "A status item reporting a condition that did not prevent the entity being processed."@en ;
.

:ErrorLevel
    a               owl:NamedIndividual, :StatusLevel ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso    <https://backstage.io/docs/features/software-catalog/well-known-statuses#backstageiocatalog-processing> ;
    skos:prefLabel  "error"@en ;
    skos:notation   "error" ;
    skos:definition "A status item reporting a failure."@en ;
    skos:scopeNote  '''Where the type is backstage.io/catalog-processing, an error means the catalogue could
not ingest the entity's source — and the documentation warns that the entity data alongside it is then the
last version that DID ingest, deliberately left untouched. So an error item does not describe the record it
sits on; it says that record is stale. Any freshness or governance query over lifted catalogue data has to
read it that way round.'''@en ;
.

:statusMessage
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#common-to-all-kinds-status> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#common-to-all-kinds-status> ,
                        <https://github.com/backstage/backstage/blob/master/docs/features/software-catalog/well-known-statuses.md> ;
    skos:prefLabel      "Status Message"@en ;
    skos:definition     "A brief description of the status, intended for human consumption."@en ;
    skos:scopeNote      '''Written for a person, so do not parse it — the serialised error object beside it is
where a machine-readable cause would live, and that is deliberately not lifted. Not language-tagged: the
catalogue emits one string with no locale, and tagging it @en would assert something the source does not
say.'''@en ;
    arch:domainIncludes :StatusItem ;
    rdfs:range          xsd:string ;
.

#################################################################
# Profile (User and Group)
#
# spec.profile is a three-field display structure. Flattened onto
# the entity rather than reified: every field is optional and
# scalar and none is positional, so a Profile node would add a hop
# without carrying anything the three properties do not.
#################################################################

:displayName
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-user> ;
    rdfs:seeAlso        <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel      "Display Name"@en ;
    skos:definition     "A human-readable name for the user or group (spec.profile.displayName)."@en ;
    arch:domainIncludes :User, :Group ;
    rdfs:range          xsd:string ;
.

:email
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-user> ;
    rdfs:seeAlso        <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel      "Email"@en ;
    skos:definition     "A contact email address for the user or group (spec.profile.email)."@en ;
    skos:scopeNote      "On a Group this is a group address rather than a person's, so it is not a route to an individual."@en ;
    arch:domainIncludes :User, :Group ;
    rdfs:range          xsd:string ;
.

:picture
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-user> ;
    rdfs:seeAlso        <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel      "Picture"@en ;
    skos:definition     "A URL to an image representing the user or group (spec.profile.picture)."@en ;
    arch:domainIncludes :User, :Group ;
    rdfs:range          xsd:anyURI ;
.

#################################################################
# API Definition
#################################################################

:definition
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-api> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-api> ;
    skos:prefLabel      "Definition"@en ;
    skos:definition     "The API definition itself, in the format declared by the API type. Required on an API."@en ;
    skos:scopeNote      '''Carried verbatim as a literal — an OpenAPI or AsyncAPI document is a payload the
graph refers to, not a structure to lift. An EA-level lift may legitimately keep only the type and a source
location and omit the body, which is why the shapes report an absent definition as a warning rather than a
violation even though the descriptor format marks the field required.'''@en ;
    arch:domainIncludes :API ;
    rdfs:range          xsd:string ;
.

#################################################################
# Remaining spec.type Vocabularies
#
# Same class-plus-named-individuals shape as ComponentType and
# APIType, and likewise no owl:oneOf. Resource and Group type are
# REQUIRED by the descriptor format; System and Domain type are
# optional. All four are weaker than component and API type in
# how the documentation states them — see the scope notes.
#################################################################

:ResourceType
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-resource> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-resource> ;
    skos:prefLabel  "Resource Type"@en ;
    skos:definition "The kind of infrastructure resource, e.g. database."@en ;
    skos:scopeNote  '''Illustrative, not normative. Unlike component and API type, where the documentation
gives a "current set of well-known and common values", this field is described as having no enforced
set and a nomenclature left to the adopting organization — the members below are the examples the
documentation offers. They are minted anyway so that two catalogues lifting the same common value land
on the same IRI instead of inventing one each, which is the interoperability the graph exists for.
Adopters add their own individuals of this class in their own namespace.

Member IRIs carry the vocabulary name as a suffix because the tokens collide across vocabularies:
"service" is both a component type and a system type, "product-area" both a group type and a domain
type. The bare token is on skos:notation, which is what a lift matches.'''@en ;
.

:resourceType
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-resource> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-resource> ;
    skos:prefLabel      "Resource Type"@en ;
    skos:definition     "The type of this resource (spec.type, required)."@en ;
    skos:scopeNote      "At most one value, enforced in shapes rather than with owl:FunctionalProperty (DD-23)."@en ;
    arch:domainIncludes :Resource ;
    arch:rangeIncludes  :ResourceType ;
.

:DatabaseResourceType
    a               owl:NamedIndividual, :ResourceType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-resource> ;
    skos:prefLabel  "database"@en ;
    skos:notation   "database" ;
    skos:definition "A database resource."@en ;
.

:S3BucketResourceType
    a               owl:NamedIndividual, :ResourceType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-resource> ;
    skos:prefLabel  "s3-bucket"@en ;
    skos:notation   "s3-bucket" ;
    skos:definition "An object-storage bucket resource."@en ;
.

:KubernetesClusterResourceType
    a               owl:NamedIndividual, :ResourceType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-resource> ;
    skos:prefLabel  "kubernetes-cluster"@en ;
    skos:notation   "kubernetes-cluster" ;
    skos:definition "A Kubernetes cluster resource."@en ;
.

:GroupType
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel  "Group Type"@en ;
    skos:definition "The kind of organizational group, e.g. team."@en ;
    skos:scopeNote  '''Illustrative, not normative. Unlike component and API type, where the documentation
gives a "current set of well-known and common values", this field is described as having no enforced
set and a nomenclature left to the adopting organization — the members below are the examples the
documentation offers. They are minted anyway so that two catalogues lifting the same common value land
on the same IRI instead of inventing one each, which is the interoperability the graph exists for.
Adopters add their own individuals of this class in their own namespace.

Member IRIs carry the vocabulary name as a suffix because the tokens collide across vocabularies:
"service" is both a component type and a system type, "product-area" both a group type and a domain
type. The bare token is on skos:notation, which is what a lift matches.'''@en ;
.

:groupType
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel      "Group Type"@en ;
    skos:definition     "The type of this group (spec.type, required)."@en ;
    skos:scopeNote      "At most one value, enforced in shapes rather than with owl:FunctionalProperty (DD-23)."@en ;
    arch:domainIncludes :Group ;
    arch:rangeIncludes  :GroupType ;
.

:TeamGroupType
    a               owl:NamedIndividual, :GroupType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel  "team"@en ;
    skos:notation   "team" ;
    skos:definition "A team."@en ;
.

:BusinessUnitGroupType
    a               owl:NamedIndividual, :GroupType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel  "business-unit"@en ;
    skos:notation   "business-unit" ;
    skos:definition "A business unit."@en ;
.

:ProductAreaGroupType
    a               owl:NamedIndividual, :GroupType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel  "product-area"@en ;
    skos:notation   "product-area" ;
    skos:definition "A product area."@en ;
.

:RootGroupType
    a               owl:NamedIndividual, :GroupType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-group> ;
    skos:prefLabel  "root"@en ;
    skos:notation   "root" ;
    skos:definition "A virtual root of the group hierarchy, for organizations that want one. The catalog supports multi-root hierarchies, so a single root is a convention rather than a requirement."@en ;
.

:SystemType
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-system> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-system> ;
    skos:prefLabel  "System Type"@en ;
    skos:definition "The kind of system, e.g. product."@en ;
    skos:scopeNote  '''Illustrative, not normative. Unlike component and API type, where the documentation
gives a "current set of well-known and common values", this field is described as having no enforced
set and a nomenclature left to the adopting organization — the members below are the examples the
documentation offers. They are minted anyway so that two catalogues lifting the same common value land
on the same IRI instead of inventing one each, which is the interoperability the graph exists for.
Adopters add their own individuals of this class in their own namespace.

Member IRIs carry the vocabulary name as a suffix because the tokens collide across vocabularies:
"service" is both a component type and a system type, "product-area" both a group type and a domain
type. The bare token is on skos:notation, which is what a lift matches.'''@en ;
.

:systemType
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-system> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-system> ;
    skos:prefLabel      "System Type"@en ;
    skos:definition     "The type of this system (spec.type, optional)."@en ;
    skos:scopeNote      "At most one value, enforced in shapes rather than with owl:FunctionalProperty (DD-23)."@en ;
    arch:domainIncludes :System ;
    arch:rangeIncludes  :SystemType ;
.

:ProductSystemType
    a               owl:NamedIndividual, :SystemType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-system> ;
    skos:prefLabel  "product"@en ;
    skos:notation   "product" ;
    skos:definition "A product."@en ;
.

:ServiceSystemType
    a               owl:NamedIndividual, :SystemType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-system> ;
    skos:prefLabel  "service"@en ;
    skos:notation   "service" ;
    skos:definition "A service."@en ;
.

:FeatureSetSystemType
    a               owl:NamedIndividual, :SystemType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-system> ;
    skos:prefLabel  "feature-set"@en ;
    skos:notation   "feature-set" ;
    skos:definition "A feature set."@en ;
.

:DomainType
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-domain> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-domain> ;
    skos:prefLabel  "Domain Type"@en ;
    skos:definition "The kind of business domain, e.g. product-area."@en ;
    skos:scopeNote  '''Illustrative, not normative. Unlike component and API type, where the documentation
gives a "current set of well-known and common values", this field is described as having no enforced
set and a nomenclature left to the adopting organization — the members below are the examples the
documentation offers. They are minted anyway so that two catalogues lifting the same common value land
on the same IRI instead of inventing one each, which is the interoperability the graph exists for.
Adopters add their own individuals of this class in their own namespace.

Member IRIs carry the vocabulary name as a suffix because the tokens collide across vocabularies:
"service" is both a component type and a system type, "product-area" both a group type and a domain
type. The bare token is on skos:notation, which is what a lift matches.'''@en ;
.

:domainType
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-domain> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-domain> ;
    skos:prefLabel      "Domain Type"@en ;
    skos:definition     "The type of this domain (spec.type, optional)."@en ;
    skos:scopeNote      "At most one value, enforced in shapes rather than with owl:FunctionalProperty (DD-23)."@en ;
    arch:domainIncludes :Domain ;
    arch:rangeIncludes  :DomainType ;
.

:ProductAreaDomainType
    a               owl:NamedIndividual, :DomainType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-domain> ;
    skos:prefLabel  "product-area"@en ;
    skos:notation   "product-area" ;
    skos:definition "A product area."@en ;
.

:ProductGroupDomainType
    a               owl:NamedIndividual, :DomainType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-domain> ;
    skos:prefLabel  "product-group"@en ;
    skos:notation   "product-group" ;
    skos:definition "A product group."@en ;
.

:BundleDomainType
    a               owl:NamedIndividual, :DomainType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-domain> ;
    skos:prefLabel  "bundle"@en ;
    skos:notation   "bundle" ;
    skos:definition "A bundle."@en ;
.

#################################################################
# Location fields (descriptor format, kind Location)
#
# A location's own fields: the type its targets share, the
# targets, and whether they must exist. The type is an open
# vocabulary like the spec.type sets above; the presence is
# closed, as the schema fixes it at two values, and the closure
# is stated in SHACL as API visibility's is (DD-23).
#################################################################

:LocationType
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-location> ,
                    <https://backstage.io/docs/features/software-catalog/configuration#static-location-configuration> ;
    skos:prefLabel  "Location Type"@en ;
    skos:definition "The kind of place a location's targets are read from, e.g. url or file."@en ;
    skos:scopeNote  '''Open class. The type names the processor that reads the targets, and integrations add
their own, so the members below are the two the catalogue itself documents: url, read through an integration
such as GitHub's, and file, read from the local file system. Adopters add their own individuals of this class
in their own namespace.

Member IRIs carry the vocabulary name as a suffix, as the other spec.type sets' do, and the bare token is on
skos:notation, which is what a lift matches. It is the same token that prefixes a :managedByLocation
reference, url:https://… or file:/…'''@en ;
.

:locationType
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-location> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Location.v1alpha1.schema.json> ;
    skos:prefLabel      "Location Type"@en ;
    skos:definition     "The single location type that is common to the targets of this location (spec.type, optional)."@en ;
    skos:scopeNote      '''At most one value, enforced in shapes rather than with owl:FunctionalProperty (DD-23).
Absent, the type is inherited from the location that read this entity, so a lift leaves it absent rather than
guessing one.'''@en ;
    arch:domainIncludes :Location ;
    arch:rangeIncludes  :LocationType ;
.

:UrlLocationType
    a               owl:NamedIndividual, :LocationType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/configuration#static-location-configuration> ;
    rdfs:seeAlso    <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    skos:prefLabel  "url"@en ;
    skos:notation   "url" ;
    skos:definition "Targets read by URL, through the integration configured for the host they are on."@en ;
.

:FileLocationType
    a               owl:NamedIndividual, :LocationType ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/configuration#local-file-type-file-configurations> ;
    skos:prefLabel  "file"@en ;
    skos:notation   "file" ;
    skos:definition "Targets read from the local file system, meant for local development, tests and example data."@en ;
.

:locationTarget
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-location> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Location.v1alpha1.schema.json> ;
    skos:prefLabel      "Location Target"@en ;
    skos:definition     "A place this location points the catalogue to: an absolute path or URL, depending on the type, or a path relative to the location itself (spec.target, spec.targets)."@en ;
    skos:scopeNote      '''One property for both fields. spec.target holds a single target and spec.targets a
list of them; each target is one value here, so a query reads them alike whichever field the descriptor used.
xsd:string rather than xsd:anyURI, for the reason the catalog provenance properties give: a target may be a
relative path such as ./details/catalog-info.yaml, which is no URI.'''@en ;
    arch:domainIncludes :Location ;
    rdfs:range          xsd:string ;
.

:LocationPresence
    a               owl:Class ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    rdfs:seeAlso    <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-location> ,
                    <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Location.v1alpha1.schema.json> ;
    skos:prefLabel  "Location Presence"@en ;
    skos:definition "Whether a location's targets must exist: required or optional."@en ;
    skos:scopeNote  '''A DD-23 vocabulary of named individuals, and a closed one: the schema fixes these two
values, so the closure is stated in SHACL at Violation, as for :ApiVisibility, rather than with owl:oneOf.

Member IRIs carry the vocabulary name as a suffix, because "required" and "optional" are among the most
collision-prone tokens there are; the bare token is on skos:notation.'''@en ;
.

:locationPresence
    a                   owl:ObjectProperty ;
    dcterms:source      <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    rdfs:seeAlso        <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-location> ,
                        <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Location.v1alpha1.schema.json> ;
    skos:prefLabel      "Location Presence"@en ;
    skos:definition     "Whether the targets of this location are required to exist (spec.presence, optional)."@en ;
    skos:scopeNote      '''At most one value, drawn from the LocationPresence vocabulary — enforced in shapes
(sh:maxCount 1 + sh:in), never in OWL, per DD-23. Absent means required, the schema's default; a lift records
what the descriptor states.'''@en ;
    arch:domainIncludes :Location ;
    arch:rangeIncludes  :LocationPresence ;
.

:RequiredPresence
    a               owl:NamedIndividual, :LocationPresence ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    skos:prefLabel  "required"@en ;
    skos:notation   "required" ;
    skos:definition "The targets must exist, and a target that cannot be found is an error."@en ;
.

:OptionalPresence
    a               owl:NamedIndividual, :LocationPresence ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-location> ;
    skos:prefLabel  "optional"@en ;
    skos:notation   "optional" ;
    skos:definition "The targets may be absent, and a target that cannot be found is not an error."@en ;
.
