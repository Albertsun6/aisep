    dcterms:source       <https://backstage.io/docs/features/software-catalog/well-known-annotations#jenkinsiojob-full-name> ;
    rdfs:seeAlso         <https://backstage.io/docs/next/features/software-catalog/well-known-annotations#jenkinsiojob-full-name> ;
    rdfs:subPropertyOf  :externalIdentifier ;
    skos:prefLabel      "Jenkins Job Full Name"@en ;
    skos:definition     "Path to the Jenkins job that builds this entity, as [folder-path] or [instanceName]:[folder-path] (jenkins.io/job-full-name)."@en ;
    arch:domainIncludes :Component ;
    rdfs:range          xsd:string ;
.

