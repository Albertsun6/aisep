@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix :        <https://meta.linked.archi/core-viewpoints#> .

<https://meta.linked.archi/core-viewpoints#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/core-viewpoints#" ;
    vann:preferredNamespacePrefix "archvp" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi Core Viewpoints"@en ;
    dcterms:description                '''Framework-agnostic architecture viewpoints derived from
ISO/IEC/IEEE 42010 and common architecture practice. These are universal
viewpoints that any modeling language can use — ArchiMate, TOGAF, C4,
Backstage, or custom metamodels can specialize or reference them.'''@en ;
    dcterms:created               "2019-03-17"^^xsd:date ;
    dcterms:modified              "2026-04-15"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/core-viewpoints/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    rdfs:seeAlso                  <https://www.iso.org/standard/74393.html> ;
.


#################################################################
# Purpose Individuals (framework-agnostic)
#################################################################

:Deciding    a arch:Purpose ; skos:prefLabel "Deciding"@en ;
    skos:definition "Evaluating options, making trade-offs, selecting alternatives."@en .
:Designing   a arch:Purpose ; skos:prefLabel "Designing"@en ;
    skos:definition "Creating or refining architecture — defining structure and behavior."@en .
:Informing   a arch:Purpose ; skos:prefLabel "Informing"@en ;
    skos:definition "Communicating architecture to stakeholders for understanding and alignment."@en .
:Governing   a arch:Purpose ; skos:prefLabel "Governing"@en ;
    skos:definition "Ensuring compliance, enforcing standards, managing change."@en .


#################################################################
# Concern Individuals (framework-agnostic)
#################################################################

:StructureConcern       a arch:Concern ; skos:prefLabel "Structure"@en ;
    skos:definition "What components exist and how they are organized."@en .
:BehaviorConcern        a arch:Concern ; skos:prefLabel "Behavior"@en ;
    skos:definition "How components interact, what processes execute, what flows occur."@en .
:DeploymentConcern      a arch:Concern ; skos:prefLabel "Deployment"@en ;
    skos:definition "Where components run and how they are distributed."@en .
:DependencyConcern      a arch:Concern ; skos:prefLabel "Dependencies"@en ;
    skos:definition "What depends on what — impact analysis and change propagation."@en .
:GovernanceConcern      a arch:Concern ; skos:prefLabel "Governance"@en ;
    skos:definition "Who owns what, what standards apply, what decisions were made."@en .
:EvolutionConcern       a arch:Concern ; skos:prefLabel "Evolution"@en ;
    skos:definition "How the architecture changes over time — roadmaps and transitions."@en .
:QualityConcern         a arch:Concern ; skos:prefLabel "Quality"@en ;
    skos:definition "Non-functional characteristics — performance, security, reliability."@en .
:CostConcern            a arch:Concern ; skos:prefLabel "Cost"@en ;
    skos:definition "Financial aspects — total cost of ownership, licensing, operational cost."@en .
:IntegrationConcern     a arch:Concern ; skos:prefLabel "Integration"@en ;
    skos:definition "How systems connect — interfaces, protocols, data exchange."@en .
:StakeholderConcern     a arch:Concern ; skos:prefLabel "Stakeholder Interests"@en ;
    skos:definition "Who cares about what — mapping stakeholders to their concerns."@en .


#################################################################
# Core Viewpoints — Structure
#################################################################

:LandscapeOverview
    a                       arch:Viewpoint ;
    skos:prefLabel          "Landscape Overview"@en ;
    skos:definition         '''High-level overview of the architecture showing major components
and their relationships across all domains. The entry point for understanding
the architecture.'''@en ;
    arch:viewpointHasPurpose :Informing ;
    arch:viewpointFramesConcern :StructureConcern, :DependencyConcern ;
    arch:viewType           arch:Diagram ;
.

:ComponentCatalog
    a                       arch:Viewpoint ;
    skos:prefLabel          "Component Catalog"@en ;
    skos:definition         '''Inventory of all architecture components with key attributes
(owner, status, domain, technology). The foundation for portfolio management.'''@en ;
    arch:viewpointHasPurpose :Informing, :Deciding ;
    arch:viewpointFramesConcern :StructureConcern, :GovernanceConcern ;
    arch:viewType           arch:Catalog ;
.


#################################################################
# Core Viewpoints — Behavior
#################################################################

:ProcessFlow
    a                       arch:Viewpoint ;
    skos:prefLabel          "Process Flow"@en ;
    skos:definition         '''Shows the sequence of activities in a process, including
decision points, parallel paths, and handoffs between actors.'''@en ;
    arch:viewpointHasPurpose :Designing ;
    arch:viewpointFramesConcern :BehaviorConcern ;
    arch:viewType           arch:Diagram ;
.

:InterfaceMap
    a                       arch:Viewpoint ;
    skos:prefLabel          "Interface Map"@en ;
    skos:definition         '''Shows how components connect to each other — interfaces,
protocols, data flows, and integration patterns.'''@en ;
    arch:viewpointHasPurpose :Designing ;
    arch:viewpointFramesConcern :IntegrationConcern, :DependencyConcern ;
    arch:viewType           arch:Diagram ;
.


#################################################################
# Core Viewpoints — Deployment
#################################################################

:DeploymentMap
    a                       arch:Viewpoint ;
    skos:prefLabel          "Deployment Map"@en ;
    skos:definition         '''Shows where components are deployed — infrastructure nodes,
environments, locations, and their hosting relationships.'''@en ;
    arch:viewpointHasPurpose :Designing, :Informing ;
    arch:viewpointFramesConcern :DeploymentConcern ;
    arch:viewType           arch:Diagram ;
.


#################################################################
# Core Viewpoints — Dependencies
#################################################################

:DependencyMatrix
    a                       arch:Viewpoint ;
    skos:prefLabel          "Dependency Matrix"@en ;
    skos:definition         '''Shows dependencies between components as a matrix — which
components depend on which, enabling impact analysis.'''@en ;
    arch:viewpointHasPurpose :Deciding ;
    arch:viewpointFramesConcern :DependencyConcern ;
    arch:viewType           arch:Matrix ;
.

:ImpactAnalysis
    a                       arch:Viewpoint ;
    skos:prefLabel          "Impact Analysis"@en ;
    skos:definition         '''Shows the propagation of change from a source component
through its dependencies — what breaks if this changes.'''@en ;
    arch:viewpointHasPurpose :Deciding ;
    arch:viewpointFramesConcern :DependencyConcern, :EvolutionConcern ;
    arch:viewType           arch:Diagram, arch:Matrix ;
.


#################################################################
# Core Viewpoints — Governance
#################################################################

:DecisionLog
    a                       arch:Viewpoint ;
    skos:prefLabel          "Decision Log"@en ;
    skos:definition         '''Catalog of architecture decisions with their context, options
considered, rationale, and status. Supports traceability and
institutional memory.'''@en ;
    arch:viewpointHasPurpose :Governing ;
    arch:viewpointFramesConcern :GovernanceConcern ;
    arch:viewType           arch:Catalog ;
.

:StakeholderMap
    a                       arch:Viewpoint ;
    skos:prefLabel          "Stakeholder Map"@en ;
    skos:definition         '''Maps stakeholders to their concerns, influence, and the
viewpoints that address them. The starting point for architecture
communication planning.'''@en ;
    arch:viewpointHasPurpose :Informing, :Deciding ;
    arch:viewpointFramesConcern :StakeholderConcern ;
    arch:viewType           arch:Matrix ;
.

:StandardsCompliance
    a                       arch:Viewpoint ;
    skos:prefLabel          "Standards Compliance"@en ;
    skos:definition         '''Shows which components comply with which standards, and
where deviations exist. Supports governance reviews.'''@en ;
    arch:viewpointHasPurpose :Governing ;
    arch:viewpointFramesConcern :GovernanceConcern, :QualityConcern ;
    arch:viewType           arch:Matrix ;
.


#################################################################
# Core Viewpoints — Evolution
#################################################################

:Roadmap
    a                       arch:Viewpoint ;
    skos:prefLabel          "Roadmap"@en ;
    skos:definition         '''Shows the planned evolution of the architecture over time —
current state, target state, and the transition steps between them.'''@en ;
    arch:viewpointHasPurpose :Deciding, :Informing ;
    arch:viewpointFramesConcern :EvolutionConcern ;
    arch:viewType           arch:Diagram ;
.

:GapAnalysis
    a                       arch:Viewpoint ;
    skos:prefLabel          "Gap Analysis"@en ;
    skos:definition         '''Shows the differences between baseline and target architecture —
what needs to be added, changed, or removed.'''@en ;
    arch:viewpointHasPurpose :Deciding ;
    arch:viewpointFramesConcern :EvolutionConcern, :CostConcern ;
    arch:viewType           arch:Matrix ;
.

