@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix :        <https://meta.linked.archi/archimate4/reference-models#> .

:ArchiMateReferenceModels
    a                skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate4/reference-models#" ;
    vann:preferredNamespacePrefix "am4rm" ;
    dcterms:title                 "Linked.Archi ArchiMate 4.0 Reference Models"@en ;
    owl:versionInfo               "4.0"@en ;
    skos:prefLabel   "ArchiMate 4.0 Reference Models"@en ;
    dcterms:description  "Catalog of reference architectures and patterns for ArchiMate 4.0 models."@en ;
    dcterms:description   "Reference model definitions for ArchiMate 4.0 architecture patterns."@en ;
    dcterms:creator  "Kalin Maldzhanski"^^xsd:string ;
    skos:hasTopConcept :ReferencePatterns, :IndustryReferenceModels ;
.

:ReferencePatterns
    a skos:Concept ; skos:topConceptOf :ArchiMateReferenceModels ;
    skos:prefLabel "Architecture Patterns"@en ;
    skos:inScheme :ArchiMateReferenceModels .
:LayeredPattern       a skos:Concept ; skos:prefLabel "Layered Architecture"@en ;
    skos:broader :ReferencePatterns ; skos:inScheme :ArchiMateReferenceModels .
:MicroservicesPattern a skos:Concept ; skos:prefLabel "Microservices Architecture"@en ;
    skos:broader :ReferencePatterns ; skos:inScheme :ArchiMateReferenceModels .
:EventDrivenPattern   a skos:Concept ; skos:prefLabel "Event-Driven Architecture"@en ;
    skos:broader :ReferencePatterns ; skos:inScheme :ArchiMateReferenceModels .
:SOAPattern           a skos:Concept ; skos:prefLabel "Service-Oriented Architecture"@en ;
    skos:broader :ReferencePatterns ; skos:inScheme :ArchiMateReferenceModels .

:IndustryReferenceModels
    a skos:Concept ; skos:topConceptOf :ArchiMateReferenceModels ;
    skos:prefLabel "Industry Reference Models"@en ;
    skos:inScheme :ArchiMateReferenceModels .
:BIAN    a skos:Concept ; skos:prefLabel "BIAN (Banking Industry Architecture Network)"@en ;
    rdfs:seeAlso <https://bian.org/> ;
    skos:broader :IndustryReferenceModels ; skos:inScheme :ArchiMateReferenceModels .
:TMForum a skos:Concept ; skos:prefLabel "TM Forum Frameworx"@en ;
    rdfs:seeAlso <https://www.tmforum.org/> ;
    skos:broader :IndustryReferenceModels ; skos:inScheme :ArchiMateReferenceModels .
:ACORD   a skos:Concept ; skos:prefLabel "ACORD Framework"@en ;
    rdfs:seeAlso <https://www.acord.org/> ;
    skos:broader :IndustryReferenceModels ; skos:inScheme :ArchiMateReferenceModels .
