@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix :        <https://meta.linked.archi/backstage/presentation-contexts#> .

#################################################################
# Backstage Presentation Contexts
#################################################################

:BackstagePresentationContexts
    a                skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/backstage/presentation-contexts#" ;
    vann:preferredNamespacePrefix "bspc" ;
    dcterms:title                 "Linked.Archi Backstage Presentation Contexts"@en ;
    owl:versionInfo               "0.1.0"@en ;
    skos:prefLabel   "Backstage Presentation Contexts"@en ;
    dcterms:description   "Stakeholder-specific presentation contexts for Backstage catalog views."@en ;
    dcterms:creator  "Kalin Maldzhanski"^^xsd:string ;
    dcterms:publisher "Linked.Archi"@en ;
    dcterms:source   <https://backstage.io/docs/features/software-catalog/> ;
    prov:wasDerivedFrom <https://backstage.io/docs/features/software-catalog/> ;
    rdfs:seeAlso     <https://backstage.io/> ,
                     <https://backstage.io/docs/features/software-catalog/> ,
                     <https://github.com/backstage/backstage> ,
                     <https://github.com/backstage/backstage/tree/master/docs/features/software-catalog> ;
    skos:hasTopConcept :DeveloperContext, :PlatformEngineerContext, :EngineeringManagerContext ;
.

:DeveloperContext
    a skos:Concept ; skos:topConceptOf :BackstagePresentationContexts ;
    skos:prefLabel "Developer"@en ;
    skos:definition '''Service catalog and API dependency views. Focus on components the
developer owns or consumes, API specifications, and resource dependencies.
Standard Backstage catalog notation.'''@en ;
    skos:inScheme :BackstagePresentationContexts ;
.

:PlatformEngineerContext
    a skos:Concept ; skos:topConceptOf :BackstagePresentationContexts ;
    skos:prefLabel "Platform Engineer"@en ;
    skos:definition '''System dependency and resource views. Full infrastructure details,
resource provisioning status, API types, and cross-system dependency chains.
Operational annotations (lifecycle, SLOs).'''@en ;
    skos:inScheme :BackstagePresentationContexts ;
.

:EngineeringManagerContext
    a skos:Concept ; skos:topConceptOf :BackstagePresentationContexts ;
    skos:prefLabel "Engineering Manager"@en ;
    skos:definition '''Ownership and domain overview. Simplified views showing team
ownership, domain boundaries, and system-level structure. No technical
implementation details.'''@en ;
    skos:inScheme :BackstagePresentationContexts ;
.
