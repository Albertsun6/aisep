@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix admit:   <https://meta.linked.archi/admit/onto#> .
@prefix admittax: <https://meta.linked.archi/admit/tax#> .
@prefix :        <https://meta.linked.archi/admit/metamodel#> .

<https://meta.linked.archi/admit/metamodel#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/admit/metamodel#" ;
    vann:preferredNamespacePrefix "admitmm" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi ADMIT Metamodel Definition"@en ;
    dcterms:description                '''Metamodel manifest for ADMIT. Ties together the ADMIT ontology
and concept taxonomy into a single discoverable resource.'''@en ;
    dcterms:created               "2020-07-27"^^xsd:date ;
    dcterms:modified              "2026-05-02"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/admit/metamodel/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:source  <https://www.infoq.com/articles/admit-architecture-framework/> ;
    prov:wasDerivedFrom <https://www.infoq.com/articles/admit-architecture-framework/> ;
.

:ADMITFramework
    a               arch:Framework ;
    skos:prefLabel  "ADMIT"@en ;
    skos:definition '''Architecture-Driven Modernization of IT (ADMIT) — a practical
architecture framework by Prasad Rao that provides a structured approach to
modernizing enterprise IT through architecture levels, domains, design forces,
and a development lifecycle.'''@en ;
    dcterms:publisher    "Prasad Rao"@en ;
    rdfs:seeAlso    <https://www.infoq.com/articles/admit-architecture-framework/> ;
.

:ADMIT
    a                             arch:Metamodel ;
    skos:prefLabel                "ADMIT Metamodel"@en ;
    dcterms:description               '''The complete ADMIT metamodel definition, aggregating the ADMIT
ontology and concept taxonomy.'''@en ;

    arch:basedOnFramework         :ADMITFramework ;

    ## Content — entity types and relationships
    arch:modelConcepts            <https://meta.linked.archi/admit/onto#> ;

    ## Concept classification — SKOS taxonomy
    arch:conceptClassification    <https://meta.linked.archi/admit/tax#> ;
.
