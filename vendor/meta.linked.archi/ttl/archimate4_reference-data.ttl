@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix :        <https://meta.linked.archi/archimate4/reference-data#> .

:ArchiMateReferenceData
    a                skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate4/reference-data#" ;
    vann:preferredNamespacePrefix "am4rd" ;
    dcterms:title                 "Linked.Archi ArchiMate 4.0 Reference Data"@en ;
    owl:versionInfo               "4.0"@en ;
    skos:prefLabel   "ArchiMate 4.0 Reference Data"@en ;
    dcterms:description   "Controlled vocabularies and reference data for ArchiMate 4.0 architecture models."@en ;
    dcterms:creator  "Kalin Maldzhanski"^^xsd:string ;
    skos:hasTopConcept :EnvironmentTypes, :CriticalityLevels ;
.

#################################################################
# Lifecycle states are NOT defined here.
#
# They are notation-agnostic — nothing about "Active" or "Phase Out"
# derives from ArchiMate — so they live in the Architecture Processes
# extension as instances of ap:LifecycleStage:
#
#   ap:Plan, ap:PhaseIn, ap:Active, ap:PhaseOut, ap:Retired
#   <https://meta.linked.archi/arch-processes#>
#
# The former :Proposed and :Approved concepts were governance standing,
# not lifecycle stages, and moved to the core ontology:
#
#   arch:Proposed, arch:Approved  (arch:ApprovalState)
#   <https://meta.linked.archi/core#>
#################################################################

:EnvironmentTypes
    a skos:Concept ; skos:topConceptOf :ArchiMateReferenceData ;
    skos:prefLabel "Environment Types"@en ;
    skos:inScheme :ArchiMateReferenceData .
:Development  a skos:Concept ; skos:prefLabel "Development"@en ;  skos:broader :EnvironmentTypes ; skos:inScheme :ArchiMateReferenceData .
:Test         a skos:Concept ; skos:prefLabel "Test"@en ;         skos:broader :EnvironmentTypes ; skos:inScheme :ArchiMateReferenceData .
:Staging      a skos:Concept ; skos:prefLabel "Staging"@en ;      skos:broader :EnvironmentTypes ; skos:inScheme :ArchiMateReferenceData .
:Production   a skos:Concept ; skos:prefLabel "Production"@en ;   skos:broader :EnvironmentTypes ; skos:inScheme :ArchiMateReferenceData .
:DR           a skos:Concept ; skos:prefLabel "Disaster Recovery"@en ; skos:broader :EnvironmentTypes ; skos:inScheme :ArchiMateReferenceData .

:CriticalityLevels
    a skos:Concept ; skos:topConceptOf :ArchiMateReferenceData ;
    skos:prefLabel "Criticality Levels"@en ;
    skos:inScheme :ArchiMateReferenceData .
:MissionCritical     a skos:Concept ; skos:prefLabel "Mission Critical"@en ;     skos:broader :CriticalityLevels ; skos:inScheme :ArchiMateReferenceData .
:BusinessCritical    a skos:Concept ; skos:prefLabel "Business Critical"@en ;    skos:broader :CriticalityLevels ; skos:inScheme :ArchiMateReferenceData .
:BusinessOperational a skos:Concept ; skos:prefLabel "Business Operational"@en ; skos:broader :CriticalityLevels ; skos:inScheme :ArchiMateReferenceData .
:Administrative      a skos:Concept ; skos:prefLabel "Administrative"@en ;       skos:broader :CriticalityLevels ; skos:inScheme :ArchiMateReferenceData .
