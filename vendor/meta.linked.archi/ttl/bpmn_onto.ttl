#################################################################
# Relationship predicates
#
# The direct triple of each connector a diagram draws between two
# elements, and the qualified properties that lead from its source to its
# resource. The data associations share one predicate: its direction tells
# an input (data to an activity or event) from an output (from one).
#################################################################

bpmn:sequenceFlow
    a                    owl:ObjectProperty ;
    skos:prefLabel       "sequence flow"@en ;
    skos:definition      "The direct form of a sequence flow: in a process, the target flow node follows the source."@en ;
    arch:domainIncludes  bpmn:FlowNode ;
    arch:rangeIncludes   bpmn:FlowNode ;
.

bpmn:qualifiedSequenceFlow
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:SequenceFlow ;
    arch:unqualifiedForm bpmn:sequenceFlow ;
.

bpmn:messageFlow
    a                    owl:ObjectProperty ;
    skos:prefLabel       "message flow"@en ;
    skos:definition      "The direct form of a message flow: the source sends a message that the target receives."@en ;
    arch:domainIncludes  bpmn:InteractionNode ;
    arch:rangeIncludes   bpmn:InteractionNode ;
.

bpmn:qualifiedMessageFlow
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:MessageFlow ;
    arch:unqualifiedForm bpmn:messageFlow ;
.

bpmn:association
    a                    owl:ObjectProperty ;
    skos:prefLabel       "association"@en ;
    skos:definition      "The direct form of an association: an artifact, such as a text annotation, is linked to the element it is about."@en ;
    arch:domainIncludes  bpmn:BaseElement ;
    arch:rangeIncludes   bpmn:BaseElement ;
.

bpmn:qualifiedAssociation
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:Association ;
    arch:unqualifiedForm bpmn:association ;
.

bpmn:conversationLink
    a                    owl:ObjectProperty ;
    skos:prefLabel       "conversation link"@en ;
    skos:definition      "The direct form of a conversation link: the participant takes part in the conversation."@en ;
    arch:domainIncludes  bpmn:InteractionNode ;
    arch:rangeIncludes   bpmn:ConversationNode ;
.

bpmn:qualifiedConversationLink
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:ConversationLink ;
    arch:unqualifiedForm bpmn:conversationLink ;
.

bpmn:dataAssociation
    a                    owl:ObjectProperty ;
    skos:prefLabel       "data association"@en ;
    skos:definition      "The direct form of a data association, input or output: data moves from the source to the target."@en ;
    arch:domainIncludes  bpmn:ItemAwareElement, bpmn:Activity, bpmn:Event ;
    arch:rangeIncludes   bpmn:ItemAwareElement, bpmn:Activity, bpmn:Event ;
.

bpmn:qualifiedDataAssociation
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:DataAssociation ;
    arch:unqualifiedForm bpmn:dataAssociation ;
.

bpmn:qualifiedDataInputAssociation
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:DataInputAssociation ;
    arch:unqualifiedForm bpmn:dataAssociation ;
.

bpmn:qualifiedDataOutputAssociation
    a                    owl:ObjectProperty ;
    rdfs:range           bpmn:DataOutputAssociation ;
    arch:unqualifiedForm bpmn:dataAssociation ;
.
