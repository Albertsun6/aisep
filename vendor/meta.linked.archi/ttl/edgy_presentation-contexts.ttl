@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix bibo:      <http://purl.org/ontology/bibo/> .
@prefix vann:      <http://purl.org/vocab/vann/> .
@prefix cc:        <http://creativecommons.org/ns#> .

@prefix arch:      <https://meta.linked.archi/core#> .
@prefix edgynot:   <https://meta.linked.archi/edgy/notation#> .
@prefix edgynotv1: <https://meta.linked.archi/edgy/notation-v1#> .
@prefix :          <https://meta.linked.archi/edgy/presentation-contexts#> .

#################################################################
# EDGY 23 Presentation Contexts
#################################################################

<https://meta.linked.archi/edgy/presentation-contexts#>
    a                             skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by-sa/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/edgy/presentation-contexts#" ;
    vann:preferredNamespacePrefix "edgypc" ;
    skos:prefLabel                "EDGY 23 Presentation Contexts"@en ;
    dcterms:title                 "Linked.Archi EDGY 23 Presentation Contexts"@en ;
    dcterms:description           '''Audiences for EDGY 23 maps. Each context is an audience, as the core
ontology defines a presentation context, and picks one of EDGY's two notation sets with
arch:usesNotationSet: the Enterprise designer context the default (v2) set, the Overview map
reader context the circle-based v1 set. The EDGY manifest,
https://meta.linked.archi/edgy/metamodel#EDGY23, names only the v2 set with arch:notationSet,
which keeps it the default; the v1 set is reached through this scheme alone.'''@en ;
    dcterms:created               "2026-10-05"^^xsd:date ;
    dcterms:modified              "2026-10-05"^^xsd:date ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionInfo               "23"@en ;
    dcterms:source                <https://enterprise.design/wiki/Enterprise_Elements> ;
    prov:wasDerivedFrom           <https://enterprise.design/wiki/Enterprise_Elements> ;
    skos:hasTopConcept            :EnterpriseDesignerContext, :OverviewMapContext ;
.

:EnterpriseDesignerContext
    a                    skos:Concept ;
    skos:topConceptOf    <https://meta.linked.archi/edgy/presentation-contexts#> ;
    skos:inScheme        <https://meta.linked.archi/edgy/presentation-contexts#> ;
    skos:prefLabel       "Enterprise designer"@en ;
    skos:definition      '''People who design an enterprise with EDGY: they map its identity,
architecture and experience facets, the elements where those facets intersect, and the links
between them.'''@en ;
    skos:scopeNote       '''Uses the default (v2) set, the one the EDGY manifest names with
arch:notationSet. Its distinct shapes (rounded rectangles for outcomes, arrows for activities,
rectangles for objects and a person glyph for people) keep each element family recognizable in
detailed design work.'''@en ;
    arch:usesNotationSet edgynot:EDGYStandardNotation ;
.

:OverviewMapContext
    a                    skos:Concept ;
    skos:topConceptOf    <https://meta.linked.archi/edgy/presentation-contexts#> ;
    skos:inScheme        <https://meta.linked.archi/edgy/presentation-contexts#> ;
    skos:prefLabel       "Overview map reader"@en ;
    skos:definition      '''People who read high-density EDGY overview maps, such as a whole
enterprise landscape on one page, rather than author the design.'''@en ;
    skos:scopeNote       '''Uses the circle-based v1 set. Every element is a small circle with a
facet-coloured fill and a centred glyph, which is compact and iconic and suits high-density
maps.'''@en ;
    arch:usesNotationSet edgynotv1:EDGYStandardNotation ;
.
