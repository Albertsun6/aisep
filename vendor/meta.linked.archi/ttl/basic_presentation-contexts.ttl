@prefix owl:            <http://www.w3.org/2002/07/owl#> .
@prefix xsd:            <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:           <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:        <http://purl.org/dc/terms/> .
@prefix prov:           <http://www.w3.org/ns/prov#> .
@prefix bibo:           <http://purl.org/ontology/bibo/> .
@prefix vann:           <http://purl.org/vocab/vann/> .
@prefix cc:             <http://creativecommons.org/ns#> .

@prefix arch:           <https://meta.linked.archi/core#> .
@prefix basicnot:       <https://meta.linked.archi/basic/notation#> .
@prefix basicnotbubble: <https://meta.linked.archi/basic/notation-bubble#> .
@prefix :               <https://meta.linked.archi/basic/presentation-contexts#> .

#################################################################
# Basic Presentation Contexts
#################################################################

<https://meta.linked.archi/basic/presentation-contexts#>
    a                             skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/basic/presentation-contexts#" ;
    vann:preferredNamespacePrefix "basicpc" ;
    skos:prefLabel                "Basic Presentation Contexts"@en ;
    dcterms:title                 "Linked.Archi Basic Presentation Contexts"@en ;
    dcterms:description           '''Audiences for Basic diagrams. Each context is an audience, as the
core ontology defines a presentation context, and picks one of Basic's two notation sets with
arch:usesNotationSet: the Modeller context the rectangle set, the Workshop participant context
the bubble set. The Basic manifest, https://meta.linked.archi/basic/metamodel#Basic, names only
the rectangle set with arch:notationSet, which keeps it the default; the bubble set is reached
through this scheme alone.'''@en ;
    dcterms:created               "2026-10-05"^^xsd:date ;
    dcterms:modified              "2026-10-05"^^xsd:date ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:source                <https://meta.linked.archi/basic>,
                                  <https://meta.linked.archi/core#> ;
    prov:wasDerivedFrom           <https://meta.linked.archi/basic>,
                                  <https://meta.linked.archi/core#> ;
    skos:hasTopConcept            :ModellerContext, :WorkshopContext ;
.

:ModellerContext
    a                    skos:Concept ;
    skos:topConceptOf    <https://meta.linked.archi/basic/presentation-contexts#> ;
    skos:inScheme        <https://meta.linked.archi/basic/presentation-contexts#> ;
    skos:prefLabel       "Modeller"@en ;
    skos:definition      '''People who build and maintain structured Basic models: they place, align
and connect many elements on one canvas and keep the diagram consistent with the model.'''@en ;
    skos:scopeNote       '''Uses the rectangle set, the manifest's default. Compact rectangles pack
into rows and grids, align on shared edges and keep long labels on one line, which suits dense,
structured diagrams.'''@en ;
    arch:usesNotationSet basicnot:BasicRectangleNotation ;
.

:WorkshopContext
    a                    skos:Concept ;
    skos:topConceptOf    <https://meta.linked.archi/basic/presentation-contexts#> ;
    skos:inScheme        <https://meta.linked.archi/basic/presentation-contexts#> ;
    skos:prefLabel       "Workshop participant"@en ;
    skos:definition      '''People exploring ideas together in a workshop, concept-mapping or
whiteboard session, where the diagram sketches ideas and how they relate rather than recording a
structured model.'''@en ;
    skos:scopeNote       '''Uses the bubble set. Loose circles read as ideas rather than as
components or boxes in a structure, which keeps a concept map informal and invites
rearranging.'''@en ;
    arch:usesNotationSet basicnotbubble:BasicBubbleNotation ;
.
