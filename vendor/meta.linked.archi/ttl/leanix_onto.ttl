    skos:definition      "Links the source of a Produces relationship to its relationship resource."@en ;
    rdfs:range           :Produces ;
    arch:unqualifiedForm :produces ;
.

## realizes — Data Product → Data Object

:realizes
    a                    owl:ObjectProperty ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Realizes"@en ;
    skos:definition      "A data product realizes a data object."@en ;
    arch:domainIncludes  :DataProduct ;
    arch:rangeIncludes   :DataObject ;
.

:Realizes
    a                    owl:Class ;
    rdfs:subClassOf      arch:QualifiedRelationship ;
    arch:unqualifiedForm :realizes ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Realizes"@en ;
    skos:definition      "A data product realizes a data object."@en ;
    skos:scopeNote       "Optional in Meta Model v4: Data Product → Data Object."@en ;
.

:qualifiedRealizes
    a                    owl:ObjectProperty ;
    skos:prefLabel       "qualified realizes"@en ;
    skos:definition      "Links the source of a Realizes relationship to its relationship resource."@en ;
    rdfs:range           :Realizes ;
    arch:unqualifiedForm :realizes ;
.

## derivesFrom — Data Product → Data Product

:derivesFrom
    a                    owl:ObjectProperty ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Derives From"@en ;
    skos:definition      "A data product derives from another data product, which is its origin."@en ;
    arch:domainIncludes  :DataProduct ;
    arch:rangeIncludes   :DataProduct ;
.

:DerivesFrom
    a                    owl:Class ;
    rdfs:subClassOf      arch:QualifiedRelationship ;
    arch:unqualifiedForm :derivesFrom ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Derives From"@en ;
    skos:definition      "A data product derives from another data product, which is its origin."@en ;
    skos:scopeNote       "Optional in Meta Model v4: Data Product → Data Product."@en ;
.

:qualifiedDerivesFrom
    a                    owl:ObjectProperty ;
    skos:prefLabel       "qualified derives From"@en ;
    skos:definition      "Links the source of a Derives From relationship to its relationship resource."@en ;
    rdfs:range           :DerivesFrom ;
    arch:unqualifiedForm :derivesFrom ;
.

## isAttachedTo — Contract → Application

:isAttachedTo
    a                    owl:ObjectProperty ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Is Attached To"@en ;
    skos:definition      "A contract is attached to an application."@en ;
    arch:domainIncludes  :Contract ;
    arch:rangeIncludes   :Application ;
.

:IsAttachedTo
    a                    owl:Class ;
    rdfs:subClassOf      arch:QualifiedRelationship ;
    arch:unqualifiedForm :isAttachedTo ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Is Attached To"@en ;
    skos:definition      "A contract is attached to an application."@en ;
    skos:scopeNote       "Optional in Meta Model v4: Contract → Application."@en ;
.

:qualifiedIsAttachedTo
    a                    owl:ObjectProperty ;
    skos:prefLabel       "qualified is Attached To"@en ;
    skos:definition      "Links the source of a Is Attached To relationship to its relationship resource."@en ;
    rdfs:range           :IsAttachedTo ;
    arch:unqualifiedForm :isAttachedTo ;
.

## powers — Extension → Business Application

:powers
    a                    owl:ObjectProperty ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Powers"@en ;
    skos:definition      "An extension powers its host business application."@en ;
    arch:domainIncludes  :Extension ;
    arch:rangeIncludes   :BusinessApplication ;
.

:Powers
    a                    owl:Class ;
    rdfs:subClassOf      arch:QualifiedRelationship ;
    arch:unqualifiedForm :powers ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Powers"@en ;
    skos:definition      "An extension powers its host business application."@en ;
    skos:scopeNote       "Optional in Meta Model v4: Extension → Business Application."@en ;
.

:qualifiedPowers
    a                    owl:ObjectProperty ;
    skos:prefLabel       "qualified powers"@en ;
    skos:definition      "Links the source of a Powers relationship to its relationship resource."@en ;
    rdfs:range           :Powers ;
    arch:unqualifiedForm :powers ;
.

## parentOf — FactSheet → FactSheet ─────────────────────────────
##
## Every LeanIX fact sheet type is hierarchical. relToParent and relToChild are
## the two ends of one edge, and they are how a capability breakdown, an
## organizational structure and an IT component tree are all expressed — so this
## is the hierarchy relationship represented in this profile, and the one a
## capability map is drawn from.
##
## Direction is parent → child, matching the relToChild reading. LeanIX exports
## the edge twice, once from each end, so a converter canonicalizes both
## exported forms onto this one direction.

:parentOf
    a                    owl:ObjectProperty ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/general-modeling-guidelines> ;
    rdfs:seeAlso         <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel       "Parent Of"@en ;
    skos:definition      "Fact sheet is the hierarchical parent of another fact sheet of the same type."@en ;
    skos:scopeNote       '''Parent and child are always of the same fact sheet type — LeanIX
hierarchies do not cross types. That is a data rule rather than an OWL one, so it is not stated as
an axiom here; a shape may check it where the exported scope makes it checkable.

A LeanIX hierarchy is also a taxonomy, so emitting skos:broader from child to parent alongside this
predicate is worthwhile and costs nothing: a consumer that understands SKOS then gets the tree
without knowing anything about LeanIX. skos:broader is additive, not a substitute — it carries no
relationship resource, so it cannot be typed, annotated or validated.'''@en ;
    arch:domainIncludes  :FactSheet ;
    arch:rangeIncludes   :FactSheet ;
.

:FactSheetHierarchy
    a                    owl:Class ;
    rdfs:subClassOf      arch:QualifiedRelationship ;
    arch:unqualifiedForm :parentOf ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/general-modeling-guidelines> ;
    rdfs:seeAlso         <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel       "Fact Sheet Hierarchy"@en ;
    skos:definition      "A hierarchical relationship from a parent fact sheet to a child fact sheet of the same type."@en ;
    skos:scopeNote       '''Named for what LeanIX calls it rather than "Composition", which in a
merged multi-notation graph would invite reading it as ArchiMate's composition — a different
relationship with whole-part semantics this one does not assert.'''@en ;
.

:qualifiedFactSheetHierarchy
    a                    owl:ObjectProperty ;
    rdfs:range           :FactSheetHierarchy ;
    arch:unqualifiedForm :parentOf ;
.


#################################################################
# Fact Sheet Attributes
#
# A LeanIX fact sheet is mostly attributes, and this ontology declared none, so
# every value a GraphQL pull returns beyond a name and a description had nowhere
# to go. Declared below is the set every workspace has.
#
# Attributes that already have a published home keep it, and no lmm: term is
# minted to shadow them:
#
#   LeanIX field          term used instead
#   ───────────────────── ──────────────────────────────────────────────
#   id                    skos:notation
#   displayName           skos:prefLabel, language-tagged (DD-24)
#   name                  skos:altLabel
#   description           skos:definition
#   type                  dcterms:type, verbatim, as retained source data
#   createdAt / updatedAt dcterms:created / dcterms:modified
#   fact sheet URL        schema:url
#   lifecycle.asString    ap:atLifecycleStage — see the lifecycle section
#
# On the type token specifically: rdf:type already carries the class, and the
# matching taxonomy concept is reachable from it through rdfs:seeAlso in
# leanIX-tax.ttl. What neither records is what a workspace calls a type it has
# renamed or added, which is what the verbatim literal is for — so there is no
# :factSheetType predicate here, deliberately.
#
# None of the object properties below take the qualified relationship treatment.
# The three-declaration pattern (P-4) is for the relationship types in the
# metamodel's palette — edges an architect draws between fact sheets. A
# subscription or a dated phase is attribute structure hanging off one fact
# sheet, so it is a plain owl:ObjectProperty, as bs:lifecycleState is in the
# Backstage ontology.
#################################################################

## Completion ───────────────────────────────────────────────────

:completion
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/fact-sheet-completeness> ;
    rdfs:seeAlso        <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel      "Completion"@en ;
    skos:definition     "Completion ratio between 0 and 1, computed by LeanIX from the weights assigned to the fields, subsections and sections of the fact sheet type."@en ;
    skos:scopeNote      '''A derived measure rather than something an author asserts: it moves when
the workspace changes its field weights, without the fact sheet changing at all. Treat a value as a
snapshot of the source system at export time, not as a property of the architecture.

LeanIX renders the same number as a percentage in the fact sheet header. Store the ratio and format
on display, so that two workspaces reporting 0.8 and 80 are not two different values.'''@en ;
    arch:domainIncludes :FactSheet ;
    rdfs:range          xsd:decimal ;
.

## Status — the record's state in the workspace ─────────────────
##
## Values are named individuals, not strings, per DD-23: an individual carries a
## label, a definition and a notation, can be mapped to an external vocabulary,
## and can be dereferenced — where a literal "ACTIVE" carries none of that and a
## typo in it is indistinguishable from a new value. Membership of the set is a
## SHACL matter (sh:maxCount 1 + sh:in in leanIX-shapes.ttl), not an owl:oneOf,
## so a workspace that gains a state does not have to edit this ontology.

:FactSheetStatus
    a               owl:Class ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel  "Fact Sheet Status"@en ;
    skos:definition "The state of a fact sheet as a record in the workspace — whether it is live, archived, or in an inconsistent state."@en ;
    skos:scopeNote  '''Neither a lifecycle nor an approval state, and the three are independent:

* :FactSheetStatus says whether the record is live in the workspace.
* ap:LifecycleStage says where the thing the record describes sits in its own life.
* arch:approvalState says whether the description carries governance authority.

An archived fact sheet can describe an application that is still running, and an active fact sheet
can describe one that was retired years ago.

The field name has varied across LeanIX API versions; the value set has not.'''@en ;
.

:factSheetStatus
    a                   owl:ObjectProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel      "Fact Sheet Status"@en ;
    skos:definition     "The state of the fact sheet as a record in the workspace."@en ;
    skos:scopeNote      "At most one value — enforced in shapes, not with owl:FunctionalProperty (DD-23)."@en ;
    arch:domainIncludes :FactSheet ;
    arch:rangeIncludes  :FactSheetStatus ;
.

:StatusActive
    a               owl:NamedIndividual, :FactSheetStatus ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel  "Active"@en ;
    skos:notation   "ACTIVE" ;
    skos:definition "The fact sheet is live in the workspace and can be read and edited."@en ;
    skos:scopeNote  '''IRI carries the Status prefix to keep it distinct from ap:Active, the
lifecycle stage. A fact sheet is :StatusActive because its record is live; the application it
describes is ap:Active because it is in operational use. The two are unrelated.'''@en ;
.

:StatusArchived
    a               owl:NamedIndividual, :FactSheetStatus ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel  "Archived"@en ;
    skos:notation   "ARCHIVED" ;
    skos:definition "The fact sheet has been archived. It remains readable and reportable, but LeanIX refuses updates to it."@en ;
.

:StatusBroken
    a               owl:NamedIndividual, :FactSheetStatus ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/fact-sheets> ;
    skos:prefLabel  "Broken"@en ;
    skos:notation   "BROKEN" ;
    skos:definition "The fact sheet is in an inconsistent state, typically after a failed import or an interrupted change."@en ;
    skos:scopeNote  "Distinct from a broken quality seal, which is a data-governance signal on an otherwise healthy fact sheet."@en ;
.

## Lifecycle — a stage and the date it began ────────────────────
##
## The stages themselves are NOT declared here. ap:Plan, ap:PhaseIn, ap:Active,
## ap:PhaseOut and ap:Retired in the Architecture Processes extension were
## derived from SAP LeanIX's own lifecycle documentation, and each carries a
## skos:closeMatch to the doc anchor it came from — so a converter resolves a
## LeanIX phase token by kebab-casing it ("phaseIn" → #phase-in, "endOfLife" →
## #end-of-life) and matching that anchor. Minting lmm: stages would copy the
## vocabulary the original was lifted from and would cost the cross-notation
## query the reuse buys: "every asset in phase-out" then spans LeanIX, ArchiMate
## and Backstage data in one pattern instead of three.
##
## What LeanIX genuinely adds is the dated phase, which ap: has no construct
## for. Hence one class here and nothing else.

:LifecyclePhase
    a               owl:Class ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/lifecycle> ;
    skos:prefLabel  "Lifecycle Phase"@en ;
    skos:definition "One dated phase of a fact sheet's lifecycle — a lifecycle stage together with the date the subject entered it."@en ;
    skos:scopeNote  '''A node rather than a pair of properties on the fact sheet. Two phases
flattened onto one fact sheet produce two dates with nothing saying which stage each belongs to,
which is exactly the information a roadmap needs.

The stage is carried by ap:atLifecycleStage, the same property that carries the current stage on the
fact sheet itself, so "what stage is this?" reads the same whether asked of a fact sheet or of one of
its phases. A phase has no end date: it ends when the next one starts.'''@en ;
    skos:example    '''<…/element/app-1>
    a                     lmm:Application ;
    ap:atLifecycleStage   ap:Active ;                    # lifecycle.asString
    lmm:hasLifecyclePhase <…/element/app-1/phase/plan>,
                          <…/element/app-1/phase/active> .

<…/element/app-1/phase/active>
    a                   lmm:LifecyclePhase ;
    ap:atLifecycleStage ap:Active ;
    lmm:phaseStart      "2021-04-01"^^xsd:date .'''@en ;
.

:hasLifecyclePhase
    a                   owl:ObjectProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/lifecycle> ;
    skos:prefLabel      "Has Lifecycle Phase"@en ;
    skos:definition     "Relates a fact sheet to one dated phase of its lifecycle."@en ;
    skos:scopeNote      '''Many-valued: a fact sheet carries every phase it has a date for, past and
planned. The phase it is in now is on the fact sheet itself, as ap:atLifecycleStage.'''@en ;
    arch:domainIncludes :FactSheet ;
    arch:rangeIncludes  :LifecyclePhase ;
.

:phaseStart
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/lifecycle> ;
    skos:prefLabel      "Phase Start"@en ;
    skos:definition     "The date the subject entered this lifecycle phase."@en ;
    arch:domainIncludes :LifecyclePhase ;
    rdfs:range          xsd:date ;
.

## Subscriptions — who is responsible, in which role ────────────

:Subscription
    a               owl:Class ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/fact-sheet-subscription> ;
    rdfs:seeAlso    <https://help.sap.com/docs/leanix/ea/managing-fact-sheet-subscriptions> ;
    skos:prefLabel  "Subscription"@en ;
    skos:definition "A person's registered responsibility for a fact sheet, of a given subscription type and covering one or more roles."@en ;
    skos:scopeNote  '''A node rather than properties on the fact sheet, for the same reason as
:LifecyclePhase: two subscribers flattened onto a fact sheet produce two addresses and two types with
nothing pairing them up.

Subscriptions are how LeanIX records data governance — a responsible or accountable subscriber can
edit a fact sheet without breaking its quality seal. Where a converter can identify the accountable
subscriber as a stakeholder in the graph, emitting arch:conceptOwner as well makes that governance
fact answerable without knowing anything about LeanIX.'''@en ;
.

:hasSubscription
    a                   owl:ObjectProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/fact-sheet-subscription> ;
    skos:prefLabel      "Has Subscription"@en ;
    skos:definition     "Relates a fact sheet to a subscription registered against it."@en ;
    arch:domainIncludes :FactSheet ;
    arch:rangeIncludes  :Subscription ;
.

:subscriber
    a                   owl:ObjectProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/fact-sheet-subscription> ;
    skos:prefLabel      "Subscriber"@en ;
    skos:definition     "The person the subscription belongs to."@en ;
    skos:scopeNote      '''Range is arch:Stakeholder, so a subscriber is the same kind of thing here
as a stakeholder identified by any other notation and can be reached by the same queries. Where a
converter has no stable identity to mint a stakeholder from, :subscriberEmail alone is a legitimate
fallback.'''@en ;
    arch:domainIncludes :Subscription ;
    arch:rangeIncludes  arch:Stakeholder ;
.

:subscriberEmail
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/managing-fact-sheet-subscriptions> ;
    skos:prefLabel      "Subscriber Email"@en ;
    skos:definition     "The email address LeanIX holds for the subscriber."@en ;
    skos:scopeNote      '''Retained source data, kept because it is the identity a LeanIX workspace
actually uses. It is not a substitute for :subscriber: an address is not a person, and the same
person can appear under two addresses across systems.'''@en ;
    arch:domainIncludes :Subscription ;
    rdfs:range          xsd:string ;
.

:SubscriptionType
    a               owl:Class ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/fact-sheet-subscription> ;
    rdfs:seeAlso    <https://help.sap.com/docs/leanix/ea/subscription-roles> ;
    skos:prefLabel  "Subscription Type"@en ;
    skos:definition "The level of responsibility a subscription carries: responsible, accountable, or observer."@en ;
    skos:scopeNote  '''Three values, fixed by LeanIX. The *roles* within a type are configured per
workspace and are not this vocabulary — see :subscriptionRole. Named individuals per DD-23, with
membership constrained in shapes rather than closed with owl:oneOf.'''@en ;
.

:subscriptionType
    a                   owl:ObjectProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/fact-sheet-subscription> ;
    skos:prefLabel      "Subscription Type"@en ;
    skos:definition     "The level of responsibility this subscription carries."@en ;
    skos:scopeNote      "At most one value — enforced in shapes, not with owl:FunctionalProperty (DD-23)."@en ;
    arch:domainIncludes :Subscription ;
    arch:rangeIncludes  :SubscriptionType ;
.

:Responsible
    a               owl:NamedIndividual, :SubscriptionType ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/managing-fact-sheet-subscriptions> ;
    skos:prefLabel  "Responsible"@en ;
    skos:notation   "RESPONSIBLE" ;
    skos:definition "The subscriber who keeps the fact sheet's data accurate and up to date — the subject-matter expert for it."@en ;
.

:Accountable
    a               owl:NamedIndividual, :SubscriptionType ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/managing-fact-sheet-subscriptions> ;
    skos:prefLabel  "Accountable"@en ;
    skos:notation   "ACCOUNTABLE" ;
    skos:definition "The subscriber who answers for the fact sheet and its data quality."@en ;
    skos:scopeNote  "The natural source for arch:conceptOwner where the subscriber is modelled as a stakeholder."@en ;
.

:Observer
    a               owl:NamedIndividual, :SubscriptionType ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/managing-fact-sheet-subscriptions> ;
    skos:prefLabel  "Observer"@en ;
    skos:notation   "OBSERVER" ;
    skos:definition "A subscriber who follows the fact sheet without responsibility for its data."@en ;
.

:subscriptionRole
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/subscription-roles> ;
    skos:prefLabel      "Subscription Role"@en ;
    skos:definition     "The name of a role the subscription covers, such as Application Owner or Technical Lead."@en ;
    skos:scopeNote      '''A string rather than a vocabulary, and deliberately so: subscription roles
are defined per workspace, and a role can be scoped to one subscription type or to all of them. There
is no set to enumerate. Many-valued — one subscription can cover several roles.'''@en ;
    arch:domainIncludes :Subscription ;
    rdfs:range          xsd:string ;
.

## Tags ─────────────────────────────────────────────────────────

:Tag
    a               owl:Class ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/tags> ;
    skos:prefLabel  "Tag"@en ;
    skos:definition "A LeanIX tag applied to a fact sheet, in the tag group that scopes it."@en ;
    skos:scopeNote  '''A node because the group is what makes the name mean anything: "Cloud" in a
Hosting group and "Cloud" in a Strategy group are different tags, and a bare name loses that.

The tag's own identifier belongs on this node as skos:notation, the same term a fact sheet's id uses.
A tag with no group is normal — LeanIX allows ungrouped tags — so :tagGroup is optional.'''@en ;
.

:hasTag
    a                   owl:ObjectProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/tags> ;
    skos:prefLabel      "Has Tag"@en ;
    skos:definition     "Relates a fact sheet to a tag applied to it."@en ;
    arch:domainIncludes :FactSheet ;
    arch:rangeIncludes  :Tag ;
.

:tagName
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/tags> ;
    skos:prefLabel      "Tag Name"@en ;
    skos:definition     "The tag's name, as the workspace writes it."@en ;
    skos:scopeNote      '''Held here rather than on a general-purpose keyword property because this
project publishes none. If a cross-notation keyword term is added to core, this becomes a
sub-property of it and a converter's output does not have to change.'''@en ;
    arch:domainIncludes :Tag ;
    rdfs:range          xsd:string ;
.

:tagGroup
    a                   owl:DatatypeProperty ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/tags> ;
    skos:prefLabel      "Tag Group"@en ;
    skos:definition     "The name of the tag group that scopes the tag."@en ;
    skos:scopeNote      "Optional: LeanIX permits tags outside any group."@en ;
    arch:domainIncludes :Tag ;
    rdfs:range          xsd:string ;
.
