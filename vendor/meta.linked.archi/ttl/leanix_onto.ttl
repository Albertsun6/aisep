    skos:definition      "An organization owns strategic, business or technical assets; a team can own a microservice."@en ;
    skos:scopeNote       "Organization → Objective, Initiative, Business Context, IT Component. Optional: Team → Microservice."@en ;
.

:qualifiedOwns
    a                    owl:ObjectProperty ;
    skos:prefLabel       "qualified owns"@en ;
    skos:definition      "Links the source of a Owns relationship to its relationship resource."@en ;
    rdfs:range           :Owns ;
    arch:unqualifiedForm :owns ;
.

## affects — Initiative → Platform, Initiative → Application, Initiative → Business Context, Initiative → Data Object, Initiative → Interface, Initiative → IT Component, Initiative → Tech Category, Initiative → System

:affects
    a                    owl:ObjectProperty ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Affects"@en ;
    skos:definition      "An initiative affects a fact sheet it changes: a platform, an application, a business context, a data object, an interface, an IT component, a tech category."@en ;
    arch:domainIncludes  :Initiative ;
    arch:rangeIncludes   :Platform, :Application, :BusinessContext, :DataObject, :Interface, :ITComponent, :TechCategory, :System ;
.

