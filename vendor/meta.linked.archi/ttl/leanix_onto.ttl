    a                    owl:Class ;
    rdfs:subClassOf      arch:QualifiedRelationship ;
    arch:unqualifiedForm :affects ;
    dcterms:source       <https://help.sap.com/docs/leanix/ea/meta-model> ;
    skos:prefLabel       "Affects"@en ;
    skos:definition      "An initiative affects a fact sheet it changes: a platform, an application, a business context, a data object, an interface, an IT component, a tech category."@en ;
    skos:scopeNote       "Between Initiative → Platform; Initiative → Application; Initiative → Business Context; Initiative → Data Object; Initiative → Interface; Initiative → IT Component; Initiative → Tech Category. Optional in Meta Model v4: Initiative → System, ESG Capability (through Business Context)."@en ;
.

:qualifiedAffects
    a                    owl:ObjectProperty ;
    skos:prefLabel       "qualified affects"@en ;
    skos:definition      "Links the source of a Affects relationship to its relationship resource."@en ;
    rdfs:range           :Affects ;
