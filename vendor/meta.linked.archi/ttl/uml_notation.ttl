        arch-vis:lineColor     "#000000" ;
        arch-vis:renderingMode arch-vis:ShapeWithBadge ;
        arch-vis:iconSymbol    "https://meta.linked.archi/uml/icons/glyphs/package.svg"^^xsd:anyURI ;
        arch-vis:iconPlacement arch-vis:TopLeft ;
