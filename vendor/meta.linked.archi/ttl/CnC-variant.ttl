      '''@en ;
    dcterms:created               "2021-05-05"^^xsd:date ;
    dcterms:issued                "2021-05-05"^^xsd:date ;
    dcterms:modified              "2021-05-05"^^xsd:date ;
    dcterms:publisher                  "https://linked.archi",
                                  "Linked.Archi"@en ;
