@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix archvp:  <https://meta.linked.archi/core-viewpoints#> .
@prefix bpmnvp:  <https://meta.linked.archi/bpmn/viewpoints#> .
@prefix :        <https://meta.linked.archi/bpmn/metamodel#> .

#################################################################
# Ontology Declaration
#################################################################

<https://meta.linked.archi/bpmn/metamodel#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/bpmn/metamodel#" ;
    vann:preferredNamespacePrefix "bpmnmm" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi BPMN Metamodel Definition"@en ;
    dcterms:description                '''Metamodel manifest for BPMN 2.0.2. Ties together the BPMN
element/relationship ontologies, SHACL shapes, alignment axioms, and diagram
interchange modules into a single discoverable resource. Derived from the
OMG BPMN 2.0.2 specification XMI.'''@en ;
    dcterms:created               "2026-04-16"^^xsd:date ;
    dcterms:modified              "2026-09-05"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    owl:versionIRI                <https://meta.linked.archi/bpmn/metamodel/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:source  <https://www.omg.org/spec/BPMN/2.0.2/> ;
    prov:wasDerivedFrom <https://www.omg.org/spec/BPMN/2.0.2/> ;
    rdfs:seeAlso                  <https://www.omg.org/spec/BPMN/2.0.2/> ;
.


#################################################################
# BPMN Framework Individual
#################################################################

:BPMNFramework
    a               arch:Framework ;
    skos:prefLabel  "BPMN"@en ;
    skos:definition '''Business Process Model and Notation (BPMN) — the OMG standard for
graphical notation of business processes. Provides constructs for modeling
processes, collaborations, choreographies, and conversations.'''@en ;
    skos:scopeNote  '''The language, not a release: the label deliberately carries no version.
The release is the arch:Metamodel individual :BPMN2, which declares
owl:versionInfo "2.0.2".

This is the single arch:Framework IRI for the BPMN family, and the BPMN Lite profile
points at it too — bpmn-lite/metamodel#BPMNLite is a thinner reading of the same language,
not a different one, so arch:basedOnFramework selects both in one hop. BPMN Lite used to
mint its own :BPMNFramework in its own namespace; that IRI is now deprecated with an
owl:sameAs back here.'''@en ;
    dcterms:publisher    "Object Management Group (OMG)" ;
    rdfs:seeAlso    <https://www.omg.org/spec/BPMN/2.0.2/>,
                    <https://www.omg.org/spec/BPMN/> ;
.


#################################################################
# BPMN Metamodel Instance
#################################################################

:BPMN2
    a                             arch:Metamodel ;
    skos:prefLabel                "BPMN 2.0.2 Metamodel"@en ;
    dcterms:description               '''The complete BPMN 2.0.2 metamodel definition, aggregating the
element/relationship ontologies (BPMN core, infrastructure, diagram interchange,
diagram common, diagram interchange base), SHACL shapes, and alignment axioms.
Auto-generated from the OMG BPMN 2.0.2 XMI; taxonomy, viewpoints, deliverable
templates, reference data, and presentation contexts can be added later.'''@en ;

    ## Foundation — the language, not this release
    arch:basedOnFramework         :BPMNFramework ;
    owl:versionInfo               "2.0.2" ;

    ## Model concepts — element/relationship ontologies
    ## File: linkedarchi-bpmn-onto.ttl
    arch:modelConcepts            <https://meta.linked.archi/bpmn/onto#> ;
    ## File: linkedarchi-bpmn-infra-onto.ttl
    arch:modelConcepts            <https://meta.linked.archi/bpmn/infra#> ;
    ## File: linkedarchi-bpmndi-onto.ttl
    arch:modelConcepts            <https://meta.linked.archi/bpmn/di#> ;
    ## File: linkedarchi-di-onto.ttl
    arch:modelConcepts            <https://meta.linked.archi/bpmn/di-core#> ;
    ## File: linkedarchi-dc-onto.ttl
    arch:modelConcepts            <https://meta.linked.archi/bpmn/dc#> ;

    ## Formal rules — SHACL shapes and alignment
    ## File: linkedarchi-bpmn-shacl.ttl
    arch:formalRules              <https://meta.linked.archi/bpmn/onto-shapes#> ;
    ## File: linkedarchi-bpmn-infra-shacl.ttl
    arch:formalRules              <https://meta.linked.archi/bpmn/infra-shapes#> ;
    ## File: linkedarchi-bpmndi-shacl.ttl
    arch:formalRules              <https://meta.linked.archi/bpmn/di-shapes#> ;
    ## File: linkedarchi-di-shacl.ttl
    arch:formalRules              <https://meta.linked.archi/bpmn/di-core-shapes#> ;
    ## File: linkedarchi-dc-shacl.ttl
    arch:formalRules              <https://meta.linked.archi/bpmn/dc-shapes#> ;
    ## Deliberately NOT linkedarchi-bpmn-suite-shapes.ttl. That document is an imports-only
    ## aggregate: it declares no shape of its own, and SHACL processors do not dereference
    ## owl:imports, so loading it alone validates nothing.
    ## The five documents above are the shapes. The aggregate serves owl:imports-aware tooling,
    ## and a consumer checking that each declared shapes namespace resolves to at least one
    ## shape would find none under bpmn/suite-shapes.

    ## Cross-language mappings — BPMN ↔ ArchiMate 3.2, BPMN ↔ ArchiMate 4.0
    ## File: bpmn-crossmappings.ttl
    arch:crossLanguageMappings    <https://meta.linked.archi/bpmn/crossmappings#> ;

    ## Viewpoints
    ## File: bpmn-viewpoints.ttl
    arch:architectureViewpoints   <https://meta.linked.archi/bpmn/viewpoints#> ;

    ## Viewpoint library
    ## File: bpmn-viewpoints.ttl
    arch:viewpointLibrary         bpmnvp:ViewpointCatalog ;

    ## Concept classification — SKOS taxonomy (by BPMN category)
    ## File: bpmn-tax.ttl
    arch:conceptClassification    <https://meta.linked.archi/bpmn/tax#> ;
    arch:paletteGrouping          <https://meta.linked.archi/bpmn/tax#PaletteGrouping> ;

    ## Visual notation set — default element/relationship appearance
    ## File: bpmn-notation.ttl
    arch:notationSet              <https://meta.linked.archi/bpmn/notation#BPMNStandardNotation> ;

    ## Deliverable templates
    ## File: bpmn-deliverable-templates.ttl
    arch:hasDeliverableTemplate   <https://meta.linked.archi/bpmn/deliverable-templates#ProcessDocumentation> ;

    ## Stakeholders (referencing core viewpoint individuals)
    arch:metamodelIdentifiesStakeholder
        archvp:ProcessOwner,
        archvp:BusinessArchitect,
        archvp:SolutionArchitect,
        archvp:SoftwareDeveloper ;

    ## Concerns (referencing core viewpoint individuals)
    arch:metamodelIdentifiesConsideration
        archvp:BehaviorConcern,
        archvp:StructureConcern,
        archvp:IntegrationConcern ;
.
