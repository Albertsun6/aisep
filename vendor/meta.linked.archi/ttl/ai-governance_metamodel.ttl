@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix aigov:   <https://meta.linked.archi/ai-governance/onto#> .
@prefix aigovtax: <https://meta.linked.archi/ai-governance/tax#> .
@prefix mlsys:   <https://meta.linked.archi/ml-systems/onto#> .
@prefix :        <https://meta.linked.archi/ai-governance/metamodel#> .

<https://meta.linked.archi/ai-governance/metamodel#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/ai-governance/metamodel#" ;
    vann:preferredNamespacePrefix "aigovmm" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi AI Ethics & Governance Metamodel Definition"@en ;
    dcterms:description                '''Metamodel manifest for the AI Ethics & Governance extension.
Ties together the AI governance ontology, SKOS taxonomy, SHACL shapes, and
reference data into a single discoverable resource.

This is the entry point for tools that need to discover all resources that
make up the AI Ethics & Governance modeling vocabulary.

Designed to compose with the ML-Enabled Systems extension — the ML extension
provides the technical layer (models, pipelines, serving), while this extension
provides the governance layer (risk classification, conformity assessment,
bias assessment, human oversight).'''@en ;
    dcterms:created               "2026-05-03"^^xsd:date ;
    dcterms:modified              "2026-05-03"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/ai-governance/metamodel/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    rdfs:seeAlso                  <https://eur-lex.europa.eu/eli/reg/2024/1689/oj>,
                                  <https://oecd.ai/en/ai-principles>,
                                  <https://www.nist.gov/itl/ai-risk-management-framework>,
                                  <https://www.iso.org/standard/81230.html> ;
.


#################################################################
# Metamodel Instance
#################################################################

:AIEthicsAndGovernance
    a                             arch:Metamodel ;
    skos:prefLabel                "AI Ethics & Governance Metamodel"@en ;
    dcterms:description               '''The AI Ethics & Governance metamodel definition, aggregating the
AI governance ontology, SKOS taxonomy, SHACL shapes, and reference data.
Designed to be composed with the ML-Enabled Systems metamodel and other
metamodels (ArchiMate, C4, Backstage) via owl:imports to add AI governance
capabilities to any architecture description.

Addresses the gap identified by Gartner 2025 Leadership Vision: EA teams
lack AI ethics and governance frameworks. Provides formal ontology resources
for EU AI Act compliance, OECD AI Principles, and organizational AI
governance policies.'''@en ;

    ## Model concepts — AI governance elements, properties, viewpoints
    arch:modelConcepts            <https://meta.linked.archi/ai-governance/onto#> ;

    ## Concept classification — SKOS taxonomy; and that of the ML-Enabled Systems
    ## element types the ontology imports, so they keep their groups here
    arch:conceptClassification    <https://meta.linked.archi/ai-governance/tax#>,
                                  <https://meta.linked.archi/ml-systems/tax#> ;

    ## Formal rules — SHACL shapes for AI governance validation
    arch:formalRules              <https://meta.linked.archi/ai-governance/shapes#> ;

    ## Reference data — EU AI Act risk levels, OECD principles, oversight modes
    arch:referenceData            <https://meta.linked.archi/ai-governance/reference-data#> ;

    ## Concerns identified by this metamodel
    arch:metamodelIdentifiesConsideration
        aigov:RegulatoryComplianceConcern, aigov:AIAccountabilityConcern,
        aigov:AITransparencyConcern, aigov:HumanOversightConcern ;

    ## This metamodel extends the ML Systems metamodel
    rdfs:seeAlso                  <https://meta.linked.archi/ml-systems/metamodel#> ;
.
