@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix bpmnl:   <https://meta.linked.archi/bpmn-lite/onto#> .
@prefix :        <https://meta.linked.archi/bpmn-lite/shapes#> .

#################################################################
# Shapes Graph Declaration
#
# Scope note — naming
#
# These shapes are the authoritative naming rule for BPMN Lite. core-shapes
# carries no label shape, because arch:Element means "a node in a model" and some
# notations have nodes that are legitimately unnamed. Naming policy is
# notation-owned; see DD-24 in doc/guide/design-decisions.md.
#
# skos:prefLabel is the canonical Linked.Archi label and MUST carry a language
# tag: "Order fulfillment"@en, not "Order fulfillment".
#
# Required to be named: Process, SubProcess, Task (and its 6 subtypes),
# CallActivity, Participant, Lane, DataObject, DataStore, Message.
#
# NOT required, though they ARE arch:Element: bpmnl:Gateway and bpmnl:Event with
# all their subtypes. Gateways and events are nodes in the process graph — they
# have identity and render on diagrams — but BPMN 2.0.2 makes their name optional
# and modellers routinely leave it off. GatewayShape below therefore asserts only
# sh:maxCount 1 on the label, never sh:minCount. This matches the full BPMN suite,
# where bpmnsh:RequiredNameShape likewise omits them.
#
# Do not target arch:Element from this file. In a merged multi-notation graph that
# would apply BPMN Lite's naming policy to every other notation's elements.
#
# Unlike the full BPMN suite, BPMN Lite has no notation-native name property to
# retain — the profile deliberately drops serialization detail and points back to
# the source .bpmn file via bpmnl:sourceRef. skos:prefLabel is therefore the only
# label here, and there is nothing to mirror.
#
# These shapes previously constrained `arch:name`, a property declared nowhere in
# this repository, as a plain xsd:string. Converters following them emitted an
# undefined property no Linked.Archi tooling reads.
#################################################################

<https://meta.linked.archi/bpmn-lite/shapes#>
    a owl:Ontology ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/bpmn-lite/shapes#" ;
    vann:preferredNamespacePrefix "bpmnls" ;
    dcterms:title                      "Linked.Archi BPMN Lite SHACL Shapes"@en ;
    dcterms:description                "SHACL validation shapes for the BPMN Lite ontology."@en ;
    dcterms:created               "2026-05-06"^^xsd:date ;
    dcterms:modified              "2026-08-04"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string .


#################################################################
# Process Shape
#################################################################

:ProcessShape a sh:NodeShape ;
    sh:targetClass bpmnl:Process ;
    skos:prefLabel "Process Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A Process must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.

:SubProcessShape a sh:NodeShape ;
    sh:targetClass bpmnl:SubProcess ;
    skos:prefLabel "SubProcess Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A SubProcess must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.


#################################################################
# Task Shapes
#################################################################

:TaskShape a sh:NodeShape ;
    sh:targetClass bpmnl:Task ;
    skos:prefLabel "Task Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A Task must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.

## CallActivity is a direct arch:Element root here, not a bpmnl:Task subclass,
## so TaskShape above does not reach it.
:CallActivityShape a sh:NodeShape ;
    sh:targetClass bpmnl:CallActivity ;
    skos:prefLabel "Call Activity Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A CallActivity must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.


#################################################################
# Event Shapes
#################################################################

:EventShape a sh:NodeShape ;
    sh:targetClass bpmnl:Event ;
    skos:prefLabel "Event Shape"@en ;
    sh:property [
        sh:path bpmnl:eventType ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "eventType" ;
        sh:in ( "none" "timer" "message" "signal" "error" "escalation" "cancel" "compensate" "conditional" "link" "terminate" ) ;
        sh:message "eventType must be one of: none, timer, message, signal, error, escalation, cancel, compensate, conditional, link, terminate." ;
    ] ;
.

:StartEventShape a sh:NodeShape ;
    sh:targetClass bpmnl:StartEvent ;
    skos:prefLabel "Start Event Shape"@en ;
    sh:property [
        sh:path bpmnl:eventType ;
        sh:in ( "none" "timer" "message" "signal" "conditional" ) ;
        sh:message "A StartEvent eventType must be one of: none, timer, message, signal, conditional." ;
    ] ;
.

:EndEventShape a sh:NodeShape ;
    sh:targetClass bpmnl:EndEvent ;
    skos:prefLabel "End Event Shape"@en ;
    sh:property [
        sh:path bpmnl:eventType ;
        sh:in ( "none" "message" "signal" "error" "escalation" "cancel" "compensate" "terminate" ) ;
        sh:message "An EndEvent eventType must be one of: none, message, signal, error, escalation, cancel, compensate, terminate." ;
    ] ;
.

:BoundaryEventShape a sh:NodeShape ;
    sh:targetClass bpmnl:BoundaryEvent ;
    skos:prefLabel "Boundary Event Shape"@en ;
    sh:property [
        sh:path bpmnl:eventType ;
        sh:minCount 1 ;
        sh:message "A BoundaryEvent must specify an eventType." ;
    ] ;
    sh:property [
        sh:path bpmnl:isInterrupting ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:name "isInterrupting" ;
    ] ;
.


#################################################################
# Gateway Shapes
#################################################################

:GatewayShape a sh:NodeShape ;
    sh:targetClass bpmnl:Gateway ;
    skos:prefLabel "Gateway Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
    ] ;
.


#################################################################
# Participant / Lane Shapes
#################################################################

:ParticipantShape a sh:NodeShape ;
    sh:targetClass bpmnl:Participant ;
    skos:prefLabel "Participant Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A Participant must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.

:LaneShape a sh:NodeShape ;
    sh:targetClass bpmnl:Lane ;
    skos:prefLabel "Lane Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A Lane must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.


#################################################################
# Data Shapes
#################################################################

:DataObjectShape a sh:NodeShape ;
    sh:targetClass bpmnl:DataObject ;
    skos:prefLabel "Data Object Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A DataObject must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.

:DataStoreShape a sh:NodeShape ;
    sh:targetClass bpmnl:DataStore ;
    skos:prefLabel "Data Store Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A DataStore must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.

:MessageShape a sh:NodeShape ;
    sh:targetClass bpmnl:Message ;
    skos:prefLabel "Message Shape"@en ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "prefLabel" ;
        sh:message "A Message must have a language-tagged skos:prefLabel (rdf:langString)." ;
    ] ;
.


#################################################################
# Relationship Shapes
#################################################################

:SequenceFlowShape a sh:NodeShape ;
    sh:targetClass bpmnl:SequenceFlow ;
    skos:prefLabel "Sequence Flow Shape"@en ;
    sh:property [
        sh:path arch:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "source" ;
        sh:message "A SequenceFlow must have exactly one source." ;
    ] ;
    sh:property [
        sh:path arch:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "target" ;
        sh:message "A SequenceFlow must have exactly one target." ;
    ] ;
    sh:property [
        sh:path bpmnl:condition ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "condition" ;
    ] ;
.

:MessageFlowShape a sh:NodeShape ;
    sh:targetClass bpmnl:MessageFlow ;
    skos:prefLabel "Message Flow Shape"@en ;
    sh:property [
        sh:path arch:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "source" ;
        sh:message "A MessageFlow must have exactly one source." ;
    ] ;
    sh:property [
        sh:path arch:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "target" ;
        sh:message "A MessageFlow must have exactly one target." ;
    ] ;
.

:DataAssociationShape a sh:NodeShape ;
    sh:targetClass bpmnl:DataAssociation ;
    skos:prefLabel "Data Association Shape"@en ;
    sh:property [
        sh:path arch:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "source" ;
        sh:message "A DataAssociation must have exactly one source." ;
    ] ;
    sh:property [
        sh:path arch:target ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "target" ;
        sh:message "A DataAssociation must have exactly one target." ;
    ] ;
.

