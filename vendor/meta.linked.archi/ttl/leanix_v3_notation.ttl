@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix cc:       <http://creativecommons.org/ns#> .
@prefix vann:     <http://purl.org/vocab/vann/> .

@prefix arch:     <https://meta.linked.archi/core#> .
@prefix arch-vis: <https://meta.linked.archi/core-vis#> .
@prefix lmm3:     <https://meta.linked.archi/leanix/v3/onto#> .
@prefix :         <https://meta.linked.archi/leanix/v3/notation#> .

<https://meta.linked.archi/leanix/v3/notation#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-vis#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/leanix/v3/notation#" ;
    vann:preferredNamespacePrefix "lmm3not" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi LeanIX Meta Model v3 Visual Notation Set"@en ;
    dcterms:description           "Visual notation descriptors for LeanIX Meta Model v3 fact sheet types."@en ;
    dcterms:created               "2026-11-16"^^xsd:date ;
    dcterms:modified              "2026-11-16"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:source  <https://help.sap.com/docs/leanix/ea/meta-model> ;
    prov:wasDerivedFrom <https://help.sap.com/docs/leanix/ea/meta-model> ;
    rdfs:seeAlso    <https://help.sap.com/docs/leanix/ea/meta-model>,
                    <https://help.sap.com/docs/leanix/ea/modeling-guidelines-v3> ;
    skos:editorialNote '''SAP LeanIX does not publish a formal visual notation specification.
Each v3 fact sheet type is drawn as the Meta Model v4 type that took its place is in
leanix/notation#: User Group as Organization, Project as Initiative, Process and Product as
Business Context, Tech Platform as Platform, and the types the two versions share as themselves.'''@en .


#################################################################
# Notation Set
#################################################################

:LeanIXv3StandardNotation
    a               arch-vis:NotationSet ;
    skos:prefLabel  "LeanIX Meta Model v3 Standard Notation"@en ;
    skos:definition "Standard visual notation for LeanIX Meta Model v3 fact sheet types."@en .


#################################################################
# Strategy & Transformation
#################################################################

:ProjectNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor lmm3:Project ;
    arch-vis:inNotationSet :LeanIXv3StandardNotation ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:shapeType     arch-vis:RoundedRectangle ;
        arch-vis:fillColor     "#E8EAF6" ;
        arch-vis:lineColor     "#283593" ;
        arch-vis:renderingMode arch-vis:ShapeWithBadge ;
        arch-vis:iconSymbol    "https://meta.linked.archi/leanix/icons/glyphs/initiative.svg"^^xsd:anyURI ;
        arch-vis:iconPlacement arch-vis:TopRight ;
        arch-vis:defaultWidth  "120.0"^^xsd:double ;
        arch-vis:defaultHeight "55.0"^^xsd:double ;
    ] .


