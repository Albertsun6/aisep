@prefix amate:    <https://meta.linked.archi/archimate3/onto#> .
@prefix :         <https://meta.linked.archi/archimate3/tax/3.0#> .


<https://meta.linked.archi/archimate3/tax/3.0#>
    a                             skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate3/tax/3.0#" ;
    vann:preferredNamespacePrefix "amtax30" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi ArchiMate 3.0 Taxonomy"@en ;
    dcterms:description                '''SKOS taxonomy classifying ArchiMate 3.0 elements by layer and aspect,
and relationship types by category.'''@en ;
    dcterms:created               "2019-03-17"^^xsd:date ;
    dcterms:modified              "2019-03-17"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    owl:versionInfo               "3.0"@en ;
    skos:prefLabel                "ArchiMate 3.0 Concept Scheme"@en ;
    skos:hasTopConcept            :ArchimateConcept ;
.

#################################################################
# Top-level concepts
#################################################################

:ArchimateConcept a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Archimate Concept"@en ;
.

:ArchimateElement a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "ArchimateElement"@en ;
    skos:broader   :ArchimateConcept ;
.

:ArchimateRelationship a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "ArchimateRelationship"@en ;
    skos:broader   :ArchimateConcept ;
.

#################################################################
# Relationship categories
#################################################################

:StructuralRelationship a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Structural Relationship"@en ;
    skos:broader   :ArchimateRelationship ;
    skos:narrower  amate:Realization ;
    skos:narrower  amate:Assignment ;
    skos:narrower  amate:Aggregation ;
    skos:narrower  amate:Composition ;
.

:DependencyRelationship a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Dependency Relationship"@en ;
    skos:broader   :ArchimateRelationship ;
    skos:narrower  amate:Influence ;
    skos:narrower  amate:Access ;
    skos:narrower  amate:Serving ;
.

:DynamicRelationship a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Dynamic Relationship"@en ;
    skos:broader   :ArchimateRelationship ;
    skos:narrower  amate:Triggering ;
    skos:narrower  amate:Flow ;
.

:OtherRelationship a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Other Relationship"@en ;
    skos:broader   :ArchimateRelationship ;
    skos:narrower  amate:Specialization ;
    skos:narrower  amate:Association ;
.

:ArchimateRelationshipConnector a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Relationship Connector"@en ;
    skos:broader   :ArchimateConcept ;
    skos:narrower  amate:Junction_And ;
    skos:narrower  amate:Junction_Or ;
.

#################################################################
# Classification by Layer
#################################################################

:ArchimateElementByLayer a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "ArchiMate Element by Layer"@en ;
    skos:broader   :ArchimateElement ;
.

:LayerOrder
    a                      skos:OrderedCollection, iso-thes:ThesaurusArray ;
    skos:prefLabel         "Layers in Order"@en ;
    skos:definition        "The layers of ArchiMate 3.0 in order: business, application, technology, physical, strategy, and implementation and migration."@en ;
    skos:scopeNote         "Linked.Archi modelling guidance, not the specification. A tool that lists the layers, as a palette lists its sections, lists them in this order."@en ;
    skos:editorialNote     '''An ISO 25964 thesaurus array (http://purl.org/iso25964/skos-thes#): the order of the
layers, kept apart from their classification.
• A collection is not a concept. A skos:Collection or skos:OrderedCollection groups concepts and can put them in
  order, but it has no place in the concept hierarchy: it takes no skos:broader, is no top concept of a scheme,
  and SKOS has no property that says whose narrower concepts it lists.
• The array gives it that place. iso-thes:ThesaurusArray, a kind of skos:Collection, is a group of sibling
  concepts, and iso-thes:superOrdinate attaches it under the concept they are narrower than, here :ArchimateElementByLayer.
• Each keeps one job. The classification stays in skos:broader, each layer narrower than :ArchimateElementByLayer, and
  holds for a tool that never reads this array. The array adds only the order, in skos:memberList:
  iso-thes:ThesaurusArray is unordered, so the order comes from skos:OrderedCollection.
• The two stay in step. The array lists each concept narrower than :ArchimateElementByLayer once and nothing else; the CI
  run checks it.'''@en ;
    iso-thes:superOrdinate :ArchimateElementByLayer ;
    skos:memberList        ( :BusinessLayer :ApplicationLayer :TechnologyLayer :PhysicalLayer
                             :StrategyLayer :ImplementationAndMigrationLayer ) ;
.

:StrategyLayer a skos:Concept ;
    skos:inScheme  <https://meta.linked.archi/archimate3/tax/3.0#> ;
    skos:prefLabel "Strategy Layer"@en ;
    skos:broader   :ArchimateElementByLayer ;
    skos:narrower  amate:Resource ;
    skos:narrower  amate:Capability ;
    skos:narrower  amate:CourseOfAction ;
.

