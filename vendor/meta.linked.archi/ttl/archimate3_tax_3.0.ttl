#################################################################
# Palette grouping and diagram group order
#
# Linked.Archi modelling guidance, not the specification: the
# classification dimensions a palette groups element types by, and
# the groups a diagram keeps in bands, top band first. A metamodel
# manifest points to them (arch:paletteGrouping,
# arch:diagramGroupOrder).
#################################################################

:PaletteGrouping
    a               skos:OrderedCollection ;
    skos:prefLabel  "Palette Grouping"@en ;
    skos:definition "The classification dimensions a palette groups element types by: a section for each layer, in the order of :LayerOrder, its element types in the order of their aspects, :AspectOrder; motivation elements, grouping and location, of no layer, in the section of their aspect."@en ;
    skos:memberList ( :ArchimateElementByLayer :ArchimateElementByAspect ) ;
.

:DiagramGroupOrder
    a               skos:OrderedCollection ;
    skos:prefLabel  "Diagram Group Order"@en ;
    skos:definition "The groups a diagram keeps in bands, top band first: motivation, strategy, business, application, technology, physical, and implementation and migration."@en ;
    skos:scopeNote  "Motivation is an aspect in ArchiMate 3.0, not a layer; its group is listed first so that motivation elements are drawn above the layers."@en ;
    skos:memberList ( :MotivationElement :StrategyLayer :BusinessLayer :ApplicationLayer :TechnologyLayer
                      :PhysicalLayer :ImplementationAndMigrationLayer ) ;
.
