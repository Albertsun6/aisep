<https://meta.linked.archi/basic> a dcat:Dataset;
  dcterms:title "Linked.Archi Basic Ontology"@en;
  dcterms:description """Concept ontology of the Linked.Archi Basic asset set: three element
types (Node, SpecialNode, GroupNode) and three qualified relationship types (Association,
Aggregation, Connection), built directly on the core ontology. It is deliberately small, yet
enough for examples of meaningful restrictions and inference rules. Connection is the generic
relationship among Basic's elements: it relates any two of them. Between a Basic element and an
element of another language, the core's relationship types are used. The manifest
https://meta.linked.archi/basic/metamodel#Basic ties it to its taxonomy, its presentation
contexts and its two notation sets. Version 0.1.0 is the initial release of these element and
relationship patterns."""@en;
  dcterms:conformsTo owl:Ontology;
  vann:preferredNamespaceUri "https://meta.linked.archi/basic#";
  vann:preferredNamespacePrefix "basic";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-10-05"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#languages>;
  dcat:keyword "Basic"@en;
  dcat:landingPage <https://meta.linked.archi/basic/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/basic/ontology.jsonld>;
      dcat:downloadURL <https://meta.linked.archi/basic/ontology.jsonld>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/ld+json>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/basic/ontology.nt>;
      dcat:downloadURL <https://meta.linked.archi/basic/ontology.nt>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/n-triples>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/basic/ontology.owl>;
      dcat:downloadURL <https://meta.linked.archi/basic/ontology.owl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/rdf+xml>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/basic/ontology.ttl>;
