      dcat:mediaType <http://www.iana.org/assignments/media-types/application/ld+json>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/archimate4/onto/ontology.nt>;
      dcat:downloadURL <https://meta.linked.archi/archimate4/onto/ontology.nt>;
