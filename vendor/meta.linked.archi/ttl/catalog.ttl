  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#languages>;
  dcat:keyword "ArchiMate 3.2"@en;
  dcat:landingPage <https://meta.linked.archi/archimate3/element-shapes/>;
  dcat:distribution [ a dcat:Distribution;
