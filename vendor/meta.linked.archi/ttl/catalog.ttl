<https://meta.linked.archi/leanix/shapes> a dcat:Dataset;
  dcterms:title "Linked.Archi LeanIX SHACL Shapes"@en;
  dcterms:description """SHACL shapes for validating SAP LeanIX Meta Model fact sheet data.
Covers both published LeanIX ontologies — v4 (lmm:) and v3 (lmm3:) — because both are live
namespaces rooted at FactSheet.

Fact sheet naming applies to both versions. Value-set and cardinality rules constrain v4
attributes (DD-23), while endpoint shapes constrain v4 relationship pairs. The ontology
deliberately does not close the attribute vocabularies in OWL.

This is not an official SAP document."""@en;
  dcterms:conformsTo <http://www.w3.org/ns/shacl#>;
  vann:preferredNamespaceUri "https://meta.linked.archi/leanix/shapes#";
  vann:preferredNamespacePrefix "lmmsh";
  owl:versionInfo "0.3.0";
  dcterms:modified "2026-11-16"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
