      dcat:accessURL <https://meta.linked.archi/bpmn-lite/metamodel/bpmn-lite-metamodel.ttl>;
      dcat:downloadURL <https://meta.linked.archi/bpmn-lite/metamodel/bpmn-lite-metamodel.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ];
  foaf:primaryTopic <https://meta.linked.archi/bpmn-lite/metamodel#BPMNLite> .

