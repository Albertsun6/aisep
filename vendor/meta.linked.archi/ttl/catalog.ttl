<https://meta.linked.archi/archimate4/viewpoints> a dcat:Dataset;
  dcterms:title "Linked.Archi ArchiMate 4.0 Viewpoints"@en;
  dcterms:description """The ArchiMate 4.0 example viewpoints of Appendix C as arch:Viewpoint
individuals. Each states the elements it admits
(arch:includesConcept — Grouping and the two junctions in every one, as the specification allows),
its stakeholders (arch:targetsStakeholder), the concerns it frames (arch:viewpointFramesConcern)
and its purposes (arch:viewpointHasPurpose). The catalogue groups them twice, as SKOS: by the
specification's categories and by the scope its tables state (how many domains and aspects a
viewpoint spans). The specification calls them examples, not a normative or exhaustive list;
organizations may define their own."""@en;
  dcterms:conformsTo arch:Viewpoint;
  vann:preferredNamespaceUri "https://meta.linked.archi/archimate4/viewpoints#";
  vann:preferredNamespacePrefix "am4vp";
