<https://meta.linked.archi/zachman/tax> a dcat:Dataset;
  dcterms:title "Linked.Archi Zachman Framework Taxonomy"@en;
  dcterms:description """Classification of enterprise architecture descriptions using the Zachman
Framework 6x6 matrix. Organizes concepts into five families: Aspect (the six
columns representing what question is being answered), Perspective (the six rows
representing at what level of reification and for which audience), Cell (the
36 intersections, each classifying a primitive descriptive representation),
Enterprise Type (the category of enterprise description produced by each column),
and Model Type (the category of model produced by each row)."""@en;
  dcterms:conformsTo skos:ConceptScheme;
  vann:preferredNamespaceUri "https://meta.linked.archi/zachman/tax#";
  vann:preferredNamespacePrefix "zachtax";
  owl:versionInfo "0.3.0";
  dcterms:modified "2026-02-17"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#frameworks>;
  dcat:keyword "Zachman Framework"@en;
  dcat:landingPage <https://meta.linked.archi/zachman/tax/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/zachman/tax/zachman-tax.ttl>;
      dcat:downloadURL <https://meta.linked.archi/zachman/tax/zachman-tax.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

<https://meta.linked.archi/zachman/viewpoints> a dcat:Dataset;
  dcterms:title "Zachman Framework Viewpoints"@en;
  dcterms:description """Viewpoint definitions for the Zachman Framework. Declares the six
Aspects as arch:Aspect individuals, the six Perspectives as arch:Perspective
individuals, and 36 viewpoints — one per Zachman Cell — each classified by
its cell coordinate."""@en;
