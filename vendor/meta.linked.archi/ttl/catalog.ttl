    ] .

<https://meta.linked.archi/core-notation> a dcat:Dataset;
  dcterms:title "Linked.Archi Core Visual Notation"@en;
  dcterms:description """The visual notation of the core's own relationship types, which relate any
two model concepts that no loaded language relates (DD-40). No metamodel manifest names it: it applies
whatever the language, so a tool loads it with the core, as it loads core-shapes, and consults its notation
set after the default sets of every loaded metamodel — the last fallback layer of the lookup in the Visual
Notation Guide. A language's own descriptor for a core class therefore wins over this one.

It describes each of them, so that every tool draws them alike whatever its own defaults:
arch:Association as a solid line with nothing at either end, as it has no direction; arch:HasPart and
arch:Refines as a solid line with an open arrowhead at the target — the part, the concept refined; and
arch:DependsOn as a dashed line with an open arrowhead at the concept depended on, so that it is not taken
for either (DD-40). Nesting may draw arch:HasPart and arch:Refines instead of a line: the part inside the
whole (arch-vis:nestedEnd arch-vis:TargetEnd), and the refining concept inside the refined one
(arch-vis:SourceEnd) — a view nested in the box of the element it details. An editor that nests one concept
in another can then offer to record either."""@en;
  dcterms:conformsTo <https://meta.linked.archi/core-vis#NotationSet>;
  vann:preferredNamespaceUri "https://meta.linked.archi/core-notation#";
  vann:preferredNamespacePrefix "archnot";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-11-22"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#core>;
  dcat:landingPage <https://meta.linked.archi/core-notation/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/core-notation/core-notation.ttl>;
      dcat:downloadURL <https://meta.linked.archi/core-notation/core-notation.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

