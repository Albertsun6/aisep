<https://meta.linked.archi/basic/notation> a dcat:Dataset;
  dcterms:title "Linked.Archi Basic Visual Notation Set (rectangle)"@en;
  dcterms:description """Default visual notation set of the Linked.Archi Basic asset set,
named by the manifest https://meta.linked.archi/basic/metamodel#Basic with arch:notationSet. It
has generic descriptors for the two core palette classes, arch:Element and
arch:QualifiedRelationship, so a renderer has something to draw for any element or relationship
class without a language-specific notation, and descriptors for Basic's own relationship
classes, basic:Association and basic:Aggregation. Elements are very light grey-green rectangles
with a centred label and no icon. Relationships carry no colour: renderers draw them black, and
they differ by line style and end decorations only. The circle-based alternative,
https://meta.linked.archi/basic/notation-bubble#, is selected by the Workshop participant context
in https://meta.linked.archi/basic/presentation-contexts# and differs only in element
geometry."""@en;
  dcterms:conformsTo <https://meta.linked.archi/core-vis#NotationSet>;
  vann:preferredNamespaceUri "https://meta.linked.archi/basic/notation#";
  vann:preferredNamespacePrefix "basicnot";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-10-06"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#languages>;
  dcat:keyword "Basic"@en;
  dcat:landingPage <https://meta.linked.archi/basic/notation/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/basic/notation/basic-notation.ttl>;
      dcat:downloadURL <https://meta.linked.archi/basic/notation/basic-notation.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

<https://meta.linked.archi/basic/notation-bubble> a dcat:Dataset;
  dcterms:title "Linked.Archi Basic Visual Notation Set (bubble)"@en;
  dcterms:description """Alternative, circle-based (bubble) visual notation set of the
Linked.Archi Basic asset set. The manifest https://meta.linked.archi/basic/metamodel#Basic does
not name it: the Workshop participant context in
https://meta.linked.archi/basic/presentation-contexts# selects it with arch:usesNotationSet. It
has generic descriptors for the two core palette classes, arch:Element and
arch:QualifiedRelationship, so a renderer has something to draw for any element or relationship
class without a language-specific notation, and descriptors for Basic's own relationship
classes, basic:Association and basic:Aggregation. Elements are very light grey-green circles
with a centred label and no icon. Relationships carry no colour: renderers draw them black, and
they differ by line style and end decorations only. The default, rectangle-based set is
published at https://meta.linked.archi/basic/notation# and differs only in element
geometry."""@en;
  dcterms:conformsTo <https://meta.linked.archi/core-vis#NotationSet>;
  vann:preferredNamespaceUri "https://meta.linked.archi/basic/notation-bubble#";
  vann:preferredNamespacePrefix "basicnotbubble";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-10-06"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#languages>;
  dcat:keyword "Basic"@en;
  dcat:landingPage <https://meta.linked.archi/basic/notation-bubble/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/basic/notation-bubble/basic-notation-bubble.ttl>;
      dcat:downloadURL <https://meta.linked.archi/basic/notation-bubble/basic-notation-bubble.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

<https://meta.linked.archi/basic/presentation-contexts> a dcat:Dataset;
  dcterms:title "Linked.Archi Basic Presentation Contexts"@en;
  dcterms:description """Audiences for Basic diagrams. Each context is an audience, as the
core ontology defines a presentation context, and picks one of Basic's two notation sets with
arch:usesNotationSet: the Modeller context the rectangle set, the Workshop participant context
the bubble set. The Basic manifest, https://meta.linked.archi/basic/metamodel#Basic, names only
the rectangle set with arch:notationSet, which keeps it the default; the bubble set is reached
through this scheme alone."""@en;
  dcterms:conformsTo skos:ConceptScheme;
  vann:preferredNamespaceUri "https://meta.linked.archi/basic/presentation-contexts#";
  vann:preferredNamespacePrefix "basicpc";
