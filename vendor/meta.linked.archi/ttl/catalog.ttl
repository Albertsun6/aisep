<https://meta.linked.archi/edgy/metamodel> a dcat:Dataset;
  dcterms:title "Linked.Archi EDGY 23 Metamodel Definition"@en;
  dcterms:description """Metamodel manifest for EDGY 23 — the Enterprise Design language by
Intersection Group. This file ties together all the EDGY semantic resources — the
element/relationship ontology and SKOS taxonomy — into a single arch:Metamodel instance.

EDGY is an open-source tool for collaborative Enterprise Design that provides a simple
but rich visual language of base elements, facet elements, relationships, and labels
to describe what an enterprise consists of and how its parts form a whole.

This is the entry point for tools that need to discover all resources that make up
the EDGY 23 modeling language definition."""@en;
  dcterms:conformsTo arch:Metamodel;
  vann:preferredNamespaceUri "https://meta.linked.archi/edgy/metamodel#";
  vann:preferredNamespacePrefix "edgymm";
  owl:versionInfo "23";
  dcterms:modified "2026-10-06"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by-sa/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#languages>;
  dcat:keyword "EDGY 23"@en;
  dcat:landingPage <https://meta.linked.archi/edgy/metamodel/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/edgy/metamodel/edgy-metamodel.ttl>;
      dcat:downloadURL <https://meta.linked.archi/edgy/metamodel/edgy-metamodel.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ];
  foaf:primaryTopic <https://meta.linked.archi/edgy/metamodel#EDGY23> .

<https://meta.linked.archi/edgy/metamodel#EDGY23> a arch:Metamodel;
  skos:prefLabel "EDGY 23 Metamodel"@en .

