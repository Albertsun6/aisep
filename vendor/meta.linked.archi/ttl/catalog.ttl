<https://meta.linked.archi/edgy/presentation-contexts> a dcat:Dataset;
  dcterms:title "Linked.Archi EDGY 23 Presentation Contexts"@en;
  dcterms:description """Audiences for EDGY 23 maps. Each context is an audience, as the core
ontology defines a presentation context, and picks one of EDGY's two notation sets with
arch:usesNotationSet: the Enterprise designer context the default (v2) set, the Overview map
reader context the circle-based v1 set. The EDGY manifest,
https://meta.linked.archi/edgy/metamodel#EDGY23, names only the v2 set with arch:notationSet,
which keeps it the default; the v1 set is reached through this scheme alone."""@en;
  dcterms:conformsTo skos:ConceptScheme;
  vann:preferredNamespaceUri "https://meta.linked.archi/edgy/presentation-contexts#";
  vann:preferredNamespacePrefix "edgypc";
  owl:versionInfo "23";
  dcterms:modified "2026-10-05"^^xsd:date;
