    ];
  dcat:theme <https://meta.linked.archi/catalog#frameworks>;
  dcat:keyword "TIME Framework"@en;
  dcat:landingPage <https://meta.linked.archi/time-framework/onto/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/time-framework/onto/ontology.jsonld>;
      dcat:downloadURL <https://meta.linked.archi/time-framework/onto/ontology.jsonld>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/ld+json>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/time-framework/onto/ontology.nt>;
      dcat:downloadURL <https://meta.linked.archi/time-framework/onto/ontology.nt>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/n-triples>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/time-framework/onto/ontology.owl>;
