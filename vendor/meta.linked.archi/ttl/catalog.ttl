<https://meta.linked.archi/4plus1> a dcat:Dataset;
  dcterms:title "4+1 View Model Taxonomy"@en;
  dcterms:description """Classification scheme based on Philippe Kruchten's 4+1 View Model
(IEEE Software, 1995). Organizes architecture descriptions into four
concurrent views (Logical, Process, Development, Physical) plus a
unifying Scenarios view that validates and illustrates the others."""@en;
  dcterms:conformsTo skos:ConceptScheme;
  vann:preferredNamespaceUri "https://meta.linked.archi/4plus1#";
  vann:preferredNamespacePrefix "fourplus1";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-05-06"^^xsd:date;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#frameworks>;
  dcat:keyword "4+1 View Model"@en;
  dcat:landingPage <https://meta.linked.archi/4plus1/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/4plus1/4plus1-tax.ttl>;
      dcat:downloadURL <https://meta.linked.archi/4plus1/4plus1-tax.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

<https://meta.linked.archi/4plus1/deliverable-templates> a dcat:Dataset;
  dcterms:title "4+1 View Model Deliverable Templates"@en;
  dcterms:description """Deliverable templates for the 4+1 Architectural View Model.
Defines a Software Architecture Document (SAD) structured around the five views,
following the template pattern from Kruchten's original paper and the RUP SAD template."""@en;
  dcterms:conformsTo arch:DeliverableTemplate;
  vann:preferredNamespaceUri "https://meta.linked.archi/4plus1/deliverable-templates#";
  vann:preferredNamespacePrefix "fourplus1dt";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-05-06"^^xsd:date;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#frameworks>;
  dcat:keyword "4+1 View Model"@en;
  dcat:landingPage <https://meta.linked.archi/4plus1/deliverable-templates/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/4plus1/deliverable-templates/4plus1-deliverable-templates.ttl>;
      dcat:downloadURL <https://meta.linked.archi/4plus1/deliverable-templates/4plus1-deliverable-templates.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

<https://meta.linked.archi/4plus1/metamodel> a dcat:Dataset;
  dcterms:title "4+1 View Model Metamodel Manifest"@en;
  dcterms:description """Metamodel manifest for the 4+1 Architectural View Model.
Aggregates the taxonomy, viewpoints, and deliverable templates into a single
entry point. The 4+1 model is a viewpoint framework — it does not define its
own element types. Custom metamodels reference it for viewpoint structure and
document templates."""@en;
  dcterms:conformsTo arch:Metamodel;
  vann:preferredNamespaceUri "https://meta.linked.archi/4plus1/metamodel#";
  vann:preferredNamespacePrefix "fourplus1mm";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-05-06"^^xsd:date;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#frameworks>;
  dcat:keyword "4+1 View Model"@en;
  dcat:landingPage <https://meta.linked.archi/4plus1/metamodel/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/4plus1/metamodel/4plus1-metamodel.ttl>;
      dcat:downloadURL <https://meta.linked.archi/4plus1/metamodel/4plus1-metamodel.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ];
  foaf:primaryTopic <https://meta.linked.archi/4plus1/metamodel#FourPlusOneMetamodel> .

<https://meta.linked.archi/4plus1/metamodel#FourPlusOneMetamodel> a arch:Metamodel;
  skos:prefLabel "4+1 View Model Metamodel"@en .

<https://meta.linked.archi/4plus1/viewpoints> a dcat:Dataset;
  dcterms:title "4+1 View Model Viewpoints"@en;
  dcterms:description """Viewpoint definitions for the 4+1 Architectural View Model.
These are language-agnostic viewpoints — they specify concerns and stakeholders
but do not prescribe which modeling language to use. A custom metamodel attaches
concrete element types via arch:includesConcept."""@en;
  dcterms:conformsTo arch:Viewpoint;
  vann:preferredNamespaceUri "https://meta.linked.archi/4plus1/viewpoints#";
  vann:preferredNamespacePrefix "fourplus1vp";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-05-06"^^xsd:date;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#frameworks>;
  dcat:keyword "4+1 View Model"@en;
  dcat:landingPage <https://meta.linked.archi/4plus1/viewpoints/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/4plus1/viewpoints/4plus1-viewpoints.ttl>;
      dcat:downloadURL <https://meta.linked.archi/4plus1/viewpoints/4plus1-viewpoints.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ] .

