<https://meta.linked.archi/arch-decision> a dcat:Dataset;
  dcterms:title "Linked.Archi Architecture Decision Ontology"@en;
  dcterms:description """Extension ontology for modeling architecture decisions,
the issues that trigger them, candidate options,
influencing forces (requirements, constraints, trends),
the rationale linking forces to chosen options,
and the lifecycle state of the decision record itself.
Use this extension when you need to capture decision records,
trace forces to options, separate open deliberations from
settled decisions, or integrate with ADD-style
iterative decision processes."""@en;
  dcterms:conformsTo owl:Ontology;
  vann:preferredNamespaceUri "https://meta.linked.archi/arch-decision#";
  vann:preferredNamespacePrefix "ad";
