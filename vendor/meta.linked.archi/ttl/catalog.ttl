      dcat:mediaType <http://www.iana.org/assignments/media-types/application/n-triples>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/zachman/onto/ontology.owl>;
      dcat:downloadURL <https://meta.linked.archi/zachman/onto/ontology.owl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/rdf+xml>
    ], [ a dcat:Distribution;
