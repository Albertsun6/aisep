  dcat:keyword "Zachman Framework"@en;
  dcat:landingPage <https://meta.linked.archi/zachman/onto/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/zachman/onto/ontology.jsonld>;
      dcat:downloadURL <https://meta.linked.archi/zachman/onto/ontology.jsonld>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/application/ld+json>
    ], [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/zachman/onto/ontology.nt>;
