<https://meta.linked.archi/uml/metamodel> a dcat:Dataset;
  dcterms:title "Linked.Archi UML 2.5.1 Metamodel Definition"@en;
  dcterms:description """Metamodel manifest for UML 2.5.1. Ties together the UML
element/relationship ontology, SHACL shapes, alignment axioms, SKOS taxonomy,
viewpoints, and reference data into a single discoverable resource.

This metamodel formalizes the OMG Unified Modeling Language as a Linked.Archi
modeling language, enabling UML model data to participate in the unified
architecture knowledge graph alongside ArchiMate, C4, BPMN, and Backstage.

The mapping from the MOF-based UML metamodel to OWL/RDF is informed by the OMG
Ontology Definition Metamodel (ODM, formal/2014-09-02) Annex D mapping rules,
with Linked.Archi conventions (three-declaration qualified relationships,
SHACL validation, SKOS classification) applied on top. ODM maps UML model
instances (M1) to OWL for dataset use; this metamodel represents the UML
metamodel itself (M2) in OWL for architecture knowledge graph use."""@en;
  dcterms:conformsTo arch:Metamodel;
  vann:preferredNamespaceUri "https://meta.linked.archi/uml/metamodel#";
  vann:preferredNamespacePrefix "umlmm";
  owl:versionInfo "0.1.0";
  dcterms:modified "2026-02-01"^^xsd:date;
  adms:status <http://purl.org/adms/status/UnderDevelopment>;
  dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
  dcterms:creator [ a foaf:Person;
      foaf:name "Kalin Maldzhanski"
    ];
  dcat:theme <https://meta.linked.archi/catalog#languages>;
  dcat:keyword "UML 2.5.1"@en;
  dcat:landingPage <https://meta.linked.archi/uml/metamodel/>;
  dcat:distribution [ a dcat:Distribution;
      dcat:accessURL <https://meta.linked.archi/uml/metamodel/uml-metamodel.ttl>;
      dcat:downloadURL <https://meta.linked.archi/uml/metamodel/uml-metamodel.ttl>;
      dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    ];
  foaf:primaryTopic <https://meta.linked.archi/uml/metamodel#UML2> .

<https://meta.linked.archi/uml/metamodel#UML2> a arch:Metamodel;
  skos:prefLabel "UML 2.5.1 Metamodel"@en .

