@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix vann:     <http://purl.org/vocab/vann/> .
@prefix cc:       <http://creativecommons.org/ns#> .

@prefix arch:     <https://meta.linked.archi/core#> .
@prefix arch-vis: <https://meta.linked.archi/core-vis#> .
@prefix c4:       <https://meta.linked.archi/c4/onto#> .
@prefix structurizr: <https://meta.linked.archi/c4/structurizr#> .
@prefix :         <https://meta.linked.archi/c4/notation#> .

<https://meta.linked.archi/c4/notation#>
    rdf:type                      owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/core-vis#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/c4/notation#" ;
    vann:preferredNamespacePrefix "c4not" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                      "Linked.Archi C4 Model Visual Notation Set"@en ;
    dcterms:description                '''Visual notation descriptors for C4 model elements and
relationships. Defines the standard C4 visual appearance — colored boxes with
technology labels, person shapes, and dashed dependency arrows. Follows the
conventions from c4model.com and Structurizr rendering defaults.'''@en ;
    dcterms:created               "2026-05-16"^^xsd:date ;
    dcterms:modified              "2026-10-11"^^xsd:date ;
    dcterms:publisher                  "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/c4/notation/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    dcterms:source  <https://c4model.com/> ;
    rdfs:seeAlso    <https://docs.structurizr.com/server/diagrams/notation> ;
    prov:wasDerivedFrom <https://c4model.com/> ;
.


#################################################################
# Notation Set
#################################################################

:C4StandardNotation
    a               arch-vis:NotationSet ;
    skos:prefLabel  "C4 Standard Notation"@en ;
    skos:definition '''The standard C4 model visual notation as defined by c4model.com and
rendered by Structurizr. Uses colored rounded rectangles with technology labels,
a person silhouette for users, and dashed arrows for relationships.'''@en ;
.


#################################################################
# Shapes this notation draws beyond the core ones
#
# Declared here, in the notation's namespace, rather than in core-vis: each has a
# core fallback for renderers that cannot draw it, and its geometry as path
# templates (see arch-vis:fallbackShape). Proportions match Structurizr's pictures.
#################################################################

:Person
    a                      arch-vis:ShapeType ;
    skos:prefLabel         "Person"@en ;
    skos:definition        "A head over a body: a circle of radius h x 0.15 (at most w x 0.3) centred at h x 0.165, over a rectangle from h x 0.35 with corners of h x 0.15. C4's person (120 x 120)."@en ;
    arch-vis:fallbackShape arch-vis:RoundedRectangle ;
    arch-vis:shapeVariables "r = min(h * 0.15, w * 0.3); cy = h * 0.165; top = h * 0.35; rb = min(h * 0.15, (h - top) / 2, w / 2)" ;
    arch-vis:outlinePath   "M{rb},{top} L{w-rb},{top} A{rb},{rb} 0 0 1 {w},{top+rb} L{w},{h-rb} A{rb},{rb} 0 0 1 {w-rb},{h} L{rb},{h} A{rb},{rb} 0 0 1 0,{h-rb} L0,{top+rb} A{rb},{rb} 0 0 1 {rb},{top} Z M{w/2-r},{cy} A{r},{r} 0 0 1 {w/2+r},{cy} A{r},{r} 0 0 1 {w/2-r},{cy} Z" ;
    arch-vis:contentBox    "0 {top} {w} {h - top}" ;
.

:MobileDevice
    a                      arch-vis:ShapeType ;
    skos:prefLabel         "Mobile Device"@en ;
    skos:definition        "A device frame around a screen, with a home-button dot above it. C4's mobile app (160 x 110)."@en ;
    arch-vis:fallbackShape arch-vis:RoundedRectangle ;
    arch-vis:shapeVariables "s = min(h * 0.09, w / 4); t = h * 0.13; bt = h * 0.055; fr = min(h * 0.055, w / 2); br = h * 0.027; bcy = h * 0.065" ;
    arch-vis:outlinePath   "M{fr},0 L{w-fr},0 A{fr},{fr} 0 0 1 {w},{fr} L{w},{h-fr} A{fr},{fr} 0 0 1 {w-fr},{h} L{fr},{h} A{fr},{fr} 0 0 1 0,{h-fr} L0,{fr} A{fr},{fr} 0 0 1 {fr},0 Z" ;
    arch-vis:detailPath    "M{s},{t} L{w - s},{t} L{w - s},{h - bt} L{s},{h - bt} Z M{w/2-br},{bcy} A{br},{br} 0 0 1 {w/2+br},{bcy} A{br},{br} 0 0 1 {w/2-br},{bcy} Z" ;
    arch-vis:contentBox    "{s} {t} {w - 2 * s} {h - t - bt}" ;
.

:WebBrowser
    a                      arch-vis:ShapeType ;
    skos:prefLabel         "Web Browser"@en ;
    skos:definition        "A browser window: a title bar (h x 0.155 high, at most 20) with three dots and an address bar over the content area. C4's web browser (160 x 110)."@en ;
    arch-vis:fallbackShape arch-vis:Rectangle ;
    arch-vis:shapeVariables "t = min(h * 0.155, 20); r = min(2, w / 2, h / 2); dr = t * 0.18; dy = t * 0.53; bx = t * 2.25; bx2 = max(t * 2.25, w - 7); by = t * 0.3; by2 = t * 0.76; br = t * 0.23" ;
    arch-vis:outlinePath   "M{r},0 L{w-r},0 A{r},{r} 0 0 1 {w},{r} L{w},{h-r} A{r},{r} 0 0 1 {w-r},{h} L{r},{h} A{r},{r} 0 0 1 0,{h-r} L0,{r} A{r},{r} 0 0 1 {r},0 Z" ;
    arch-vis:detailPath    "M3,{t} L{w - 3},{t} L{w - 3},{h - 3} L3,{h - 3} Z M{t*0.6-dr},{dy} A{dr},{dr} 0 0 1 {t*0.6+dr},{dy} A{dr},{dr} 0 0 1 {t*0.6-dr},{dy} Z M{t*1.2-dr},{dy} A{dr},{dr} 0 0 1 {t*1.2+dr},{dy} A{dr},{dr} 0 0 1 {t*1.2-dr},{dy} Z M{t*1.8-dr},{dy} A{dr},{dr} 0 0 1 {t*1.8+dr},{dy} A{dr},{dr} 0 0 1 {t*1.8-dr},{dy} Z M{bx+br},{by} L{bx2-br},{by} A{br},{br} 0 0 1 {bx2},{by+br} L{bx2},{by2-br} A{br},{br} 0 0 1 {bx2-br},{by2} L{bx+br},{by2} A{br},{br} 0 0 1 {bx},{by2-br} L{bx},{by+br} A{br},{br} 0 0 1 {bx+br},{by} Z" ;
    arch-vis:contentBox    "3 {t} {w - 6} {h - t - 3}" ;
.

:Cylinder
    a                      arch-vis:ShapeType ;
    skos:prefLabel         "Cylinder"@en ;
    skos:definition        "An upright cylinder, its top rim drawn whole, h x 0.27 high (30 in the 160 x 110 picture), at most 30. C4's database."@en ;
    arch-vis:fallbackShape arch-vis:Rectangle ;
    arch-vis:shapeVariables "ry = min(h * 0.27, 30) / 2" ;
    arch-vis:outlinePath   "M0,{ry} A{w / 2},{ry} 0 0 1 {w},{ry} L{w},{h - ry} A{w / 2},{ry} 0 0 1 0,{h - ry} Z" ;
    arch-vis:detailPath    "M0,{ry} A{w / 2},{ry} 0 0 0 {w},{ry}" ;
    arch-vis:contentBox    "0 {2 * ry} {w} {h - 3 * ry}" ;
.

## ─────────────────────────────────────────────────────────────────
## NOTE: Icon URIs (arch:prefVisNotation, arch-vis:iconSymbol) reference
## the published site at https://meta.linked.archi/c4/icons/...
## The source SVG files live in modelingLanguages/c4/icons/
## and are deployed to those URLs by the CI pipeline (pages job).
## For local/offline use, resolve https://meta.linked.archi/ to the repo root.
## ─────────────────────────────────────────────────────────────────


#################################################################
# Element Visual Notations — C4 Core
#################################################################

:PersonNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:Person ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/person.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     :Person ;
        arch-vis:fillColor     "#08427B" ;
        arch-vis:lineColor     "#073B6F" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "120.0"^^xsd:double ;
        arch-vis:defaultHeight "120.0"^^xsd:double ;
    ] ;
.

:SoftwareSystemNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:SoftwareSystem ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/software-system.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     arch-vis:RoundedRectangle ;
        arch-vis:fillColor     "#1168BD" ;
        arch-vis:lineColor     "#0B4884" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.

:ContainerNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:Container ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/container.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     arch-vis:RoundedRectangle ;
        arch-vis:fillColor     "#438DD5" ;
        arch-vis:lineColor     "#3C7FC0" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.

:ComponentNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:Component ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/component.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     arch-vis:RoundedRectangle ;
        arch-vis:fillColor     "#85BBF0" ;
        arch-vis:lineColor     "#78A8D8" ;
        arch-vis:fontColor     "#000000" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.


#################################################################
# Element Visual Notations — kinds of container (subclasses of c4:Container)
#################################################################

:DatabaseNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:Database ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/database.svg> ;
    skos:prefLabel        "Database"@en ;
    skos:definition       "Cylinder shape for a database (c4:Database)."@en ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     :Cylinder ;
        arch-vis:fillColor     "#438DD5" ;
        arch-vis:lineColor     "#3C7FC0" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.

:MobileAppNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:MobileApp ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/mobile-app.svg> ;
    skos:prefLabel        "Mobile App"@en ;
    skos:definition       "Device-frame shape for a mobile app (c4:MobileApp)."@en ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     :MobileDevice ;
        arch-vis:fillColor     "#438DD5" ;
        arch-vis:lineColor     "#3C7FC0" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.

:WebBrowserNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:ClientSideWebApp ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/web-browser.svg> ;
    skos:prefLabel        "Client-side Web Application"@en ;
    skos:definition       "Browser-window shape for a client-side web application (c4:ClientSideWebApp)."@en ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     :WebBrowser ;
        arch-vis:fillColor     "#438DD5" ;
        arch-vis:lineColor     "#3C7FC0" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.


#################################################################
# Element Visual Notations — external people and software systems
#################################################################

:PersonExternalNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:ExternalPerson ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/person-ext.svg> ;
    skos:prefLabel        "External Person"@en ;
    skos:definition       "Grey person shape for an external person (c4:ExternalPerson)."@en ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     :Person ;
        arch-vis:fillColor     "#999999" ;
        arch-vis:lineColor     "#8B8B8B" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "120.0"^^xsd:double ;
        arch-vis:defaultHeight "120.0"^^xsd:double ;
    ] ;
.

:SoftwareSystemExternalNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:ExternalSoftwareSystem ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/software-system-ext.svg> ;
    skos:prefLabel        "External Software System"@en ;
    skos:definition       "Grey box for an external software system (c4:ExternalSoftwareSystem)."@en ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     arch-vis:RoundedRectangle ;
        arch-vis:fillColor     "#999999" ;
        arch-vis:lineColor     "#8B8B8B" ;
        arch-vis:fontColor     "#FFFFFF" ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "110.0"^^xsd:double ;
    ] ;
.

#################################################################
# Element Visual Notations — Structurizr Deployment
#################################################################

:DeploymentNodeNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor structurizr:DeploymentNode ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/deployment-node.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:shapeType     arch-vis:Rectangle ;
        arch-vis:fillColor     "#FFFFFF" ;
        arch-vis:lineColor     "#888888" ;
        arch-vis:fontColor     "#000000" ;
        arch-vis:defaultWidth  "200.0"^^xsd:double ;
        arch-vis:defaultHeight "150.0"^^xsd:double ;
    ] ;
.

:InfrastructureNodeNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor structurizr:InfrastructureNode ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/c4/icons/infrastructure-node.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:renderingMode arch-vis:ShapeWithBadge ;
        arch-vis:shapeType     arch-vis:RoundedRectangle ;
        arch-vis:fillColor     "#FFFFFF" ;
        arch-vis:lineColor     "#888888" ;
        arch-vis:fontColor     "#000000" ;
        arch-vis:iconSymbol    "https://meta.linked.archi/c4/icons/glyphs/cloud-gear.svg"^^xsd:anyURI ;
        arch-vis:iconPlacement arch-vis:TopRight ;
        arch-vis:defaultWidth  "160.0"^^xsd:double ;
        arch-vis:defaultHeight "80.0"^^xsd:double ;
    ] ;
.


#################################################################
# Relationship Visual Notations
#################################################################

## A container drawn inside its software system and a component inside its container, the
## C4 way, stand for containment; a container drawn inside a deployment node, for its
## deployment there (arch-vis:nestedEnd: the end drawn inside).

:UsingNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:Using ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch-vis:lineStyle    arch-vis:DashedLine ;
    arch-vis:sourceDecor  arch-vis:NoDecoration ;
    arch-vis:targetDecor  arch-vis:OpenArrowhead ;
.

:ContainerContainmentNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:ContainerContainment ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch-vis:lineStyle    arch-vis:SolidLine ;
    arch-vis:sourceDecor  arch-vis:FilledDiamond ;
    arch-vis:targetDecor  arch-vis:NoDecoration ;
    arch-vis:nestedEnd    arch-vis:TargetEnd ;
.

:ComponentContainmentNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor c4:ComponentContainment ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch-vis:lineStyle    arch-vis:SolidLine ;
    arch-vis:sourceDecor  arch-vis:FilledDiamond ;
    arch-vis:targetDecor  arch-vis:NoDecoration ;
    arch-vis:nestedEnd    arch-vis:TargetEnd ;
.

:DeploymentNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor structurizr:Deployment ;
    arch-vis:inNotationSet :C4StandardNotation ;
    arch-vis:lineStyle    arch-vis:DashedLine ;
    arch-vis:sourceDecor  arch-vis:NoDecoration ;
    arch-vis:targetDecor  arch-vis:OpenArrowhead ;
    arch-vis:nestedEnd    arch-vis:SourceEnd ;
.
