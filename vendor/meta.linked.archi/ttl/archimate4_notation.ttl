## Junctions: a small circle, filled for And, hollow for Or.

:AndJunctionNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor am4:AndJunction ;
    arch-vis:inNotationSet :ArchiMate40StandardNotation ;
    arch:prefVisNotation  <https://meta.linked.archi/archimate4/icons/and-junction.svg> ;
    arch-vis:defaultStyle [
        a                      arch-vis:Style ;
        arch-vis:shapeType     arch-vis:Circle ;
        arch-vis:fillColor     "#000000" ;
        arch-vis:lineColor     "#000000" ;
        arch-vis:renderingMode arch-vis:ShapeOnly ;
        arch-vis:defaultWidth  "15.0"^^xsd:double ;
        arch-vis:defaultHeight "15.0"^^xsd:double ;
    ] ;
.

