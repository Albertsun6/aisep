#################################################################
# Relationship Visual Notations
#################################################################

## Nesting may draw the structural relationships, access and specialization instead of a
## line (arch-vis:nestedEnd: the end drawn inside). Realization nests either way.
## https://pubs.opengroup.org/architecture/archimate4-doc/chap05.html

:CompositionNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor am4:Composition ;
    arch-vis:inNotationSet :ArchiMate40StandardNotation ;
    arch-vis:lineStyle    arch-vis:SolidLine ;
    arch-vis:sourceDecor  arch-vis:FilledDiamond ;
    arch-vis:targetDecor  arch-vis:NoDecoration ;
    arch-vis:nestedEnd    arch-vis:TargetEnd ;
.

:AggregationNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor am4:Aggregation ;
    arch-vis:inNotationSet :ArchiMate40StandardNotation ;
    arch-vis:lineStyle    arch-vis:SolidLine ;
    arch-vis:sourceDecor  arch-vis:HollowDiamond ;
    arch-vis:targetDecor  arch-vis:NoDecoration ;
    arch-vis:nestedEnd    arch-vis:TargetEnd ;
.

:AssignmentNotation
    a                    arch-vis:VisualNotation ;
    arch-vis:notationFor am4:Assignment ;
    arch-vis:inNotationSet :ArchiMate40StandardNotation ;
    arch-vis:lineStyle    arch-vis:SolidLine ;
    arch-vis:sourceDecor  arch-vis:CircleDot ;
    arch-vis:targetDecor  arch-vis:ClosedArrowhead ;
    arch-vis:nestedEnd    arch-vis:TargetEnd ;
.

:RealizationNotation
