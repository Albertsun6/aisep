@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

@prefix bs:      <https://meta.linked.archi/backstage/onto#> .
@prefix :        <https://meta.linked.archi/backstage/tax#> .


<https://meta.linked.archi/backstage/tax#>
    a                skos:ConceptScheme ;
    skos:prefLabel   "Backstage Concept Scheme"@en ;
    dcterms:description  "Classification of Backstage Software Catalog entities and relationships."@en ;
    skos:hasTopConcept :BackstageElement, :BackstageRelationship ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/backstage/tax#" ;
    vann:preferredNamespacePrefix "bstax" ;
    dcterms:title                      "Linked.Archi Backstage Taxonomy"@en ;
    dcterms:created               "2026-04-16"^^xsd:date ;
    dcterms:modified              "2026-08-24"^^xsd:date ;
    owl:versionInfo               "0.2.0"@en ;
    dcterms:publisher                  "Linked.Archi"@en ;
    dcterms:source  <https://backstage.io/docs/features/software-catalog/> ;
    prov:wasDerivedFrom <https://backstage.io/docs/features/software-catalog/> ;
    rdfs:seeAlso                  <https://backstage.io/docs/features/software-catalog/> ,
                                  <https://github.com/backstage/backstage> ,
                                  <https://github.com/backstage/backstage/tree/master/docs/features/software-catalog> ,
                                  <https://github.com/backstage/backstage/tree/master/packages/catalog-model> ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string .



#################################################################
# Elements — Software Entities
#################################################################

:BackstageElement
    a skos:Concept ; skos:topConceptOf <https://meta.linked.archi/backstage/tax#> ;
    skos:prefLabel "Backstage Element"@en ;
    skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
.

:SoftwareEntity
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#core-entities> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#core-entities> ;
    a skos:Concept ; skos:broader :BackstageElement ;
    skos:prefLabel "Software Entity"@en ;
    skos:definition "Entities representing software artifacts in the catalog."@en ;
    skos:scopeNote  '''bs:Template is classified here even though the system model's core-entities section
does not mention it — the kind is defined in the descriptor format only. The grouping is software artifacts
against organizational ones, not running things against static ones, and a template is a versioned artifact
in a repository, owned by a team and typed by the component it produces. The alternative readings both fail:
it is plainly not an organizational entity, and a third grouping for one member would exist only to avoid
this sentence.'''@en ;
    skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    skos:narrower bs:Component, bs:System, bs:API, bs:Resource, bs:Template ;
.

:ComponentConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#component> ;
    a skos:Concept ; skos:prefLabel "Component"@en ;
    skos:definition "A deployable unit, service, library, or application."@en ;
    skos:broader :SoftwareEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#component> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Component.v1alpha1.schema.json> , bs:Component .

:SystemConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#system> ;
    a skos:Concept ; skos:prefLabel "System"@en ;
    skos:definition "A set of components and resources that provide business or technical value."@en ;
    skos:broader :SoftwareEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#system> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/System.v1alpha1.schema.json> , bs:System .

:APIConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#api> ;
    a skos:Concept ; skos:prefLabel "API"@en ;
    skos:definition "An API that is owned and maintained in the ecosystem."@en ;
    skos:broader :SoftwareEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#api> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/API.v1alpha1.schema.json> , bs:API .

:ResourceConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#resource> ;
    a skos:Concept ; skos:prefLabel "Resource"@en ;
    skos:definition "A resource used by components or systems."@en ;
    skos:broader :SoftwareEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#resource> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Resource.v1alpha1.schema.json> , bs:Resource .

:TemplateConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/descriptor-format#kind-template> ;
    a skos:Concept ; skos:prefLabel "Template"@en ;
    skos:definition "A scaffolder template describing the parameters and steps used to create a component."@en ;
    skos:scopeNote "Sourced to the descriptor format rather than the system model, which does not cover this kind."@en ;
    skos:broader :SoftwareEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/descriptor-format#kind-template> , <https://github.com/backstage/backstage/blob/master/plugins/scaffolder-common/src/Template.v1beta3.schema.json> , bs:Template .


#################################################################
# Elements — Organizational Entities
#################################################################

:OrganizationalEntity
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#organizational-entities> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#organizational-entities> ;
    a skos:Concept ; skos:broader :BackstageElement ;
    skos:prefLabel "Organizational Entity"@en ;
    skos:definition "Entities representing organizational structure in the catalog."@en ;
    skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    skos:narrower bs:Domain, bs:User, bs:Group ;
.

:DomainConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#domain> ;
    a skos:Concept ; skos:prefLabel "Domain"@en ;
    skos:definition "A high-level grouping aligned to business domains."@en ;
    skos:broader :OrganizationalEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#domain> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Domain.v1alpha1.schema.json> , bs:Domain .

:UserConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#user> ;
    a skos:Concept ; skos:prefLabel "User"@en ;
    skos:definition "A human user in the Backstage ecosystem."@en ;
    skos:broader :OrganizationalEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#user> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/User.v1alpha1.schema.json> , bs:User .

:GroupConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/system-model#group> ;
    a skos:Concept ; skos:prefLabel "Group"@en ;
    skos:definition "A group of users such as a team, department, or tribe."@en ;
    skos:broader :OrganizationalEntity ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/system-model#group> , <https://github.com/backstage/backstage/blob/master/packages/catalog-model/src/schema/kinds/Group.v1alpha1.schema.json> , bs:Group .


#################################################################
# Relationships
#################################################################

:BackstageRelationship
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#relations> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#relations> ;
    a skos:Concept ; skos:topConceptOf <https://meta.linked.archi/backstage/tax#> ;
    skos:prefLabel "Backstage Relationship"@en ;
    skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    skos:narrower bs:Ownership, bs:SystemMembership, bs:APIProvision,
                  bs:APIConsumption, bs:Dependency, bs:ResourceUsage,
                  bs:DomainMembership, bs:GroupMembership, bs:GroupParentage,
                  bs:ComponentComposition, bs:DomainHierarchy,
                  bs:TechDocsDelegation, bs:Scaffolding ;
.

:OwnershipConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#ownedby-and-ownerof> ;
    a skos:Concept ; skos:prefLabel "Ownership"@en ;
    skos:definition "An ownership relationship from an element to a group or user."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#ownedby-and-ownerof> , bs:Ownership .

:SystemMembershipConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#partof-and-haspart> ;
    a skos:Concept ; skos:prefLabel "System Membership"@en ;
    skos:definition "A membership relationship from a component, API, or resource to a system."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#partof-and-haspart> , bs:SystemMembership .

:APIProvisionConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#providesapi-and-apiprovidedby> ;
    a skos:Concept ; skos:prefLabel "API Provision"@en ;
    skos:definition "A provision relationship from a component or system to an API."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#providesapi-and-apiprovidedby> , bs:APIProvision .

:APIConsumptionConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#consumesapi-and-apiconsumedby> ;
    a skos:Concept ; skos:prefLabel "API Consumption"@en ;
    skos:definition "A consumption relationship from a component or system to an API."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#consumesapi-and-apiconsumedby> , bs:APIConsumption .

:DependencyConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#dependson-and-dependencyof> ;
    a skos:Concept ; skos:prefLabel "Dependency"@en ;
    skos:definition "A dependency relationship from an entity to another entity it needs in order to function."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#dependson-and-dependencyof> , bs:Dependency .

:ResourceUsageConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#dependson-and-dependencyof> ;
    a skos:Concept ; skos:prefLabel "Resource Usage"@en ;
    skos:definition "A usage relationship from a component or resource to a resource; the resource-facing refinement of Dependency."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#dependson-and-dependencyof> , bs:ResourceUsage .

:DomainMembershipConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#partof-and-haspart> ;
    a skos:Concept ; skos:prefLabel "Domain Membership"@en ;
    skos:definition "A membership relationship from a system to a domain."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#partof-and-haspart> , bs:DomainMembership .

:GroupMembershipConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#memberof-and-hasmember> ;
    a skos:Concept ; skos:prefLabel "Group Membership"@en ;
    skos:definition "A membership relationship from a user to a group."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#memberof-and-hasmember> , bs:GroupMembership .

:GroupParentageConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#parentof-and-childof> ;
    a skos:Concept ; skos:prefLabel "Group Parentage"@en ;
    skos:definition "A child-to-parent relationship between groups in an organizational hierarchy."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#parentof-and-childof> , bs:GroupParentage .

:ComponentCompositionConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#partof-and-haspart> ;
    a skos:Concept ; skos:prefLabel "Component Composition"@en ;
    skos:definition "A part-whole relationship from a subcomponent to its containing component."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#partof-and-haspart> , bs:ComponentComposition .

:DomainHierarchyConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-relations#partof-and-haspart> ;
    a skos:Concept ; skos:prefLabel "Domain Hierarchy"@en ;
    skos:definition "A part-whole relationship from a subdomain to its containing domain."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-relations#partof-and-haspart> , bs:DomainHierarchy .

:TechDocsDelegationConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-annotations#backstageiotechdocs-entity> ;
    a skos:Concept ; skos:prefLabel "TechDocs Delegation"@en ;
    skos:definition "A documentation-ownership delegation from an entity to the entity that owns and builds its TechDocs."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-annotations#backstageiotechdocs-entity> , bs:TechDocsDelegation .

:ScaffoldingConcept
    dcterms:source <https://backstage.io/docs/features/software-catalog/well-known-annotations#backstageiosource-template> ;
    a skos:Concept ; skos:prefLabel "Scaffolding"@en ;
    skos:definition "A provenance relationship from an entity to the scaffolder template it was created from."@en ;
    skos:broader :BackstageRelationship ; skos:inScheme <https://meta.linked.archi/backstage/tax#> ;
    rdfs:seeAlso <https://backstage.io/docs/next/features/software-catalog/well-known-annotations#backstageiosource-template> , bs:Scaffolding .
