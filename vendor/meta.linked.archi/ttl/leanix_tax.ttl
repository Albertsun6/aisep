lmm:RunsOn rdfs:seeAlso :RunsOnConcept .
lmm:IsAssociatedWith rdfs:seeAlso :IsAssociatedWithConcept .
lmm:Produces rdfs:seeAlso :ProducesConcept .
lmm:Realizes rdfs:seeAlso :RealizesConcept .
lmm:DerivesFrom rdfs:seeAlso :DerivesFromConcept .
lmm:IsAttachedTo rdfs:seeAlso :IsAttachedToConcept .
lmm:Powers rdfs:seeAlso :PowersConcept .
lmm:FactSheetHierarchy rdfs:seeAlso :FactSheetHierarchyConcept .

#################################################################
# Availability, independent of architecture layer
#################################################################

:DefaultFactSheetTypes
    a skos:Collection ;
    skos:prefLabel "Default Fact Sheet Types"@en ;
    skos:scopeNote "The twelve predefined fact sheet types."@en ;
    skos:member :ApplicationConcept, :BusinessCapabilityConcept, :BusinessContextConcept, :DataObjectConcept,
                        :ITComponentConcept, :InitiativeConcept, :InterfaceConcept, :ObjectiveConcept,
                        :OrganizationConcept, :PlatformConcept, :ProviderConcept, :TechCategoryConcept ;
.

:OptionalFactSheetTypes
    a skos:Collection ;
    skos:prefLabel "Optional Fact Sheet Types"@en ;
    skos:scopeNote "Types enabled through workspace extensions; this is not an architecture layer."@en ;
    skos:member :SystemConcept, :DataProductConcept, :ContractConcept ;
.

:DefaultFactSheetSubtypes
    a skos:Collection ;
    skos:prefLabel "Default Fact Sheet Subtypes"@en ;
    skos:scopeNote "Defaults follow the current SAP documentation. Business Application, AI Agent and MCP Server are default only in new workspaces created after May 11, 2026; AI Model after October 29, 2025."@en ;
    skos:member :AIAgentConcept, :AIModelConcept, :APIConcept, :BusinessApplicationConcept,
                        :BusinessUnitConcept, :CustomerConcept, :CustomerJourneyConcept, :EpicConcept,
                        :HardwareConcept, :IaaSConcept, :IdeaConcept, :LegalEntityConcept,
                        :LogicalInterfaceConcept, :MCPServerConcept, :PaaSConcept, :ProcessConcept,
                        :ProductConcept, :ProgramConcept, :ProjectConcept, :RegionConcept, :SaaSConcept,
                        :ServiceConcept, :SoftwareConcept, :TeamConcept, :ValueStreamConcept ;
.

:OptionalFactSheetSubtypes
    a skos:Collection ;
    skos:prefLabel "Optional Fact Sheet Subtypes"@en ;
    skos:scopeNote "Subtypes added through optional features or integrations."@en ;
    skos:member :MicroserviceConcept, :ExtensionConcept, :ESGCapabilityConcept ;
.
