    skos:prefLabel      "Customer Profile"@en ;
    skos:notation       "lxdoc-do-1" ;
    dcterms:type        "DataObject" ;
    dcterms:source      <https://help.sap.com/docs/leanix/ea/data-object-modeling-guidelines> ;
    lmm:factSheetStatus lmm:StatusActive ;
.

