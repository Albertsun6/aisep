#################################################################
# The tables: for each element type, the types each relationship may go to
#################################################################

am4:ApplicationComponent
    :permitsAccess                am4:Artifact , am4:BusinessObject , am4:DataObject , am4:Grouping , am4:Material ;
    :permitsAggregation           am4:ApplicationComponent , am4:ApplicationInterface , am4:Grouping ;
    :permitsAssignment            am4:ApplicationInterface , am4:BusinessInterface , am4:DataObject , am4:Event , am4:Function , am4:Grouping ,
                                 am4:Process , am4:Role , am4:Service , am4:TechnologyInterface , am4:WorkPackage ;
    :permitsAssociation           arch:ModelConcept ;
    :permitsComposition           am4:ApplicationComponent , am4:ApplicationInterface , am4:Grouping ;
    :permitsFlow                  am4:ApplicationComponent , am4:ApplicationInterface , am4:BusinessActor , am4:BusinessInterface , am4:Collaboration , am4:CommunicationNetwork ,
                                 am4:Device , am4:DistributionNetwork , am4:Equipment , am4:Event , am4:Facility , am4:Function ,
                                 am4:Grouping , am4:Location , am4:Node , am4:Path , am4:Process , am4:Product ,
                                 am4:Role , am4:Service , am4:SystemSoftware , am4:TechnologyInterface ;
    :permitsInfluence             am4:Assessment , am4:Driver , am4:Goal , am4:Grouping , am4:Meaning , am4:Outcome ,
                                 am4:Principle , am4:Requirement , am4:Stakeholder , am4:Value ;
    :permitsRealization           am4:ApplicationInterface , am4:BusinessInterface , am4:Capability , am4:CourseOfAction , am4:Goal , am4:Grouping ,
                                 am4:Outcome , am4:Path , am4:Principle , am4:Requirement , am4:Resource , am4:Service ,
                                 am4:ValueStream ;
    :permitsServing               am4:ApplicationComponent , am4:ApplicationInterface , am4:BusinessActor , am4:BusinessInterface , am4:Collaboration , am4:CommunicationNetwork ,
                                 am4:Device , am4:DistributionNetwork , am4:Equipment , am4:Event , am4:Facility , am4:Function ,
                                 am4:Grouping , am4:Location , am4:Node , am4:Path , am4:Process , am4:Product ,
                                 am4:Role , am4:Service , am4:SystemSoftware , am4:TechnologyInterface ;
    :permitsSpecialization        am4:ApplicationComponent , am4:Grouping ;
    :permitsTriggering            am4:ApplicationComponent , am4:ApplicationInterface , am4:BusinessActor , am4:BusinessInterface , am4:Collaboration , am4:CommunicationNetwork ,
                                 am4:Device , am4:DistributionNetwork , am4:Equipment , am4:Event , am4:Facility , am4:Function ,
                                 am4:Grouping , am4:Location , am4:Node , am4:Path , am4:Process , am4:Product ,
