@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix am4:     <https://meta.linked.archi/archimate4/onto#> .
@prefix :        <https://meta.linked.archi/archimate4/relationship-tables#> .

#################################################################
# Generated by .scripts/generate-archimate4-shapes.py from the
# relationship matrix (with the relationships between relationships
# of Table B-1), as archimate4-relationship-shapes.ttl is, and from
# the metamodel figures (archimate/metamodel-figures-4.0.xml): do not
# edit by hand.
#################################################################

<https://meta.linked.archi/archimate4/relationship-tables#>
    rdf:type                      owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#>,
                                  <https://meta.linked.archi/archimate4/onto/4.0#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate4/relationship-tables#" ;
    vann:preferredNamespacePrefix "am4rt" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi ArchiMate 4.0 Relationship Tables"@en ;
    dcterms:description           '''The relationship tables of ArchiMate 4.0 (Appendix B.5) as lookups: for
each element type, the types each relationship may go to — directly, or as the result of a
derivation — as annotations on the element type (am4:Artifact :permitsRealization am4:BusinessObject),
and for each relationship the annotation that holds its permissions (am4:realizes :permittedBy
:permitsRealization). A relationship permitted to every element type lists arch:Element, and to
every element and relationship arch:ModelConcept: association, which the tables permit between any
two.

Each permission also says whether it is direct: :permitsDirectRealization, a subproperty of
:permitsRealization (am4:realizes :permittedDirectlyBy :permitsDirectRealization), lists the types the
tables print in upper case — a relationship a modeller may draw. A type :permits… but not
:permitsDirect… is one the specification sanctions only as the conclusion of a derivation. The
relationships between relationships of Table B-1 are direct.

The same tables as the relationship shapes (archimate4-relationship-shapes.ttl), generated from the
same matrix, in a form for another use. The shapes validate: SHACL Core, which any SHACL engine runs
and which reports a relationship the tables forbid. These answer a lookup — may this relationship go
from this type to that one, and may a modeller draw it? — with one triple pattern. A tool may use
either: the shapes to validate, and to read the table back out of their sh:or lists; these to look a
relationship up, and to tell one a modeller may draw from one only a derivation gives.

The derivation rules (archimate4-derivation-rules.ttl) use these: a SHACL rule queries the data graph,
where the shapes are not, and reading the shapes' lists in SPARQL is slow. A potential rule derives only
what these permit from the one element type to the other, so load this file with the model to run
them: without it, the potential rules derive nothing.

Each relationship the specification's metamodel figures draw is given too: :drawsRealization, a
subproperty of :permitsRealization (am4:realizes :drawnBy :drawsRealization), lists the types the
figures draw a realization to from this type — expanded from the abstract types a figure names to the
concrete pairs beneath them that the tables permit directly. They say what the specification
illustrates, which a modelling tool may show; the order in which it proposes relationships is the
taxonomy's. Each such triple's reifier cites, with dcterms:source, every figure that draws it. A pair a
figure names itself is given as the figure draws it: figures 8-1, 9-1 and 11-1 draw an interface serving
a business actor, an application component and a facility, which the tables give only as derived.

This is not an official Open Group document.'''@en ;
    dcterms:created               "2026-10-15"^^xsd:date ;
    dcterms:modified              "2026-10-15"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    dcterms:source                <https://pubs.opengroup.org/architecture/archimate4-doc/appendixb.html#sec-Relationship-Tables> ;
    prov:wasDerivedFrom           <https://pubs.opengroup.org/architecture/archimate4-doc/> ;
    owl:versionIRI                <https://meta.linked.archi/archimate4/relationship-tables/4.0#> ;
    owl:versionInfo               "4.0"@en ;
.

#################################################################
# The annotations
#################################################################

:permittedBy
    a               owl:AnnotationProperty ;
    skos:prefLabel  "permitted by"@en ;
    skos:definition "The annotation that gives, for each element type, the types this relationship may go to under the relationship tables of Appendix B.5."@en ;
    rdfs:domain     owl:ObjectProperty ;
    dcterms:source  <https://pubs.opengroup.org/architecture/archimate4-doc/appendixb.html#sec-Relationship-Tables> ;
.

:permittedDirectlyBy
    a               owl:AnnotationProperty ;
    skos:prefLabel  "permitted directly by"@en ;
    skos:definition "The annotation that gives, for each element type, the types this relationship may go to directly — that a modeller may draw — under the relationship tables of Appendix B.5."@en ;
    rdfs:domain     owl:ObjectProperty ;
    dcterms:source  <https://pubs.opengroup.org/architecture/archimate4-doc/appendixb.html#sec-Relationship-Tables> ;
.

:drawnBy
    a               owl:AnnotationProperty ;
    skos:prefLabel  "drawn by"@en ;
    skos:definition "The annotation that gives, for each element type, the types the specification's metamodel figures draw this relationship to."@en ;
    rdfs:domain     owl:ObjectProperty ;
    dcterms:source  <https://pubs.opengroup.org/architecture/archimate4-doc/> ;
.

:permitsAccess
    a               owl:AnnotationProperty ;
    skos:prefLabel  "permits access"@en ;
    skos:definition "An element of this type may have an access relationship to an element of the given type, under the relationship tables of Appendix B.5 — directly, or as the result of a derivation."@en ;
    rdfs:domain     owl:Class ;
    dcterms:source  <https://pubs.opengroup.org/architecture/archimate4-doc/appendixb.html#sec-Relationship-Tables> ;
.

am4:accesses :permittedBy :permitsAccess .

:permitsDirectAccess
    a                  owl:AnnotationProperty ;
    rdfs:subPropertyOf :permitsAccess ;
    skos:prefLabel     "permits access directly"@en ;
    skos:definition    "An element of this type may have an access relationship to an element of the given type directly — a modeller may draw it — under the relationship tables of Appendix B.5: an upper-case letter."@en ;
    rdfs:domain        owl:Class ;
    dcterms:source     <https://pubs.opengroup.org/architecture/archimate4-doc/appendixb.html#sec-Relationship-Tables> ;
.

am4:accesses :permittedDirectlyBy :permitsDirectAccess .

:drawsAccess
    a                  owl:AnnotationProperty ;
    rdfs:subPropertyOf :permitsAccess ;
    skos:prefLabel     "draws access"@en ;
    skos:definition    "The specification's metamodel figures draw an access relationship from an element of this type to an element of the given type."@en ;
    rdfs:domain        owl:Class ;
    dcterms:source     <https://pubs.opengroup.org/architecture/archimate4-doc/> ;
.

am4:accesses :drawnBy :drawsAccess .

