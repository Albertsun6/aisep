@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix am4:     <https://meta.linked.archi/archimate4/onto#> .
@prefix :        <https://meta.linked.archi/examples/nordfreight/> .

#################################################################
# Model Declaration
#################################################################

:NordFreightModel
    a                          arch:Model ;
    skos:prefLabel             "NordFreight Logistics — Architecture Model"@en ;
    dcterms:title              "NordFreight Logistics — Architecture Model"@en ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/examples/nordfreight/" ;
    vann:preferredNamespacePrefix "nordfreight" ;
    arch:modelConformsToMetamodel <https://meta.linked.archi/archimate4/metamodel#ArchiMate4> ;
    dcterms:created            "2025-06-27"^^xsd:date ;
    dcterms:creator            "Kalin Maldzhanski"^^xsd:string ;
    dcterms:description        "ArchiMate 4.0 architecture model for NordFreight Logistics — a Scandinavian freight company modernising its tracking platform."@en ;
    dcterms:modified           "2026-10-11"^^xsd:date ;
.


#################################################################
# Motivation
#################################################################

:EUCustomsCompliance
    a              am4:Requirement ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "EU Customs Compliance"@en ;
    skos:definition "All cross-border shipments must comply with EU customs electronic declarations by 2026."@en ;
.

:OperationalEfficiency
    a              am4:Goal ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Operational Efficiency"@en ;
    skos:definition "Reduce average shipment processing time by 40% through automation and real-time tracking."@en ;
.

:CarbonNeutrality
    a              am4:Goal ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Carbon Neutral Operations by 2030"@en ;
    skos:definition "Achieve net-zero carbon emissions across all transport modes by 2030."@en ;
.

:ShipperStakeholder
    a              am4:Stakeholder ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Shipper"@en ;
    skos:definition "Commercial customer who contracts NordFreight to transport goods."@en ;
.

:ReceiverStakeholder
    a              am4:Stakeholder ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Receiver"@en ;
    skos:definition "End recipient of shipped goods who needs delivery visibility."@en ;
.

:CloudFirstPrinciple
    a              am4:Principle ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Cloud-First Principle"@en ;
    skos:definition "All new systems deployed on cloud infrastructure; on-premise only for regulatory exceptions."@en ;
.

:APIFirstPrinciple
    a              am4:Principle ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "API-First Design"@en ;
    skos:definition "All services expose well-documented APIs before building user interfaces."@en ;
.


#################################################################
# Strategy
#################################################################

:ShipmentTracking
    a              am4:Capability ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Shipment Tracking"@en ;
    skos:definition "The ability to track shipment location and status in real-time across all transport modes."@en ;
.

:FreightBooking
    a              am4:Capability ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Freight Booking"@en ;
    skos:definition "The ability to accept, validate, and confirm freight transport orders."@en ;
.

:CustomsClearance
    a              am4:Capability ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Customs Clearance"@en ;
    skos:definition "The ability to prepare, submit, and manage customs declarations for cross-border shipments."@en ;
.

:RouteOptimisation
    a              am4:Capability ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Route Optimisation"@en ;
    skos:definition "The ability to calculate optimal routes considering cost, time, emissions, and capacity."@en ;
.

:FleetManagement
    a              am4:Capability ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Fleet Management"@en ;
    skos:definition "The ability to manage vehicles, vessels, and rolling stock across the transport network."@en ;
.


#################################################################
# Business (Common Domain behavior + Business Domain structure)
#################################################################

:BookingProcess
    a              am4:Process ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Booking Process"@en ;
    skos:definition "End-to-end process from freight enquiry through quote, booking confirmation, to dispatch."@en ;
.

:TrackingService
    a              am4:Service ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Shipment Tracking Service"@en ;
    skos:definition "Service providing real-time shipment location and ETA to shippers and receivers."@en ;
.

:CustomsDeclarationProcess
    a              am4:Process ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Customs Declaration Process"@en ;
    skos:definition "Process of preparing and submitting electronic customs declarations for cross-border freight."@en ;
.

:FreightOperations
    a              am4:Role ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Freight Operations"@en ;
    skos:definition "Operational role responsible for coordinating transport execution and exception handling."@en ;
.

:CustomsBroker
    a              am4:Role ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Customs Broker"@en ;
    skos:definition "Specialist role managing customs documentation and regulatory compliance."@en ;
.

:Shipment
    a              am4:BusinessObject ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Shipment"@en ;
    skos:definition "A consignment of goods being transported from origin to destination."@en ;
.

:WaybillDocument
    a              am4:BusinessObject ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Waybill"@en ;
    skos:definition "Transport document containing shipment details, routing, and delivery instructions."@en ;
.

:BookingConfirmationEvent
    a              am4:Event ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Booking Confirmed"@en ;
    skos:definition "Event triggered when a freight booking is validated and confirmed."@en ;
.

:ShipmentDeliveredEvent
    a              am4:Event ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Shipment Delivered"@en ;
    skos:definition "Event triggered when goods are delivered to the receiver and proof of delivery captured."@en ;
.


#################################################################
# Application Architecture
#################################################################

:TMS
    a              am4:ApplicationComponent ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Transport Management System"@en ;
    skos:definition "Core system managing freight orders, routing, carrier allocation, and execution monitoring."@en ;
.

:TrackingPortal
    a              am4:ApplicationComponent ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Tracking Portal"@en ;
    skos:definition "Web application providing real-time shipment visibility to shippers and receivers."@en ;
.

:CustomsGateway
    a              am4:ApplicationComponent ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Customs Gateway"@en ;
    skos:definition "Integration platform connecting to EU customs systems (ICS2, NCTS) for electronic declarations."@en ;
.

:RouteEngine
    a              am4:ApplicationComponent ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Route Optimisation Engine"@en ;
    skos:definition "AI-powered system calculating optimal multi-modal routes considering cost, time, and emissions."@en ;
.

:ShipmentData
    a              am4:DataObject ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Shipment Data"@en ;
    skos:definition "Structured data representing shipment lifecycle — booking, tracking events, delivery confirmation."@en ;
.

:CustomsData
    a              am4:DataObject ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Customs Declaration Data"@en ;
    skos:definition "Structured data for customs declarations — HS codes, values, origins, certificates."@en ;
.

:TrackingAPI
    a              am4:ApplicationInterface ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Tracking API"@en ;
    skos:definition "REST API exposing real-time shipment tracking events to external consumers."@en ;
.

:BookingAPI
    a              am4:ApplicationInterface ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Booking API"@en ;
    skos:definition "REST API for programmatic freight booking by shipper systems."@en ;
.


#################################################################
# Technology Architecture
#################################################################

:AzureCloud
    a              am4:Node ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Azure North Europe"@en ;
    skos:definition "Microsoft Azure North Europe region hosting NordFreight production workloads."@en ;
.

:K8sCluster
    a              am4:SystemSoftware ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "AKS Kubernetes Cluster"@en ;
    skos:definition "Azure Kubernetes Service cluster running containerised microservices."@en ;
.

:IoTGateway
    a              am4:Device ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "IoT Tracking Gateway"@en ;
    skos:definition "Edge device aggregating GPS, temperature, and shock sensor data from transport units."@en ;
.

:EventBus
    a              am4:SystemSoftware ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Azure Event Hubs"@en ;
    skos:definition "Event streaming platform processing millions of tracking events per day."@en ;
.

:PostgresDB
    a              am4:SystemSoftware ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Azure Database for PostgreSQL"@en ;
    skos:definition "Managed PostgreSQL database storing shipment and booking data."@en ;
.


#################################################################
# Implementation & Migration
#################################################################

:PlatformModernisation
    a              am4:WorkPackage ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Platform Modernisation Programme"@en ;
    skos:definition "2-year programme migrating from monolithic TMS to cloud-native microservices architecture."@en ;
.

:CustomsIntegration
    a              am4:WorkPackage ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "EU Customs Integration Project"@en ;
    skos:definition "Project implementing ICS2 and NCTS5 electronic customs declaration interfaces."@en ;
.

:TargetArchitecture2027
    a              am4:Plateau ;
    arch:inModel   :NordFreightModel ;
    skos:prefLabel "Target Architecture 2027"@en ;
    skos:definition "Fully cloud-native, API-first architecture with real-time tracking and automated customs."@en ;
.


#################################################################
# Relationships
#
# Each relationship is written as its direct triple, its qualified
# predicate and its resource (arch:source, arch:target, rdf:reifies).
#################################################################

## Assignment (active structure performs behavior)
:FreightOperations am4:assignedTo :BookingProcess .
:FreightOperations am4:qualifiedAssignment :qr-FreightOperations-assignedTo-BookingProcess .
:qr-FreightOperations-assignedTo-BookingProcess a am4:Assignment ; arch:inModel :NordFreightModel ;
    arch:source :FreightOperations ; arch:target :BookingProcess ;
    rdf:reifies <<( :FreightOperations am4:assignedTo :BookingProcess )>> .
:CustomsBroker am4:assignedTo :CustomsDeclarationProcess .
:CustomsBroker am4:qualifiedAssignment :qr-CustomsBroker-assignedTo-CustomsDeclarationProcess .
:qr-CustomsBroker-assignedTo-CustomsDeclarationProcess a am4:Assignment ; arch:inModel :NordFreightModel ;
    arch:source :CustomsBroker ; arch:target :CustomsDeclarationProcess ;
    rdf:reifies <<( :CustomsBroker am4:assignedTo :CustomsDeclarationProcess )>> .

## Realization (capability realized by process/service)
:BookingProcess am4:realizes :FreightBooking .
:BookingProcess am4:qualifiedRealization :qr-BookingProcess-realizes-FreightBooking .
:qr-BookingProcess-realizes-FreightBooking a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :BookingProcess ; arch:target :FreightBooking ;
    rdf:reifies <<( :BookingProcess am4:realizes :FreightBooking )>> .
:TrackingService am4:realizes :ShipmentTracking .
:TrackingService am4:qualifiedRealization :qr-TrackingService-realizes-ShipmentTracking .
:qr-TrackingService-realizes-ShipmentTracking a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :TrackingService ; arch:target :ShipmentTracking ;
    rdf:reifies <<( :TrackingService am4:realizes :ShipmentTracking )>> .
:CustomsDeclarationProcess am4:realizes :CustomsClearance .
:CustomsDeclarationProcess am4:qualifiedRealization :qr-CustomsDeclarationProcess-realizes-CustomsClearance .
:qr-CustomsDeclarationProcess-realizes-CustomsClearance a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :CustomsDeclarationProcess ; arch:target :CustomsClearance ;
    rdf:reifies <<( :CustomsDeclarationProcess am4:realizes :CustomsClearance )>> .

## Serving (element serves another)
:TMS am4:serves :BookingProcess .
:TMS am4:qualifiedServing :qr-TMS-serves-BookingProcess .
:qr-TMS-serves-BookingProcess a am4:Serving ; arch:inModel :NordFreightModel ;
    arch:source :TMS ; arch:target :BookingProcess ;
    rdf:reifies <<( :TMS am4:serves :BookingProcess )>> .
:TMS am4:serves :FreightOperations .
:TMS am4:qualifiedServing :qr-TMS-serves-FreightOperations .
:qr-TMS-serves-FreightOperations a am4:Serving ; arch:inModel :NordFreightModel ;
    arch:source :TMS ; arch:target :FreightOperations ;
    rdf:reifies <<( :TMS am4:serves :FreightOperations )>> .
:TrackingPortal am4:serves :TrackingService .
:TrackingPortal am4:qualifiedServing :qr-TrackingPortal-serves-TrackingService .
:qr-TrackingPortal-serves-TrackingService a am4:Serving ; arch:inModel :NordFreightModel ;
    arch:source :TrackingPortal ; arch:target :TrackingService ;
    rdf:reifies <<( :TrackingPortal am4:serves :TrackingService )>> .
:CustomsGateway am4:serves :CustomsDeclarationProcess .
:CustomsGateway am4:qualifiedServing :qr-CustomsGateway-serves-CustomsDeclarationProcess .
:qr-CustomsGateway-serves-CustomsDeclarationProcess a am4:Serving ; arch:inModel :NordFreightModel ;
    arch:source :CustomsGateway ; arch:target :CustomsDeclarationProcess ;
    rdf:reifies <<( :CustomsGateway am4:serves :CustomsDeclarationProcess )>> .
:RouteEngine am4:serves :BookingProcess .
:RouteEngine am4:qualifiedServing :qr-RouteEngine-serves-BookingProcess .
:qr-RouteEngine-serves-BookingProcess a am4:Serving ; arch:inModel :NordFreightModel ;
    arch:source :RouteEngine ; arch:target :BookingProcess ;
    rdf:reifies <<( :RouteEngine am4:serves :BookingProcess )>> .

## Access (behavior accesses passive structure)
:BookingProcess am4:accesses :Shipment .
:BookingProcess am4:qualifiedAccess :qr-BookingProcess-accesses-Shipment .
:qr-BookingProcess-accesses-Shipment a am4:Access ; arch:inModel :NordFreightModel ;
    arch:source :BookingProcess ; arch:target :Shipment ;
    rdf:reifies <<( :BookingProcess am4:accesses :Shipment )>> .
:BookingProcess am4:accesses :WaybillDocument .
:BookingProcess am4:qualifiedAccess :qr-BookingProcess-accesses-WaybillDocument .
:qr-BookingProcess-accesses-WaybillDocument a am4:Access ; arch:inModel :NordFreightModel ;
    arch:source :BookingProcess ; arch:target :WaybillDocument ;
    rdf:reifies <<( :BookingProcess am4:accesses :WaybillDocument )>> .
:CustomsDeclarationProcess am4:accesses :CustomsData .
:CustomsDeclarationProcess am4:qualifiedAccess :qr-CustomsDeclarationProcess-accesses-CustomsData .
:qr-CustomsDeclarationProcess-accesses-CustomsData a am4:Access ; arch:inModel :NordFreightModel ;
    arch:source :CustomsDeclarationProcess ; arch:target :CustomsData ;
    rdf:reifies <<( :CustomsDeclarationProcess am4:accesses :CustomsData )>> .
:TMS am4:accesses :ShipmentData .
:TMS am4:qualifiedAccess :qr-TMS-accesses-ShipmentData .
:qr-TMS-accesses-ShipmentData a am4:Access ; arch:inModel :NordFreightModel ;
    arch:source :TMS ; arch:target :ShipmentData ;
    rdf:reifies <<( :TMS am4:accesses :ShipmentData )>> .

## Composition (element consists of)
:AzureCloud am4:composedOf :K8sCluster .
:AzureCloud am4:qualifiedComposition :qr-AzureCloud-composedOf-K8sCluster .
:qr-AzureCloud-composedOf-K8sCluster a am4:Composition ; arch:inModel :NordFreightModel ;
    arch:source :AzureCloud ; arch:target :K8sCluster ;
    rdf:reifies <<( :AzureCloud am4:composedOf :K8sCluster )>> .
:AzureCloud am4:composedOf :EventBus .
:AzureCloud am4:qualifiedComposition :qr-AzureCloud-composedOf-EventBus .
:qr-AzureCloud-composedOf-EventBus a am4:Composition ; arch:inModel :NordFreightModel ;
    arch:source :AzureCloud ; arch:target :EventBus ;
    rdf:reifies <<( :AzureCloud am4:composedOf :EventBus )>> .
:AzureCloud am4:composedOf :PostgresDB .
:AzureCloud am4:qualifiedComposition :qr-AzureCloud-composedOf-PostgresDB .
:qr-AzureCloud-composedOf-PostgresDB a am4:Composition ; arch:inModel :NordFreightModel ;
    arch:source :AzureCloud ; arch:target :PostgresDB ;
    rdf:reifies <<( :AzureCloud am4:composedOf :PostgresDB )>> .

## Flow (transfer of content)
:TMS am4:flowsTo :CustomsGateway .
:TMS am4:qualifiedFlow :qr-TMS-flowsTo-CustomsGateway .
:qr-TMS-flowsTo-CustomsGateway a am4:Flow ; arch:inModel :NordFreightModel ;
    arch:source :TMS ; arch:target :CustomsGateway ;
    rdf:reifies <<( :TMS am4:flowsTo :CustomsGateway )>> .
:IoTGateway am4:flowsTo :EventBus .
:IoTGateway am4:qualifiedFlow :qr-IoTGateway-flowsTo-EventBus .
:qr-IoTGateway-flowsTo-EventBus a am4:Flow ; arch:inModel :NordFreightModel ;
    arch:source :IoTGateway ; arch:target :EventBus ;
    rdf:reifies <<( :IoTGateway am4:flowsTo :EventBus )>> .
:EventBus am4:flowsTo :TMS .
:EventBus am4:qualifiedFlow :qr-EventBus-flowsTo-TMS .
:qr-EventBus-flowsTo-TMS a am4:Flow ; arch:inModel :NordFreightModel ;
    arch:source :EventBus ; arch:target :TMS ;
    rdf:reifies <<( :EventBus am4:flowsTo :TMS )>> .
:TMS am4:flowsTo :TrackingPortal .
:TMS am4:qualifiedFlow :qr-TMS-flowsTo-TrackingPortal .
:qr-TMS-flowsTo-TrackingPortal a am4:Flow ; arch:inModel :NordFreightModel ;
    arch:source :TMS ; arch:target :TrackingPortal ;
    rdf:reifies <<( :TMS am4:flowsTo :TrackingPortal )>> .

## Triggering
:BookingConfirmationEvent am4:triggers :BookingProcess .
:BookingConfirmationEvent am4:qualifiedTriggering :qr-BookingConfirmationEvent-triggers-BookingProcess .
:qr-BookingConfirmationEvent-triggers-BookingProcess a am4:Triggering ; arch:inModel :NordFreightModel ;
    arch:source :BookingConfirmationEvent ; arch:target :BookingProcess ;
    rdf:reifies <<( :BookingConfirmationEvent am4:triggers :BookingProcess )>> .
:BookingProcess am4:triggers :TrackingService .
:BookingProcess am4:qualifiedTriggering :qr-BookingProcess-triggers-TrackingService .
:qr-BookingProcess-triggers-TrackingService a am4:Triggering ; arch:inModel :NordFreightModel ;
    arch:source :BookingProcess ; arch:target :TrackingService ;
    rdf:reifies <<( :BookingProcess am4:triggers :TrackingService )>> .

## Realization of motivation elements (a core element realizes a requirement or principle)
:CustomsGateway am4:realizes :EUCustomsCompliance .
:CustomsGateway am4:qualifiedRealization :qr-CustomsGateway-realizes-EUCustomsCompliance .
:qr-CustomsGateway-realizes-EUCustomsCompliance a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :CustomsGateway ; arch:target :EUCustomsCompliance ;
    rdf:reifies <<( :CustomsGateway am4:realizes :EUCustomsCompliance )>> .
:AzureCloud     am4:realizes :CloudFirstPrinciple .
:AzureCloud am4:qualifiedRealization :qr-AzureCloud-realizes-CloudFirstPrinciple .
:qr-AzureCloud-realizes-CloudFirstPrinciple a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :AzureCloud ; arch:target :CloudFirstPrinciple ;
    rdf:reifies <<( :AzureCloud am4:realizes :CloudFirstPrinciple )>> .
:TrackingAPI    am4:realizes :APIFirstPrinciple .
:TrackingAPI am4:qualifiedRealization :qr-TrackingAPI-realizes-APIFirstPrinciple .
:qr-TrackingAPI-realizes-APIFirstPrinciple a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :TrackingAPI ; arch:target :APIFirstPrinciple ;
    rdf:reifies <<( :TrackingAPI am4:realizes :APIFirstPrinciple )>> .
:BookingAPI     am4:realizes :APIFirstPrinciple .
:BookingAPI am4:qualifiedRealization :qr-BookingAPI-realizes-APIFirstPrinciple .
:qr-BookingAPI-realizes-APIFirstPrinciple a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :BookingAPI ; arch:target :APIFirstPrinciple ;
    rdf:reifies <<( :BookingAPI am4:realizes :APIFirstPrinciple )>> .

## Association (a stakeholder is a motivation element: an interface is associated with the
## stakeholders it is for; it serves roles and actors)
:TrackingAPI am4:associatedWith :ShipperStakeholder .
:TrackingAPI am4:qualifiedAssociation :qr-TrackingAPI-associatedWith-ShipperStakeholder .
:qr-TrackingAPI-associatedWith-ShipperStakeholder a am4:Association ; arch:inModel :NordFreightModel ;
    arch:source :TrackingAPI ; arch:target :ShipperStakeholder ;
    rdf:reifies <<( :TrackingAPI am4:associatedWith :ShipperStakeholder )>> .
:TrackingAPI am4:associatedWith :ReceiverStakeholder .
:TrackingAPI am4:qualifiedAssociation :qr-TrackingAPI-associatedWith-ReceiverStakeholder .
:qr-TrackingAPI-associatedWith-ReceiverStakeholder a am4:Association ; arch:inModel :NordFreightModel ;
    arch:source :TrackingAPI ; arch:target :ReceiverStakeholder ;
    rdf:reifies <<( :TrackingAPI am4:associatedWith :ReceiverStakeholder )>> .

## Realization (physical realizes logical / work package realizes goal)
:K8sCluster am4:realizes :TMS .
:K8sCluster am4:qualifiedRealization :qr-K8sCluster-realizes-TMS .
:qr-K8sCluster-realizes-TMS a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :K8sCluster ; arch:target :TMS ;
    rdf:reifies <<( :K8sCluster am4:realizes :TMS )>> .
:K8sCluster am4:realizes :TrackingPortal .
:K8sCluster am4:qualifiedRealization :qr-K8sCluster-realizes-TrackingPortal .
:qr-K8sCluster-realizes-TrackingPortal a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :K8sCluster ; arch:target :TrackingPortal ;
    rdf:reifies <<( :K8sCluster am4:realizes :TrackingPortal )>> .
:K8sCluster am4:realizes :CustomsGateway .
:K8sCluster am4:qualifiedRealization :qr-K8sCluster-realizes-CustomsGateway .
:qr-K8sCluster-realizes-CustomsGateway a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :K8sCluster ; arch:target :CustomsGateway ;
    rdf:reifies <<( :K8sCluster am4:realizes :CustomsGateway )>> .
:PlatformModernisation am4:realizes :OperationalEfficiency .
:PlatformModernisation am4:qualifiedRealization :qr-PlatformModernisation-realizes-OperationalEfficiency .
:qr-PlatformModernisation-realizes-OperationalEfficiency a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :PlatformModernisation ; arch:target :OperationalEfficiency ;
    rdf:reifies <<( :PlatformModernisation am4:realizes :OperationalEfficiency )>> .
:CustomsIntegration am4:realizes :EUCustomsCompliance .
:CustomsIntegration am4:qualifiedRealization :qr-CustomsIntegration-realizes-EUCustomsCompliance .
:qr-CustomsIntegration-realizes-EUCustomsCompliance a am4:Realization ; arch:inModel :NordFreightModel ;
    arch:source :CustomsIntegration ; arch:target :EUCustomsCompliance ;
    rdf:reifies <<( :CustomsIntegration am4:realizes :EUCustomsCompliance )>> .

## Aggregation
:PlatformModernisation am4:aggregates :CustomsIntegration .
:PlatformModernisation am4:qualifiedAggregation :qr-PlatformModernisation-aggregates-CustomsIntegration .
:qr-PlatformModernisation-aggregates-CustomsIntegration a am4:Aggregation ; arch:inModel :NordFreightModel ;
    arch:source :PlatformModernisation ; arch:target :CustomsIntegration ;
    rdf:reifies <<( :PlatformModernisation am4:aggregates :CustomsIntegration )>> .


#################################################################
# Views
#################################################################

:NordFreightLayeredView
    a                            arch:View ;
    arch:inModel                 :NordFreightModel ;
    skos:prefLabel               "NordFreight Layered View"@en ;
    arch:viewConformsToViewpoint <https://meta.linked.archi/archimate4/viewpoints#LayeredViewpoint> ;
.

