@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix bs:      <https://meta.linked.archi/backstage/onto#> .
@prefix :        <https://meta.linked.archi/examples/payflow/> .

#################################################################
# Model Declaration
#################################################################

:PayFlowModel
    a                          arch:Model ;
    skos:prefLabel             "PayFlow — Backstage Catalog Model"@en ;
    dcterms:title              "PayFlow — Backstage Catalog Model"@en ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/examples/payflow/" ;
    vann:preferredNamespacePrefix "payflow" ;
    arch:modelConformsToMetamodel <https://meta.linked.archi/backstage/metamodel#BackstageCatalog> ;
    dcterms:created            "2025-06-27"^^xsd:date ;
    dcterms:creator            "Kalin Maldzhanski"^^xsd:string ;
    dcterms:description        "Backstage software catalog model for PayFlow — a fintech platform providing payment processing, merchant onboarding, and financial reporting."@en ;
.


#################################################################
# Organisation-specific reference data (bs:ResourceType individuals)
#
# bs:ResourceType is open (DD-23, no owl:oneOf): the documented
# examples (database, s3-bucket, kubernetes-cluster) do not cover
# a message broker or an in-memory cache, so PayFlow mints its own,
# exactly as backstage-shapes.ttl's ResourceTypeShape comment says
# an adopter should.
#################################################################

:MessageBrokerResourceType
    a              bs:ResourceType ;
    skos:prefLabel "Message Broker"@en ;
    skos:notation  "message-broker" ;
.

:CacheResourceType
    a              bs:ResourceType ;
    skos:prefLabel "Cache"@en ;
    skos:notation  "cache" ;
.


#################################################################
# Domains
#################################################################

:PaymentsDomain
    a              bs:Domain ;
    bs:name        "payments" ;
    skos:prefLabel "Payments"@en ;
    skos:definition "Domain covering payment processing, fraud detection, and payouts."@en ;
.

:MerchantDomain
    a              bs:Domain ;
    bs:name        "merchant-services" ;
    skos:prefLabel "Merchant Services"@en ;
    skos:definition "Domain covering merchant onboarding, reporting, and self-service."@en ;
.

:PlatformDomain
    a              bs:Domain ;
    bs:name        "platform" ;
    skos:prefLabel "Platform"@en ;
    skos:definition "Domain covering shared infrastructure, observability, and developer tooling."@en ;
.


#################################################################
# Groups (Teams)
#################################################################

:PaymentsSquad
    a              bs:Group ;
    bs:name        "payments-squad" ;
    bs:groupType   bs:TeamGroupType ;
    skos:prefLabel "Payments Squad"@en ;
    skos:definition "Squad responsible for payment processing, fraud, and payout services."@en ;
.

:MerchantSquad
    a              bs:Group ;
    bs:name        "merchant-squad" ;
    bs:groupType   bs:TeamGroupType ;
    skos:prefLabel "Merchant Squad"@en ;
    skos:definition "Squad responsible for merchant onboarding and reporting."@en ;
.

:PlatformTeam
    a              bs:Group ;
    bs:name        "platform-team" ;
    bs:groupType   bs:TeamGroupType ;
    skos:prefLabel "Platform Team"@en ;
    skos:definition "Team providing shared infrastructure and developer experience tooling."@en ;
.

:SRETeam
    a              bs:Group ;
    bs:name        "sre-team" ;
    bs:groupType   bs:TeamGroupType ;
    skos:prefLabel "SRE Team"@en ;
    skos:definition "Site Reliability Engineering team managing production reliability."@en ;
.

# Organisational hierarchy (spec.parent, canonical direction child → parent — see DD on
# GroupParentage): SRE sits inside the Platform Team org line.
:SRETeam bs:childOf :PlatformTeam .
:SRETeam bs:qualifiedGroupParentage :qr-SRETeam-childOf-PlatformTeam .
:qr-SRETeam-childOf-PlatformTeam a bs:GroupParentage ;
    arch:source :SRETeam ; arch:target :PlatformTeam ;
    rdf:reifies <<( :SRETeam bs:childOf :PlatformTeam )>> .


#################################################################
# Users
#################################################################

:AliceEngineer
    a              bs:User ;
    bs:name        "alice.chen" ;
    skos:prefLabel "alice.chen"@en ;
    skos:definition "Senior backend engineer in the Payments Squad specialising in transaction processing and fraud detection."@en ;
.

:BobPlatform
    a              bs:User ;
    bs:name        "bob.eriksson" ;
    skos:prefLabel "bob.eriksson"@en ;
    skos:definition "Platform engineer in the Platform Team responsible for shared infrastructure and developer tooling."@en ;
.

:AliceEngineer bs:memberOf :PaymentsSquad .
:AliceEngineer bs:qualifiedGroupMembership :qr-AliceEngineer-memberOf-PaymentsSquad .
:qr-AliceEngineer-memberOf-PaymentsSquad a bs:GroupMembership ;
    arch:source :AliceEngineer ; arch:target :PaymentsSquad ;
    rdf:reifies <<( :AliceEngineer bs:memberOf :PaymentsSquad )>> .
:BobPlatform bs:memberOf :PlatformTeam .
:BobPlatform bs:qualifiedGroupMembership :qr-BobPlatform-memberOf-PlatformTeam .
:qr-BobPlatform-memberOf-PlatformTeam a bs:GroupMembership ;
    arch:source :BobPlatform ; arch:target :PlatformTeam ;
    rdf:reifies <<( :BobPlatform bs:memberOf :PlatformTeam )>> .


#################################################################
# Systems
#################################################################

:PaymentGateway
    a              bs:System ;
    bs:name        "payment-gateway" ;
    skos:prefLabel "Payment Gateway"@en ;
    skos:definition "System handling payment processing, fraud detection, and merchant payouts."@en ;
.

:MerchantPortal
    a              bs:System ;
    bs:name        "merchant-portal" ;
    skos:prefLabel "Merchant Portal"@en ;
    skos:definition "System providing merchant self-service, onboarding, and financial reporting."@en ;
.

:ObservabilityPlatform
    a              bs:System ;
    bs:name        "observability-platform" ;
    skos:prefLabel "Observability Platform"@en ;
    skos:definition "Shared system providing metrics, logging, tracing, and alerting."@en ;
.


#################################################################
# Components
#################################################################

:PaymentProcessor
    a                  bs:Component ;
    bs:name             "payment-processor" ;
    skos:prefLabel      "payment-processor"@en ;
    skos:definition     "Core service processing payment transactions — authorisation, capture, refund."@en ;
    bs:lifecycleState   bs:Production ;
.

:FraudService
    a                  bs:Component ;
    bs:name             "fraud-service" ;
    skos:prefLabel      "fraud-service"@en ;
    skos:definition     "Real-time fraud scoring service using ML models to evaluate transaction risk before authorisation."@en ;
    bs:lifecycleState   bs:Production ;
.

:FraudModelScorer
    a                  bs:Component ;
    bs:name             "fraud-model-scorer" ;
    skos:prefLabel      "fraud-model-scorer"@en ;
    skos:definition     "ML scoring sub-component of fraud-service, packaged and deployed separately."@en ;
    bs:lifecycleState   bs:Experimental ;
    bs:subcomponentOf   :FraudService ;
.

:FraudModelScorer bs:qualifiedComponentComposition :qr-FraudModelScorer-subcomponentOf-FraudService .
:qr-FraudModelScorer-subcomponentOf-FraudService a bs:ComponentComposition ;
    arch:source :FraudModelScorer ; arch:target :FraudService ;
    rdf:reifies <<( :FraudModelScorer bs:subcomponentOf :FraudService )>> .

:PayoutService
    a                  bs:Component ;
    bs:name             "payout-service" ;
    skos:prefLabel      "payout-service"@en ;
    skos:definition     "Service managing scheduled merchant payouts and settlement."@en ;
    bs:lifecycleState   bs:Production ;
.

:MerchantOnboarding
    a                  bs:Component ;
    bs:name             "merchant-onboarding" ;
    skos:prefLabel      "merchant-onboarding"@en ;
    skos:definition     "Service handling merchant registration, KYC, and account activation."@en ;
    bs:lifecycleState   bs:Production ;
.

:ReportingService
    a                  bs:Component ;
    bs:name             "reporting-service" ;
    skos:prefLabel      "reporting-service"@en ;
    skos:definition     "Service generating financial reports and analytics for merchants."@en ;
    bs:lifecycleState   bs:Experimental ;
    bs:dependsOn        :PaymentProcessor ;
.

:ReportingService bs:qualifiedDependency :qr-ReportingService-dependsOn-PaymentProcessor .
:qr-ReportingService-dependsOn-PaymentProcessor a bs:Dependency ;
    arch:source :ReportingService ; arch:target :PaymentProcessor ;
    rdf:reifies <<( :ReportingService bs:dependsOn :PaymentProcessor )>> .

:WebhookDispatcher
    a                  bs:Component ;
    bs:name             "webhook-dispatcher" ;
    skos:prefLabel      "webhook-dispatcher"@en ;
    skos:definition     "Platform service delivering event notifications to merchant webhook endpoints."@en ;
    bs:lifecycleState   bs:Production ;
.


#################################################################
# APIs
#################################################################

## bs:definition carries the API document verbatim, in the format bs:apiType declares.
## The descriptor format requires the field, and bssh:ApiDefinitionShape reports its absence
## at sh:Warning rather than sh:Violation because an EA-level lift may legitimately keep only
## the type and a source location and drop the body. The stubs below are trimmed to the
## envelope for readability; a real catalogue carries the whole document.

:PaymentsAPI
    a              bs:API ;
    bs:name        "payments-api" ;
    bs:apiType     bs:OpenAPI ;
    skos:prefLabel "Payments API (OpenAPI)"@en ;
    skos:definition "REST API for payment initiation, status, and refunds. OpenAPI 3.1 spec."@en ;
    bs:definition  '''openapi: 3.1.0
info:
  title: Payments API
  version: "2.4.0"
servers:
  - url: https://api.example.com/payments/v2
paths:
  /payments: { post: { summary: Initiate a payment } }
  /payments/{id}: { get: { summary: Retrieve payment status } }
  /payments/{id}/refunds: { post: { summary: Refund a payment } }''' ;
.

:MerchantAPI
    a              bs:API ;
    bs:name        "merchant-api" ;
    bs:apiType     bs:OpenAPI ;
    skos:prefLabel "Merchant API (OpenAPI)"@en ;
    skos:definition "REST API for merchant account management and configuration."@en ;
    bs:definition  '''openapi: 3.1.0
info:
  title: Merchant API
  version: "1.9.0"
servers:
  - url: https://api.example.com/merchants/v1
paths:
  /merchants: { get: { summary: List merchants } }
  /merchants/{id}: { get: { summary: Retrieve a merchant } }''' ;
.

:PaymentEventsAPI
    a              bs:API ;
    bs:name        "payment-events" ;
    bs:apiType     bs:AsyncAPI ;
    skos:prefLabel "Payment Events (AsyncAPI)"@en ;
    skos:definition "Kafka-based event stream for payment lifecycle events. AsyncAPI 2.6 spec."@en ;
    bs:definition  '''asyncapi: 2.6.0
info:
  title: Payment Events
  version: "1.2.0"
servers:
  events: { url: kafka.example.com:9092, protocol: kafka }
channels:
  payment.authorised: { subscribe: { message: { name: PaymentAuthorised } } }
  payment.settled:    { subscribe: { message: { name: PaymentSettled } } }''' ;
.

:FraudScoringAPI
    a              bs:API ;
    bs:name        "fraud-scoring" ;
    bs:apiType     bs:GRPC ;
    skos:prefLabel "Fraud Scoring API (gRPC)"@en ;
    skos:definition "Low-latency gRPC API for real-time transaction fraud scoring."@en ;
    bs:definition  '''syntax = "proto3";
package payflow.fraud.v1;

service FraudScoring {
  rpc Score (ScoreRequest) returns (ScoreResponse);
}

message ScoreRequest  { string transaction_id = 1; int64 amount_minor = 2; string currency = 3; }
message ScoreResponse { float risk_score = 1; bool decline = 2; }''' ;
.


#################################################################
# Resources
#################################################################

:PaymentsDB
    a              bs:Resource ;
    bs:name        "payments-db" ;
    bs:resourceType bs:DatabaseResourceType ;
    skos:prefLabel "payments-db (PostgreSQL)"@en ;
    skos:definition "Primary PostgreSQL database for payment transactions and state."@en ;
.

:MerchantDB
    a              bs:Resource ;
    bs:name        "merchant-db" ;
    bs:resourceType bs:DatabaseResourceType ;
    skos:prefLabel "merchant-db (PostgreSQL)"@en ;
    skos:definition "PostgreSQL database for merchant accounts and configuration."@en ;
.

:EventBus
    a              bs:Resource ;
    bs:name        "event-bus" ;
    bs:resourceType :MessageBrokerResourceType ;
    skos:prefLabel "event-bus (Kafka)"@en ;
    skos:definition "Apache Kafka cluster for event streaming between services."@en ;
.

:RedisCache
    a              bs:Resource ;
    bs:name        "redis-cache" ;
    bs:resourceType :CacheResourceType ;
    skos:prefLabel "redis-cache"@en ;
    skos:definition "Redis cluster for session caching and rate limiting."@en ;
.


#################################################################
# Relationships — Ownership
#################################################################

:PaymentProcessor bs:ownedBy :PaymentsSquad .
:PaymentProcessor bs:qualifiedOwnership :qr-PaymentProcessor-ownedBy-PaymentsSquad .
:qr-PaymentProcessor-ownedBy-PaymentsSquad a bs:Ownership ;
    arch:source :PaymentProcessor ; arch:target :PaymentsSquad ;
    rdf:reifies <<( :PaymentProcessor bs:ownedBy :PaymentsSquad )>> .
:FraudService bs:ownedBy :PaymentsSquad .
:FraudService bs:qualifiedOwnership :qr-FraudService-ownedBy-PaymentsSquad .
:qr-FraudService-ownedBy-PaymentsSquad a bs:Ownership ;
    arch:source :FraudService ; arch:target :PaymentsSquad ;
    rdf:reifies <<( :FraudService bs:ownedBy :PaymentsSquad )>> .
:PayoutService bs:ownedBy :PaymentsSquad .
:PayoutService bs:qualifiedOwnership :qr-PayoutService-ownedBy-PaymentsSquad .
:qr-PayoutService-ownedBy-PaymentsSquad a bs:Ownership ;
    arch:source :PayoutService ; arch:target :PaymentsSquad ;
    rdf:reifies <<( :PayoutService bs:ownedBy :PaymentsSquad )>> .
:MerchantOnboarding bs:ownedBy :MerchantSquad .
:MerchantOnboarding bs:qualifiedOwnership :qr-MerchantOnboarding-ownedBy-MerchantSquad .
:qr-MerchantOnboarding-ownedBy-MerchantSquad a bs:Ownership ;
    arch:source :MerchantOnboarding ; arch:target :MerchantSquad ;
    rdf:reifies <<( :MerchantOnboarding bs:ownedBy :MerchantSquad )>> .
:ReportingService bs:ownedBy :MerchantSquad .
:ReportingService bs:qualifiedOwnership :qr-ReportingService-ownedBy-MerchantSquad .
:qr-ReportingService-ownedBy-MerchantSquad a bs:Ownership ;
    arch:source :ReportingService ; arch:target :MerchantSquad ;
    rdf:reifies <<( :ReportingService bs:ownedBy :MerchantSquad )>> .
:WebhookDispatcher bs:ownedBy :PlatformTeam .
:WebhookDispatcher bs:qualifiedOwnership :qr-WebhookDispatcher-ownedBy-PlatformTeam .
:qr-WebhookDispatcher-ownedBy-PlatformTeam a bs:Ownership ;
    arch:source :WebhookDispatcher ; arch:target :PlatformTeam ;
    rdf:reifies <<( :WebhookDispatcher bs:ownedBy :PlatformTeam )>> .
:PaymentGateway bs:ownedBy :PaymentsSquad .
:PaymentGateway bs:qualifiedOwnership :qr-PaymentGateway-ownedBy-PaymentsSquad .
:qr-PaymentGateway-ownedBy-PaymentsSquad a bs:Ownership ;
    arch:source :PaymentGateway ; arch:target :PaymentsSquad ;
    rdf:reifies <<( :PaymentGateway bs:ownedBy :PaymentsSquad )>> .
:MerchantPortal bs:ownedBy :MerchantSquad .
:MerchantPortal bs:qualifiedOwnership :qr-MerchantPortal-ownedBy-MerchantSquad .
:qr-MerchantPortal-ownedBy-MerchantSquad a bs:Ownership ;
    arch:source :MerchantPortal ; arch:target :MerchantSquad ;
    rdf:reifies <<( :MerchantPortal bs:ownedBy :MerchantSquad )>> .
:ObservabilityPlatform bs:ownedBy :SRETeam .
:ObservabilityPlatform bs:qualifiedOwnership :qr-ObservabilityPlatform-ownedBy-SRETeam .
:qr-ObservabilityPlatform-ownedBy-SRETeam a bs:Ownership ;
    arch:source :ObservabilityPlatform ; arch:target :SRETeam ;
    rdf:reifies <<( :ObservabilityPlatform bs:ownedBy :SRETeam )>> .


