#################################################################
# Relationships — Domain Membership
#################################################################

:PaymentGateway bs:belongsToDomain :PaymentsDomain .
:PaymentGateway bs:qualifiedDomainMembership :qr-PaymentGateway-belongsToDomain-PaymentsDomain .
:qr-PaymentGateway-belongsToDomain-PaymentsDomain a bs:DomainMembership ;
    arch:source :PaymentGateway ; arch:target :PaymentsDomain ;
    rdf:reifies <<( :PaymentGateway bs:belongsToDomain :PaymentsDomain )>> .
:MerchantPortal bs:belongsToDomain :MerchantDomain .
:MerchantPortal bs:qualifiedDomainMembership :qr-MerchantPortal-belongsToDomain-MerchantDomain .
:qr-MerchantPortal-belongsToDomain-MerchantDomain a bs:DomainMembership ;
    arch:source :MerchantPortal ; arch:target :MerchantDomain ;
    rdf:reifies <<( :MerchantPortal bs:belongsToDomain :MerchantDomain )>> .
:ObservabilityPlatform bs:belongsToDomain :PlatformDomain .
:ObservabilityPlatform bs:qualifiedDomainMembership :qr-ObservabilityPlatform-belongsToDomain-PlatformDomain .
:qr-ObservabilityPlatform-belongsToDomain-PlatformDomain a bs:DomainMembership ;
    arch:source :ObservabilityPlatform ; arch:target :PlatformDomain ;
    rdf:reifies <<( :ObservabilityPlatform bs:belongsToDomain :PlatformDomain )>> .


#################################################################
# Templates (kind: Template)
#
# Note the apiVersion, and note WHICH source it comes from. Template
# is the one kind that is not part of the catalog model: the
# scaffolder plugin owns it and versions it separately, so it sits on
# scaffolder.backstage.io/v1beta3 while every other entity above is
# on backstage.io/v1alpha1. That is why bs:apiVersion is retained per
# entity rather than assumed constant across a catalogue.
#
#   Template.v1beta3.schema.json  ->  scaffolder.backstage.io/v1beta3   (used here)
#   descriptor format page        ->  backstage.io/v1beta2              (stale)
#
# The schema is what the catalogue enforces. See the scope note on
# bs:Template.
#
# spec.type is bs:componentType, not a vocabulary of its own: a
# template's type names the kind of component it CREATES, and the
# descriptor format says it should match that component's own type.
# So :NewServiceTemplate produces services, and the services below
# that were scaffolded from it agree.
#
# spec.lifecycle is declared on Template by the schema, though the
# rendered documentation does not mention the field.
#################################################################

:NewServiceTemplate
    a                  bs:Template ;
    bs:apiVersion      "scaffolder.backstage.io/v1beta3" ;
    bs:kind            "Template" ;
    bs:name            "new-payment-service" ;
    bs:componentType   bs:ServiceType ;
    bs:lifecycleState  bs:Production ;
    bs:timeSaved       "PT6H"^^xsd:duration ;
    skos:prefLabel     "new-payment-service"@en ;
    skos:definition    "Scaffolder template for a new payment-domain backend service: repository, CI pipeline, TechDocs skeleton, and catalog-info.yaml."@en ;
.

:LibraryTemplate
    a                  bs:Template ;
    bs:apiVersion      "scaffolder.backstage.io/v1beta3" ;
    bs:kind            "Template" ;
    bs:name            "shared-library" ;
    bs:componentType   bs:LibraryType ;
    bs:lifecycleState  bs:Experimental ;
    bs:timeSaved       "PT2H30M"^^xsd:duration ;
    skos:prefLabel     "shared-library"@en ;
    skos:definition    "Scaffolder template for a shared internal library, wired to the internal package registry."@en ;
.

:NewServiceTemplate bs:ownedBy :PlatformTeam .
:NewServiceTemplate bs:qualifiedOwnership :qr-NewServiceTemplate-ownedBy-PlatformTeam .
:qr-NewServiceTemplate-ownedBy-PlatformTeam a bs:Ownership ;
    arch:source :NewServiceTemplate ; arch:target :PlatformTeam ;
    rdf:reifies <<( :NewServiceTemplate bs:ownedBy :PlatformTeam )>> .
:LibraryTemplate    bs:ownedBy :PlatformTeam .
:LibraryTemplate bs:qualifiedOwnership :qr-LibraryTemplate-ownedBy-PlatformTeam .
:qr-LibraryTemplate-ownedBy-PlatformTeam a bs:Ownership ;
    arch:source :LibraryTemplate ; arch:target :PlatformTeam ;
    rdf:reifies <<( :LibraryTemplate bs:ownedBy :PlatformTeam )>> .


#################################################################
# Relationships — Scaffolding (backstage.io/source-template)
#
# Both forms, deliberately. bs:sourceTemplate keeps the annotation
# literal the catalogue wrote; bs:scaffoldedFrom is the resolved
# edge. Neither is derived from the other — see the scope notes on
# both properties.
#
# What the pair buys is the governance question in both directions:
# which services came from the approved template, and — the half
# that needs the relation rather than the literal — which came from
# none. :WebhookDispatcher and :FraudModelScorer predate the
# template and carry neither, which is the answer to the second.
#################################################################

:PayoutService
    bs:sourceTemplate  "template:default/new-payment-service" ;
    bs:scaffoldedFrom  :NewServiceTemplate ;
.

:PayoutService bs:qualifiedScaffolding :qr-PayoutService-scaffoldedFrom-NewServiceTemplate .
:qr-PayoutService-scaffoldedFrom-NewServiceTemplate a bs:Scaffolding ;
    arch:source :PayoutService ; arch:target :NewServiceTemplate ;
    rdf:reifies <<( :PayoutService bs:scaffoldedFrom :NewServiceTemplate )>> .

:ReportingService
    bs:sourceTemplate  "template:default/new-payment-service" ;
    bs:scaffoldedFrom  :NewServiceTemplate ;
.

:ReportingService bs:qualifiedScaffolding :qr-ReportingService-scaffoldedFrom-NewServiceTemplate .
:qr-ReportingService-scaffoldedFrom-NewServiceTemplate a bs:Scaffolding ;
    arch:source :ReportingService ; arch:target :NewServiceTemplate ;
    rdf:reifies <<( :ReportingService bs:scaffoldedFrom :NewServiceTemplate )>> .

## An edge whose resource carries metadata (P-4, P-7): the direct triple, the qualified
## predicate and the resource, which records the scaffolding date — a fact about the EVENT,
## not about either entity.
:MerchantOnboarding
    bs:sourceTemplate          "template:default/new-payment-service" ;
    bs:scaffoldedFrom          :NewServiceTemplate ;
    bs:qualifiedScaffolding :Scaffolding-MerchantOnboarding ;
.

:Scaffolding-MerchantOnboarding
    a               bs:Scaffolding ;
    arch:source     :MerchantOnboarding ;
    arch:target     :NewServiceTemplate ;
    rdf:reifies     <<( :MerchantOnboarding bs:scaffoldedFrom :NewServiceTemplate )>> ;
    skos:prefLabel  "merchant-onboarding scaffolded from new-payment-service"@en ;
    dcterms:created "2025-03-14"^^xsd:date ;
.

## An unresolved reference: the annotation names a template this pull did not include,
## so the literal is retained and no edge is asserted. A consumer can tell the difference
## between "not scaffolded" and "scaffolded from something we cannot see".
:FraudService
    bs:sourceTemplate  "template:default/legacy-ml-service" ;
.


#################################################################
# Status (read-only, from the catalog API)
#
# Only a lift of the catalog API produces these; an authored
# descriptor has no status key. One node per item, because two
# items flattened onto the entity would leave two levels and two
# messages with nothing pairing them.
#
# Read the error item the right way round. Where the type is
# backstage.io/catalog-processing, an error means the catalogue
# could NOT ingest the source and has deliberately kept the last
# version that did — so the item says the record beside it is
# stale, not that the record is wrong.
#################################################################

:ReportingService bs:hasStatusItem :ReportingServiceStatus-1 .

:ReportingServiceStatus-1
    a                bs:StatusItem ;
    bs:statusType    "backstage.io/catalog-processing" ;
    bs:statusLevel   bs:ErrorLevel ;
    bs:statusMessage "NotFoundError: catalog-info.yaml not found at refs/heads/main" ;
.

:WebhookDispatcher bs:hasStatusItem :WebhookDispatcherStatus-1 .

:WebhookDispatcherStatus-1
    a                bs:StatusItem ;
    bs:statusType    "backstage.io/catalog-processing" ;
    bs:statusLevel   bs:WarningLevel ;
    bs:statusMessage "Entity has no spec.owner; owner was inferred from CODEOWNERS" ;
.

## Two items on one entity, from two different systems — the case that makes a node per
## item necessary rather than tidy.
:PaymentProcessor bs:hasStatusItem :PaymentProcessorStatus-1, :PaymentProcessorStatus-2 .

:PaymentProcessorStatus-1
    a                bs:StatusItem ;
    bs:statusType    "backstage.io/catalog-processing" ;
    bs:statusLevel   bs:InfoLevel ;
    bs:statusMessage "Entity refreshed from url:https://git.example.com/payflow/payment-processor" ;
.

:PaymentProcessorStatus-2
    a                bs:StatusItem ;
    bs:statusType    "example.com/slo-checker" ;
    bs:statusLevel   bs:WarningLevel ;
    bs:statusMessage "Error budget for the current window is 8% remaining" ;
.


#################################################################
# Labels — one predicate per key, in PayFlow's own namespace
#
# The pattern bs:label documents. The keys are PayFlow's, so the
# predicates are PayFlow's; bs:label is the parent, which keeps
# "every label on this entity" a one-triple query without anyone
# minting terms in the bs: namespace.
#################################################################

:tier
    a                  owl:DatatypeProperty ;
    rdfs:subPropertyOf bs:label ;
    skos:prefLabel     "Tier"@en ;
    skos:definition    "PayFlow's criticality banding, from the label key example.com/tier."@en ;
.

:pciScope
    a                  owl:DatatypeProperty ;
    rdfs:subPropertyOf bs:label ;
    skos:prefLabel     "PCI Scope"@en ;
    skos:definition    "Whether the entity is in scope for PCI DSS assessment, from the label key example.com/pci-scope."@en ;
.

:PaymentProcessor :tier "gold" ; :pciScope "true" .
:FraudService     :tier "gold" ; :pciScope "true" .
:PayoutService    :tier "gold" ; :pciScope "true" .
:ReportingService :tier "bronze" ; :pciScope "false" .


#################################################################
# Views
#################################################################

:PayFlowServiceCatalogView
    a                            arch:View ;
    skos:prefLabel               "PayFlow Service Catalog"@en ;
    arch:viewConformsToViewpoint <https://meta.linked.archi/backstage/viewpoints#ServiceCatalog> ;
.

:PayFlowAPIDependencyView
    a                            arch:View ;
    skos:prefLabel               "PayFlow API Dependency Map"@en ;
    arch:viewConformsToViewpoint <https://meta.linked.archi/backstage/viewpoints#APIDependency> ;
.

:PayFlowOwnershipView
    a                            arch:View ;
    skos:prefLabel               "PayFlow Ownership Matrix"@en ;
    arch:viewConformsToViewpoint <https://meta.linked.archi/backstage/viewpoints#OwnershipMatrix> ;
.
