@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix c4not:   <https://meta.linked.archi/c4/notation#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix :        <https://meta.linked.archi/c4/presentation-contexts#> .

#################################################################
# C4 Presentation Contexts
#################################################################

:C4PresentationContexts
    a                skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/c4/presentation-contexts#" ;
    vann:preferredNamespacePrefix "c4pc" ;
    dcterms:title                 "Linked.Archi C4 Presentation Contexts"@en ;
    owl:versionInfo               "0.1.0"@en ;
    skos:prefLabel   "C4 Presentation Contexts"@en ;
    dcterms:description  '''Stakeholder-specific rendering themes for C4 diagrams. Each context
links to a NotationSet via arch:usesNotationSet to drive context-aware palette
generation and diagram rendering.'''@en ;
    dcterms:description   "Stakeholder-specific presentation contexts for C4 architecture views."@en ;
    dcterms:creator  "Kalin Maldzhanski"^^xsd:string ;
    skos:hasTopConcept :ProductOwnerContext, :DevTeamContext, :PlatformTeamContext ;
.

:ProductOwnerContext
    a skos:Concept ; skos:topConceptOf :C4PresentationContexts ;
    skos:prefLabel "Product Owner / Business"@en ;
    skos:definition '''System Context level only. Simplified boxes, no technology labels.
Focus on users, external systems, and value flows.'''@en ;
    arch:usesNotationSet c4not:C4StandardNotation ;
    skos:inScheme :C4PresentationContexts ;
.

:DevTeamContext
    a skos:Concept ; skos:topConceptOf :C4PresentationContexts ;
    skos:prefLabel "Development Team"@en ;
    skos:definition '''Container and Component levels. Full technology labels, API details,
data stores, message flows. Standard C4 notation.'''@en ;
    arch:usesNotationSet c4not:C4StandardNotation ;
    skos:inScheme :C4PresentationContexts ;
.

:PlatformTeamContext
    a skos:Concept ; skos:topConceptOf :C4PresentationContexts ;
    skos:prefLabel "Platform / DevOps Team"@en ;
    skos:definition '''Deployment diagrams with infrastructure details — cloud regions,
Kubernetes clusters, load balancers, databases. Operational annotations
(scaling, monitoring, SLAs).'''@en ;
    arch:usesNotationSet c4not:C4StandardNotation ;
    skos:inScheme :C4PresentationContexts ;
.
