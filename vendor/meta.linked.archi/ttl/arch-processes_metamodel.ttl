@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix :        <https://meta.linked.archi/arch-processes/metamodel#> .

<https://meta.linked.archi/arch-processes/metamodel#>
    a                             owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/arch-processes/metamodel#" ;
    vann:preferredNamespacePrefix "apmm" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi Architecture Processes Metamodel Definition"@en ;
    dcterms:description           '''Metamodel manifest for the Architecture Processes extension. Ties together
the process ontology, the relationship types that draw its links, the SKOS taxonomy and the SHACL shapes
into a single discoverable resource. Designed to be added beside a modelling language: a governance
process is modelled next to the architecture it governs.'''@en ;
    dcterms:created               "2026-11-16"^^xsd:date ;
    dcterms:modified              "2026-11-16"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/arch-processes/metamodel/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
.

:ArchitectureProcesses
    a                             arch:Metamodel ;
    skos:prefLabel                "Architecture Processes Metamodel"@en ;
    dcterms:description           '''The Architecture Processes metamodel definition, aggregating the process
ontology — processes, activities, tasks, milestones, deliverables and roles, and the lifecycle stages —
the relationship types that draw the links between them and to the architecture, the SKOS taxonomy and
the SHACL shapes.'''@en ;
    arch:modelConcepts            <https://meta.linked.archi/arch-processes#> ;
    arch:conceptClassification    <https://meta.linked.archi/arch-processes/tax#> ;
    arch:formalRules              <https://meta.linked.archi/arch-processes-shapes#> ;
.
