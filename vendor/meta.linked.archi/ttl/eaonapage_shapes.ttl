@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .

@prefix arch:    <https://meta.linked.archi/core#> .
@prefix eaop:    <https://meta.linked.archi/eaonapage/onto#> .
@prefix :        <https://meta.linked.archi/eaonapage/shapes#> .

<https://meta.linked.archi/eaonapage/shapes#>
    rdf:type                      owl:Ontology ;
    owl:imports                   <https://meta.linked.archi/core#> ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/eaonapage/shapes#" ;
    vann:preferredNamespacePrefix "eaopsh" ;
    dcterms:creator               "Kalin Maldzhanski"^^xsd:string ;
    dcterms:title                 "Linked.Archi EA on a Page SHACL Shapes"@en ;
    dcterms:description           '''SHACL validation shapes for the EA on a Page framework. Validates
instances of the six CSVLOD artifact type classes, process structure, governance
arrangements, and maturity stages. Shapes are based on the ontology only — taxonomy
classification is not enforced by SHACL.'''@en ;
    dcterms:created               "2026-05-03"^^xsd:date ;
    dcterms:modified              "2026-05-03"^^xsd:date ;
    dcterms:publisher             "Linked.Archi"@en, <https://linked.archi> ;
    bibo:status                   "draft" ;
    owl:versionIRI                <https://meta.linked.archi/eaonapage/shapes/0.1.0#> ;
    owl:versionInfo               "0.1.0"@en ;
    prov:wasDerivedFrom           "EA on a Page (Svyatoslav Kotusev, 2017)" ;
    rdfs:seeAlso                  <https://eaonapage.com/> ;
.


## ═══════════════════════════════════════════════════════════════════════════════
## Artifact Shapes — validate instances of the 6 CSVLOD classes
##
## Every artifact instance must have a label and a process linkage.
## ═══════════════════════════════════════════════════════════════════════════════

:ConsiderationShape
    a              sh:NodeShape ;
    sh:targetClass eaop:Consideration ;
    skos:prefLabel "Consideration Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every Consideration must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path        eaop:usedInProcess ;
        sh:hasValue    eaop:StrategicPlanning ;
        sh:message     "Considerations must be linked to the Strategic Planning process."@en ;
    ] ;
.

:StandardShape
    a              sh:NodeShape ;
    sh:targetClass eaop:Standard ;
    skos:prefLabel "Standard Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every Standard must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path        eaop:usedInProcess ;
        sh:hasValue    eaop:TechnologyOptimization ;
        sh:message     "Standards must be linked to the Technology Optimization process."@en ;
    ] ;
.

:VisionShape
    a              sh:NodeShape ;
    sh:targetClass eaop:Vision ;
    skos:prefLabel "Vision Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every Vision must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path        eaop:usedInProcess ;
        sh:hasValue    eaop:StrategicPlanning ;
        sh:message     "Visions must be linked to the Strategic Planning process."@en ;
    ] ;
.

:LandscapeShape
    a              sh:NodeShape ;
    sh:targetClass eaop:Landscape ;
    skos:prefLabel "Landscape Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every Landscape must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path        eaop:usedInProcess ;
        sh:hasValue    eaop:TechnologyOptimization ;
        sh:message     "Landscapes must be linked to the Technology Optimization process."@en ;
    ] ;
.

:OutlineShape
    a              sh:NodeShape ;
    sh:targetClass eaop:Outline ;
    skos:prefLabel "Outline Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every Outline must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path        eaop:usedInProcess ;
        sh:hasValue    eaop:InitiativeDelivery ;
        sh:message     "Outlines must be linked to the Initiative Delivery process."@en ;
    ] ;
.

:DesignShape
    a              sh:NodeShape ;
    sh:targetClass eaop:Design ;
    skos:prefLabel "Design Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every Design must have at least one skos:prefLabel."@en ;
    ] ;
    sh:property [
        sh:path        eaop:usedInProcess ;
        sh:hasValue    eaop:InitiativeDelivery ;
        sh:message     "Designs must be linked to the Initiative Delivery process."@en ;
    ] ;
.


## ═══════════════════════════════════════════════════════════════════════════════
## Governance Shapes
## ═══════════════════════════════════════════════════════════════════════════════

:GovernanceBodyShape
    a              sh:NodeShape ;
    sh:targetClass eaop:GovernanceBody ;
    skos:prefLabel "Governance Body Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every governance body must have at least one skos:prefLabel."@en ;
    ] ;
.

:ArchitectureTierShape
    a              sh:NodeShape ;
    sh:targetClass eaop:ArchitectureTier ;
    skos:prefLabel "Architecture Tier Shape"@en ;
    sh:property [
        sh:path        eaop:tierLevel ;
        sh:minCount    1 ;
        sh:maxCount    1 ;
        sh:datatype    xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 3 ;
        sh:message     "Architecture tier level must be an integer between 1 and 3."@en ;
    ] ;
.

:NoSelfEscalationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf eaop:escalatesTo ;
    skos:prefLabel "No Self-Escalation Shape"@en ;
    sh:sparql [
        sh:message "A governance body cannot escalate to itself."@en ;
        sh:select "SELECT $this WHERE { $this <https://meta.linked.archi/eaonapage/onto#escalatesTo> $this . }" ;
    ] ;
.


## ═══════════════════════════════════════════════════════════════════════════════
## Maturity Stage Shapes
## ═══════════════════════════════════════════════════════════════════════════════

:MaturityStageShape
    a              sh:NodeShape ;
    sh:targetClass eaop:MaturityStage ;
    skos:prefLabel "Maturity Stage Shape"@en ;
    sh:property [
        sh:path        skos:prefLabel ;
        sh:minCount    1 ;
        sh:datatype    rdf:langString ;
        sh:message     "Every maturity stage must have at least one skos:prefLabel."@en ;
    ] ;
.
