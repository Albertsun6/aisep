@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix amnot:   <https://meta.linked.archi/archimate3/notation#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix :        <https://meta.linked.archi/archimate3/presentation-contexts#> .

#################################################################
# Presentation Context Scheme
#
# Stakeholder-specific rendering themes. Each context selects
# appropriate visual notations, abstraction levels, and
# terminology for a target audience.
#
# Each context links to a NotationSet via arch:usesNotationSet
# to specify the visual appearance for that audience. Tools
# follow this link to determine palette rendering.
#################################################################

:ArchiMatePresentationContexts
    a                skos:ConceptScheme ;
    cc:license                    "http://creativecommons.org/licenses/by/4.0/" ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/archimate3/presentation-contexts#" ;
    vann:preferredNamespacePrefix "ampc" ;
    dcterms:title                 "Linked.Archi ArchiMate 3.2 Presentation Contexts"@en ;
    owl:versionInfo               "3.2"@en ;
    skos:prefLabel   "ArchiMate Presentation Contexts"@en ;
    dcterms:description  '''Stakeholder-specific presentation themes for ArchiMate views.
Each context defines the appropriate level of detail, visual notation style,
and terminology for a target audience. Contexts link to NotationSets via
arch:usesNotationSet to drive context-aware palette generation.'''@en ;
    dcterms:description   "Stakeholder-specific presentation contexts for ArchiMate 3.2 architecture views."@en ;
    dcterms:creator  "Kalin Maldzhanski"^^xsd:string ;
    skos:hasTopConcept :ExecutiveContext, :ArchitectContext,
                       :DeveloperContext, :OperationsContext, :GovernanceContext ;
.

:ExecutiveContext
    a skos:Concept ; skos:topConceptOf :ArchiMatePresentationContexts ;
    skos:prefLabel "Executive / C-Level"@en ;
    skos:definition '''High-level overview with minimal technical detail. Focus on
business capabilities, strategic alignment, cost, and risk. Uses simplified
notation with business terminology.'''@en ;
    skos:scopeNote "Uses the standard notation set by default. Organizations may define a simplified notation set and link it here for executive-level views with reduced visual complexity."@en ;
    arch:usesNotationSet amnot:ArchiMate32StandardNotation ;
    skos:inScheme :ArchiMatePresentationContexts ;
.

:ArchitectContext
    a skos:Concept ; skos:topConceptOf :ArchiMatePresentationContexts ;
    skos:prefLabel "Architect"@en ;
    skos:definition '''Full ArchiMate notation with all layers and aspects visible.
Detailed element properties, relationship types, and cross-layer dependencies.
Standard ArchiMate visual notation.'''@en ;
    arch:usesNotationSet amnot:ArchiMate32StandardNotation ;
    skos:inScheme :ArchiMatePresentationContexts ;
.

:DeveloperContext
    a skos:Concept ; skos:topConceptOf :ArchiMatePresentationContexts ;
    skos:prefLabel "Developer / Engineering"@en ;
    skos:definition '''Focus on application and technology layers. Detailed interfaces,
data flows, deployment topology. Technical terminology with API and
infrastructure details.'''@en ;
    arch:usesNotationSet amnot:ArchiMate32StandardNotation ;
    skos:inScheme :ArchiMatePresentationContexts ;
.

:OperationsContext
    a skos:Concept ; skos:topConceptOf :ArchiMatePresentationContexts ;
    skos:prefLabel "Operations / Infrastructure"@en ;
    skos:definition '''Focus on technology layer and deployment. Nodes, devices, networks,
environments, monitoring points. Operational terminology with SLA and
availability details.'''@en ;
    arch:usesNotationSet amnot:ArchiMate32StandardNotation ;
    skos:inScheme :ArchiMatePresentationContexts ;
.

:GovernanceContext
    a skos:Concept ; skos:topConceptOf :ArchiMatePresentationContexts ;
    skos:prefLabel "Governance / Compliance"@en ;
    skos:definition '''Focus on standards compliance, lifecycle states, ownership, and
change management. Highlights gaps, risks, and deviations. Formal
notation with governance metadata.'''@en ;
    arch:usesNotationSet amnot:ArchiMate32StandardNotation ;
    skos:inScheme :ArchiMatePresentationContexts ;
.
