            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
