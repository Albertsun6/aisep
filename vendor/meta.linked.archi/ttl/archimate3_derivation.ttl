            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR4", " ", STR($this), " ", STR(am:specializes), " ", STR(?b), " ", STR(?c), " ", STR(?t), " ", STR($this))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR5-StructuralAndDependencyAtSource
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :PDR5 ;
.

:PDR5
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR5: Dependency to the source of a structural relationship"@en ;
    skos:definition "A structural relationship from a to b and a dependency relationship from c to a: c may have that dependency relationship to b."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source ?c ;
                arch:target ?b ;
                rdf:reifies <<( ?c ?t ?b )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR5 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            VALUES ?t { am:associatedWith am:influences am:accesses am:serves }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?c ?t $this .
            ?_premise2 arch:source ?c ; arch:target $this ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?c ?_leads ?_premise2 } }
            FILTER(?c != ?b)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { ?c ?t ?b }
            FILTER NOT EXISTS { ?_existing arch:source ?c ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?t amrt:permittedBy ?_permits . ?c rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?b rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR5", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?c), " ", STR(?t), " ", STR($this))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR6-StructuralAndDependencyFromSource
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :PDR6 ;
.

:PDR6
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR6: Dependency from the source of a structural relationship"@en ;
    skos:definition "A structural relationship from a to b and a dependency relationship from a to c: b may have that dependency relationship to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source ?b ;
                arch:target ?c ;
                rdf:reifies <<( ?b ?t ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR6 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            VALUES ?t { am:associatedWith am:influences am:accesses am:serves }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            $this ?t ?c .
            ?_premise2 arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise2 } }
            FILTER(?b != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { ?b ?t ?c }
            FILTER NOT EXISTS { ?_existing arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?t amrt:permittedBy ?_permits . ?b rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR6", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR($this), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR7-DerivationBetweenDependencyRelationships
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :PDR7 ;
.

:PDR7
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR7: Derivation between dependency relationships"@en ;
    skos:definition "Two dependency relationships in line — from a to b and from b to c — may give the weaker of the two from a to c. Dependency strength, weakest first: association, influence, access, serving."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this ?u ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR7 .
        }
        WHERE {
            VALUES (?s ?sStrength) { (am:associatedWith 1) (am:influences 2) (am:accesses 3) (am:serves 4) }
            VALUES (?t ?tStrength) { (am:associatedWith 1) (am:influences 2) (am:accesses 3) (am:serves 4) }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            BIND(IF(?sStrength <= ?tStrength, ?s, ?t) AS ?u)    # the weaker of the two
            FILTER($this != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { $this ?u ?c }
            FILTER NOT EXISTS { ?_existing arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?u ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?u amrt:permittedBy ?_permits . $this rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?u NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?u != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?u NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?u != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?u NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?u NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?u NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?u != am:associatedWith))
            FILTER(!(?_from = "R" && ?u != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?u = am:influences && ?_to != "M"))
            FILTER(!(?u = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?u NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?u NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?u NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?u ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?u } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR7", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR8-FlowAndStructuralInLine
    a sh:NodeShape ;
    sh:targetSubjectsOf am:flowsTo ;
    sh:rule :PDR8 ;
.

:PDR8
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR8: Flow and a structural relationship, in line"@en ;
    skos:definition "A flow from a to b and a structural relationship from b to c: a may have a flow to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this am:flowsTo ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR8 .
        }
        WHERE {
            VALUES ?t { am:realizes am:assignedTo am:aggregates am:composedOf }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:flowsTo ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:flowsTo .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { $this am:flowsTo ?c }
            FILTER NOT EXISTS { ?_existing arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm am:flowsTo ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { am:flowsTo amrt:permittedBy ?_permits . $this rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && am:flowsTo NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && am:flowsTo != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && am:flowsTo != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && am:flowsTo NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && am:flowsTo NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && am:flowsTo != am:associatedWith))
            FILTER(!(?_from = "R" && am:flowsTo != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(am:flowsTo = am:influences && ?_to != "M"))
            FILTER(!(am:flowsTo = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && am:flowsTo NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && am:flowsTo NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:flowsTo ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:flowsTo } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR8", " ", STR($this), " ", STR(am:flowsTo), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR9-StructuralAndDynamicFromSource
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :PDR9 ;
.

:PDR9
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR9: Dynamic relationship from the source of a structural relationship"@en ;
    skos:definition "A structural relationship from a to b and a dynamic relationship (triggering or flow) from a to c: b may have that dynamic relationship to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source ?b ;
                arch:target ?c ;
                rdf:reifies <<( ?b ?t ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR9 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            VALUES ?t { am:triggers am:flowsTo }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            $this ?t ?c .
            ?_premise2 arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise2 } }
            FILTER(?b != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { ?b ?t ?c }
            FILTER NOT EXISTS { ?_existing arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?t amrt:permittedBy ?_permits . ?b rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR9", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR($this), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR10-DerivationBetweenFlowRelationships
    a sh:NodeShape ;
    sh:targetSubjectsOf am:flowsTo ;
    sh:rule :PDR10 ;
.

:PDR10
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR10: Derivation between flow relationships"@en ;
    skos:definition "A flow from a to b and a flow from b to c: a may have a flow to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this am:flowsTo ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR10 .
        }
        WHERE {
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:flowsTo ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:flowsTo .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b am:flowsTo ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm am:flowsTo .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { $this am:flowsTo ?c }
            FILTER NOT EXISTS { ?_existing arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm am:flowsTo ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { am:flowsTo amrt:permittedBy ?_permits . $this rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && am:flowsTo NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && am:flowsTo != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && am:flowsTo != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && am:flowsTo NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && am:flowsTo NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && am:flowsTo != am:associatedWith))
            FILTER(!(?_from = "R" && am:flowsTo != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(am:flowsTo = am:influences && ?_to != "M"))
            FILTER(!(am:flowsTo = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && am:flowsTo NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && am:flowsTo NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:flowsTo ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:flowsTo } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR10", " ", STR($this), " ", STR(am:flowsTo), " ", STR(?b), " ", STR(?b), " ", STR(am:flowsTo), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR11-TriggeringAndStructuralOpposite
    a sh:NodeShape ;
    sh:targetSubjectsOf am:triggers ;
    sh:rule :PDR11 ;
.

:PDR11
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR11: Triggering and a structural relationship to its target"@en ;
    skos:definition "A triggering relationship from a to b and a structural relationship from c to b: a may trigger c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this am:triggers ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR11 .
        }
        WHERE {
            VALUES ?t { am:realizes am:assignedTo am:aggregates am:composedOf }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:triggers ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:triggers .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?c ?t ?b .
            ?_premise2 arch:source ?c ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?c ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { $this am:triggers ?c }
            FILTER NOT EXISTS { ?_existing arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm am:triggers ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { am:triggers amrt:permittedBy ?_permits . $this rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && am:triggers NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && am:triggers != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && am:triggers != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && am:triggers NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && am:triggers NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && am:triggers != am:associatedWith))
            FILTER(!(?_from = "R" && am:triggers != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(am:triggers = am:influences && ?_to != "M"))
            FILTER(!(am:triggers = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && am:triggers NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && am:triggers NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:triggers ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:triggers } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR11", " ", STR($this), " ", STR(am:triggers), " ", STR(?b), " ", STR(?c), " ", STR(?t), " ", STR(?b))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR12-GroupingMembers
    a sh:NodeShape ;
    sh:targetClass am:Grouping ;
    sh:rule :PDR12 ;
.

:PDR12
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR12: Elements aggregated or composed in a grouping"@en ;
    skos:definition "A grouping b aggregates or is composed of a and has a realization or assignment relationship to c: a may have it to c, where the relationship tables allow it."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source ?a ;
                arch:target ?c ;
                rdf:reifies <<( ?a ?t ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR12 .
        }
        WHERE {
            VALUES ?g { am:aggregates am:composedOf }
            VALUES ?t { am:realizes am:assignedTo }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?g ?a .
            ?_premise1 arch:source $this ; arch:target ?a ; rdf:type/arch:unqualifiedForm ?g .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            $this ?t ?c .
            ?_premise2 arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise2 } }
            FILTER(?a != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { ?a ?t ?c }
            FILTER NOT EXISTS { ?_existing arch:source ?a ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?t amrt:permittedBy ?_permits . ?a rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?a rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?a rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?a rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?a rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?a rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?a rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?a rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR12", " ", STR($this), " ", STR(?g), " ", STR(?a), " ", STR($this), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.


#################################################################
# Checking derivations: Appendix B.4 on what something else derived
#################################################################

:DerivationRestrictions
    a sh:NodeShape ;
    sh:targetSubjectsOf :derivationCertainty ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Appendix B.4 does not allow this derivation: {?value}."@en ;
        sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
        sh:select """
            SELECT $this ?value WHERE {
                $this arch:source ?_a ; arch:target ?_b ; rdf:type/arch:unqualifiedForm ?_relationship .
                FILTER(?_relationship != am:specializes)    # B.4 is not applied to specialization
                OPTIONAL { $this prov:wasDerivedFrom ?_premise1 , ?_premise2 . FILTER(STR(?_premise1) < STR(?_premise2))
                           ?_premise1 arch:source|arch:target ?_via . ?_premise2 arch:source|arch:target ?_via .
                           FILTER(?_via != ?_a && ?_via != ?_b) }
                BIND(IF(EXISTS { ?_a rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?_a rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?_a rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?_a rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?_a rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
                BIND(IF(EXISTS { ?_b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?_b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?_b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?_b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?_b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
                BIND(IF(BOUND(?_via), IF(EXISTS { ?_via rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?_via rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?_via rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?_via rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?_via rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))), ?_unbound) AS ?_through)
                BIND(EXISTS { ?_a rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
                BIND(EXISTS { ?_b rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
                BIND(EXISTS { ?_a rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
                BIND(IF(BOUND(?_via), EXISTS { ?_via rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) }, ?_unbound) AS ?_viaGroups)
                BIND(COALESCE(IF(?_from IN ("I", "C", "S") && ?_to = "M" && ?_relationship NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith), "from Core, Strategy or Implementation and Migration to Motivation, only assignment, realization, influence or association", IF(?_from = "M" && ?_to IN ("I", "C", "S") && ?_relationship != am:associatedWith, "from Motivation to Core, Strategy or Implementation and Migration, only association", IF(?_from IN ("I", "C") && ?_to = "S" && ?_relationship NOT IN (am:realizes, am:associatedWith), "from Core or Implementation and Migration to Strategy, only realization or association", IF(?_from = "S" && ?_to IN ("I", "C") && ?_relationship != am:associatedWith, "from Strategy to Core or Implementation and Migration, only association", IF(?_from = "I" && ?_to = "C" && ?_relationship NOT IN (am:realizes, am:associatedWith), "from Implementation and Migration to Core, only realization or association", IF(?_from = "C" && ?_to = "I" && ?_relationship NOT IN (am:assignedTo, am:associatedWith), "from Core to Implementation and Migration, only assignment or association", IF(?_to = "R" && ?_fromGathers && ?_relationship NOT IN (am:composedOf, am:aggregates, am:associatedWith), "from a grouping, location or plateau to a relationship, only composition, aggregation or association", IF(?_to = "R" && !?_fromGathers && ?_relationship != am:associatedWith, "from any other element to a relationship, only association", IF(?_from = "R" && ?_relationship != am:associatedWith, "from a relationship, only association", IF(?_relationship = am:influences && ?_to != "M", "influence only to Motivation", IF(?_relationship = am:accesses && !?_passiveTo, "access only to passive structure", IF(!?_passiveFrom && ?_passiveTo && ?_relationship NOT IN (am:accesses, am:assignedTo, am:associatedWith), "to passive structure from anything else, only access, assignment or association", IF(?_passiveFrom && ?_passiveTo && ?_relationship NOT IN (am:realizes, am:associatedWith), "between passive structure, only realization or association", IF(?_passiveFrom && !?_passiveTo && ?_relationship NOT IN (am:realizes, am:influences, am:associatedWith), "from passive structure to anything else, only realization, influence or association", IF(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S")), "not through an element of a domain neither end is in (but Core between Implementation and Migration and Motivation or Strategy)", IF(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups, "from Implementation and Migration to Motivation or Strategy, not through a grouping or location", "")))))))))))))))), "") AS ?value)
                FILTER(?value != "")
            }
        """ ;
    ] ;
    skos:prefLabel "Appendix B.4, on derivations"@en ;
    skos:definition "A derivation — a qualified relationship with a :derivationCertainty, whatever derived it — that a restriction of Appendix B.4 rules out, by the domains of its ends, whether they are passive structure, and the element its premises join at. The rules leave such a derivation out; this reports one that something else derived. Specialization is not checked, as the rules do not apply B.4 to it; a junction is in no domain."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
.
