            BIND(SHA1(CONCAT("PDR3", " ", STR($this), " ", STR(am:specializes), " ", STR(?b), " ", STR($this), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
