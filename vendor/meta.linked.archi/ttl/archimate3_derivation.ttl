            FILTER NOT EXISTS { ?c ?t ?b }
            FILTER NOT EXISTS { ?_existing arch:source ?c ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
