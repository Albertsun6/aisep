#################################################################
# Derivation certainty
#################################################################

:derivationCertainty
    a                owl:ObjectProperty ;
    skos:prefLabel   "derivation certainty"@en ;
    skos:definition  "The certainty of a derivation, as the specification distinguishes it: on the resource of a derivation, which reifies the derived triple."@en ;
    skos:scopeNote   "A valid derivation asserts its triple, with its qualified predicate; a potential one reifies its triple without asserting it. A relationship derived both ways has a resource for each derivation, and :Valid wins."@en ;
    rdfs:range       :DerivationCertaintyLevel ;
.

:DerivationCertaintyLevel
    a                owl:Class ;
    skos:prefLabel   "Derivation Certainty Level"@en ;
    skos:definition  "The certainty levels of derived relationships."@en ;
.

:Valid
    a                :DerivationCertaintyLevel ;
    skos:prefLabel   "valid"@en ;
    skos:definition  "Derived by DR1–DR8 from asserted or valid relationships: valid in any model where the rules apply."@en ;
    skos:scopeNote   "A statement: its triple is asserted, with its qualified predicate, and it is a premise for further derivation. Told from what the modeller stated by the graph, in a store (a derivation is kept in .../graph/derived), and by this certainty on its resource."@en ;
.

:Potential
    a                :DerivationCertaintyLevel ;
    skos:prefLabel   "potential"@en ;
    skos:definition  "Derived by PDR1–PDR12 from asserted or valid relationships, where the relationship tables permit it: may hold, depending on the model; for the modeller to confirm."@en ;
    skos:scopeNote   "A proposition: its triple is not asserted, and it is not a premise for further derivation. Confirming one means asserting its triple in the model, with its qualified predicate, and deriving again from what is asserted. The relationship tables of Appendix B.5 count as derived some relationships reached only through a potential one; these rules do not derive them."@en ;
.


#################################################################
# The model's relationships, qualified: before the rules
#################################################################

:QualifyRelationships
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes , am:realizes , am:assignedTo , am:aggregates , am:composedOf , am:associatedWith , am:influences , am:accesses , am:serves , am:triggers , am:flowsTo ;
    sh:order -1 ;
    sh:rule :Qualification ;
.

:Qualification
    a sh:SPARQLRule ;
    skos:prefLabel "Qualify the model's relationships"@en ;
    skos:definition "A relationship the model states only as a direct triple gets a qualified relationship of its class, which reifies it — as a modeller may give it one — so that the rules find each premise as a resource, and a derivation names its premises by them. Its shape runs before the rules' (sh:order -1)."@en ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?o ;
                rdf:reifies <<( $this ?p ?o )>> .
        }
        WHERE {
            VALUES ?p { am:specializes am:realizes am:assignedTo am:aggregates am:composedOf am:associatedWith am:influences am:accesses am:serves am:triggers am:flowsTo }
            $this ?p ?o .
            # None yet: no qualified relationship for it, the modeller's or a derivation's, but a potential one not confirmed.
            FILTER NOT EXISTS { ?_existing arch:source $this ; arch:target ?o ; rdf:type/arch:unqualifiedForm ?p . FILTER NOT EXISTS { ?_existing :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_existing } } }
            # Its class, and an IRI in the model's namespace.
            ?_class arch:unqualifiedForm ?p ; rdfs:subClassOf+ arch:QualifiedRelationship .
            FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?p }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(IRI(CONCAT(?_base, "relationship-", SHA1(CONCAT(STR($this), " ", STR(?p), " ", STR(?o))))) AS ?_resource)
        }
    """ ;
.


#################################################################
# Derivation rules for valid relationships (B.2)
#################################################################

:DR1-TransitivityOfSpecialization
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:rule :DR1 ;
.

:DR1
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR1: Transitivity of specialization"@en ;
    skos:definition "If a is a specialization of b, and b of c, then a is a specialization of c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            $this am:specializes ?c .
            $this ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this am:specializes ?c )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR1 .
        }
        WHERE {
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:specializes ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:specializes .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b am:specializes ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm am:specializes .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { $this am:specializes ?c }
            # Appendix B.4 is not applied to specialization: its restrictions, read literally, would stop one passive structure element specializing another, which the relationship tables permit.
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:specializes ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:specializes } }
            OPTIONAL { ?_qualified arch:unqualifiedForm am:specializes ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR1", " ", STR($this), " ", STR(am:specializes), " ", STR(?b), " ", STR(?b), " ", STR(am:specializes), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR2-DerivationBetweenStructuralRelationships
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :DR2 ;
.

:DR2
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR2: Derivation between structural relationships"@en ;
    skos:definition "Two structural relationships in line — from a to b and from b to c — give the weaker of the two from a to c. Structural strength, weakest first: realization, assignment, aggregation, composition."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            $this ?u ?c .
            $this ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this ?u ?c )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR2 .
        }
        WHERE {
            VALUES (?s ?sStrength) { (am:realizes 1) (am:assignedTo 2) (am:aggregates 3) (am:composedOf 4) }
            VALUES (?t ?tStrength) { (am:realizes 1) (am:assignedTo 2) (am:aggregates 3) (am:composedOf 4) }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            BIND(IF(?sStrength <= ?tStrength, ?s, ?t) AS ?u)    # the weaker of the two
            FILTER($this != ?c)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { $this ?u ?c }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?u NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?u != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?u NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?u != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?u NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?u NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?u NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?u != am:associatedWith))
            FILTER(!(?_from = "R" && ?u != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?u = am:influences && ?_to != "M"))
            FILTER(!(?u = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?u NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?u NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?u NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?u ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?u } }
            OPTIONAL { ?_qualified arch:unqualifiedForm ?u ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR2", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR3-DerivationBetweenStructuralAndDependencyRelationships
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :DR3 ;
.

:DR3
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR3: Derivation between structural and dependency relationships"@en ;
    skos:definition "A structural relationship from a to b and a dependency relationship from b to c give that dependency relationship from a to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            $this ?t ?c .
            $this ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this ?t ?c )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR3 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            VALUES ?t { am:associatedWith am:influences am:accesses am:serves }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { $this ?t ?c }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { ?_qualified arch:unqualifiedForm ?t ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR3", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR4-DerivationBetweenOpposingStructuralAndDependencyRelationships
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :DR4 ;
.

:DR4
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR4: Derivation between opposing structural and dependency relationships"@en ;
    skos:definition "A structural relationship from a to b and a dependency relationship from c to b give that dependency relationship from c to a."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?c ?t $this .
            ?c ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source ?c ;
                arch:target $this ;
                rdf:reifies <<( ?c ?t $this )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR4 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            VALUES ?t { am:associatedWith am:influences am:accesses am:serves }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?c ?t ?b .
            ?_premise2 arch:source ?c ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?c ?_leads ?_premise2 } }
            FILTER(?c != $this)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { ?c ?t $this }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { ?_qualified arch:unqualifiedForm ?t ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR4", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?c), " ", STR(?t), " ", STR(?b))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR5-DerivationBetweenStructuralAndDynamicRelationships
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :DR5 ;
.

:DR5
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR5: Derivation between structural and dynamic relationships"@en ;
    skos:definition "A structural relationship from a to b and a dynamic relationship (triggering or flow) from b to c give that dynamic relationship from a to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            $this ?t ?c .
            $this ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this ?t ?c )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR5 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            VALUES ?t { am:triggers am:flowsTo }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { $this ?t ?c }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { ?_qualified arch:unqualifiedForm ?t ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR5", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR6-DerivationBetweenStructuralAndFlowRelationships
    a sh:NodeShape ;
    sh:targetClass arch:ModelConcept ;
    sh:rule :DR6 ;
.

:DR6
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR6: Derivation between structural and flow relationships"@en ;
    skos:definition "A structural relationship from a to b and a flow from c to b give a flow from c to a."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?c am:flowsTo $this .
            ?c ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source ?c ;
                arch:target $this ;
                rdf:reifies <<( ?c am:flowsTo $this )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR6 .
        }
        WHERE {
            VALUES ?s { am:realizes am:assignedTo am:aggregates am:composedOf }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this ?s ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?s .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?c am:flowsTo ?b .
            ?_premise2 arch:source ?c ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:flowsTo .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?c ?_leads ?_premise2 } }
            FILTER(?c != $this)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { ?c am:flowsTo $this }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && am:flowsTo NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && am:flowsTo != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && am:flowsTo != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && am:flowsTo NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && am:flowsTo NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && am:flowsTo != am:associatedWith))
            FILTER(!(?_from = "R" && am:flowsTo != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(am:flowsTo = am:influences && ?_to != "M"))
            FILTER(!(am:flowsTo = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && am:flowsTo NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && am:flowsTo NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && am:flowsTo NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:flowsTo ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:flowsTo } }
            OPTIONAL { ?_qualified arch:unqualifiedForm am:flowsTo ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR6", " ", STR($this), " ", STR(?s), " ", STR(?b), " ", STR(?c), " ", STR(am:flowsTo), " ", STR(?b))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR7-DerivationBetweenStructuralAndTriggeringRelationships
    a sh:NodeShape ;
    sh:targetSubjectsOf am:triggers ;
    sh:rule :DR7 ;
.

:DR7
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR7: Derivation between structural and triggering relationships"@en ;
    skos:definition "A triggering relationship from a to b and a structural relationship from b to c give a triggering relationship from a to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            $this am:triggers ?c .
            $this ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this am:triggers ?c )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR7 .
        }
        WHERE {
            VALUES ?t { am:realizes am:assignedTo am:aggregates am:composedOf }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:triggers ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:triggers .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { $this am:triggers ?c }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && am:triggers NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && am:triggers != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && am:triggers != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && am:triggers NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && am:triggers NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && am:triggers != am:associatedWith))
            FILTER(!(?_from = "R" && am:triggers != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(am:triggers = am:influences && ?_to != "M"))
            FILTER(!(am:triggers = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && am:triggers NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && am:triggers NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:triggers ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:triggers } }
            OPTIONAL { ?_qualified arch:unqualifiedForm am:triggers ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR7", " ", STR($this), " ", STR(am:triggers), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:DR8-DerivationBetweenTriggeringRelationships
    a sh:NodeShape ;
    sh:targetSubjectsOf am:triggers ;
    sh:rule :DR8 ;
.

:DR8
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "DR8: Derivation between triggering relationships"@en ;
    skos:definition "Triggering is transitive: a triggers b and b triggers c give a triggers c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            $this am:triggers ?c .
            $this ?_qualified ?_resource .
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this am:triggers ?c )>> ;
                :derivationCertainty :Valid ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :DR8 .
        }
        WHERE {
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:triggers ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:triggers .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b am:triggers ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm am:triggers .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: its triple is not asserted. There only as potential, a valid derivation makes it valid.
            FILTER NOT EXISTS { $this am:triggers ?c }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && am:triggers NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && am:triggers != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && am:triggers != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && am:triggers NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && am:triggers NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && am:triggers != am:associatedWith))
            FILTER(!(?_from = "R" && am:triggers != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(am:triggers = am:influences && ?_to != "M"))
            FILTER(!(am:triggers = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && am:triggers NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && am:triggers NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && am:triggers NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm am:triggers ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm am:triggers } }
            OPTIONAL { ?_qualified arch:unqualifiedForm am:triggers ; rdfs:range ?_class }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("DR8", " ", STR($this), " ", STR(am:triggers), " ", STR(?b), " ", STR(?b), " ", STR(am:triggers), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.


#################################################################
# Derivation rules for potential relationships (B.3)
#################################################################

:PDR1-SpecializationAndOtherRelationshipInLine
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:rule :PDR1 ;
.

:PDR1
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR1: Specialization and another relationship, in line"@en ;
    skos:definition "a is a specialization of b and b has a structural, dependency or dynamic relationship to c: a may have it to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source $this ;
                arch:target ?c ;
                rdf:reifies <<( $this ?t ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR1 .
        }
        WHERE {
            VALUES ?t { am:realizes am:assignedTo am:aggregates am:composedOf am:associatedWith am:influences am:accesses am:serves am:triggers am:flowsTo }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:specializes ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:specializes .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?b ?t ?c .
            ?_premise2 arch:source ?b ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?b ?_leads ?_premise2 } }
            FILTER($this != ?c)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { $this ?t ?c }
            FILTER NOT EXISTS { ?_existing arch:source $this ; arch:target ?c ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?t amrt:permittedBy ?_permits . $this rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . ?c rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR1", " ", STR($this), " ", STR(am:specializes), " ", STR(?b), " ", STR(?b), " ", STR(?t), " ", STR(?c))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR2-SpecializationAndOtherRelationshipOpposite
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:rule :PDR2 ;
.

:PDR2
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR2: Specialization and another relationship, in the opposite direction"@en ;
    skos:definition "a is a specialization of b and c has a structural, dependency or dynamic relationship to b: c may have it to a."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source ?c ;
                arch:target $this ;
                rdf:reifies <<( ?c ?t $this )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
                prov:wasGeneratedBy ?_activity .
            ?_activity a prov:Activity ;
                prov:qualifiedAssociation ?_association .
            ?_association a prov:Association ;
                prov:hadPlan :PDR2 .
        }
        WHERE {
            VALUES ?t { am:realizes am:assignedTo am:aggregates am:composedOf am:associatedWith am:influences am:accesses am:serves am:triggers am:flowsTo }
            # The premises: relationships that hold — their triple is asserted, by the modeller or a valid derivation — not the potential derivation of one, unless the modeller confirmed it.
            $this am:specializes ?b .
            ?_premise1 arch:source $this ; arch:target ?b ; rdf:type/arch:unqualifiedForm am:specializes .
            FILTER NOT EXISTS { ?_premise1 :derivationCertainty :Potential . FILTER NOT EXISTS { $this ?_leads ?_premise1 } }
            ?c ?t ?b .
            ?_premise2 arch:source ?c ; arch:target ?b ; rdf:type/arch:unqualifiedForm ?t .
            FILTER NOT EXISTS { ?_premise2 :derivationCertainty :Potential . FILTER NOT EXISTS { ?c ?_leads ?_premise2 } }
            FILTER(?c != $this)
            # Not there yet: neither asserted nor derived.
            FILTER NOT EXISTS { ?c ?t $this }
            FILTER NOT EXISTS { ?_existing arch:source ?c ; arch:target $this ; rdf:type/arch:unqualifiedForm ?t ; :derivationCertainty ?_certainty }
            # Appendix B.5: the relationship tables permit it from the one element type to the other.
            FILTER EXISTS { ?t amrt:permittedBy ?_permits . ?c rdf:type/rdfs:subClassOf* ?_sourceType . ?_sourceType ?_permits ?_targetType . $this rdf:type/rdfs:subClassOf* ?_targetType }
            # Appendix B.4. Domains: R relationships, M motivation, S strategy, I implementation and migration, C core; J a junction, in none.
            BIND(IF(EXISTS { ?c rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?c rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_from)
            BIND(IF(EXISTS { $this rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { $this rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { $this rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_to)
            BIND(IF(EXISTS { ?b rdf:type/rdfs:subClassOf* arch:QualifiedRelationship }, "R", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_junction . FILTER(?_junction IN (am:Junction_And, am:Junction_Or)) }, "J", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:MotivationElement }, "M", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:StrategyLayerElement }, "S", IF(EXISTS { ?b rdf:type/rdfs:subClassOf* am:ImplementationAndMigrationLayerElement }, "I", "C"))))) AS ?_through)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveFrom)
            BIND(EXISTS { $this rdf:type/rdfs:subClassOf* am:PassiveStructureElement } AS ?_passiveTo)
            BIND(EXISTS { ?c rdf:type/rdfs:subClassOf* ?_fromKind . FILTER(?_fromKind IN (am:Grouping, am:Location, am:Plateau)) } AS ?_fromGathers)
            BIND(EXISTS { ?b rdf:type/rdfs:subClassOf* ?_viaKind . FILTER(?_viaKind IN (am:Grouping, am:Location)) } AS ?_viaGroups)
            # … between domains
            FILTER(!(?_from IN ("I", "C", "S") && ?_to = "M" && ?t NOT IN (am:assignedTo, am:realizes, am:influences, am:associatedWith)))
            FILTER(!(?_from = "M" && ?_to IN ("I", "C", "S") && ?t != am:associatedWith))
            FILTER(!(?_from IN ("I", "C") && ?_to = "S" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "S" && ?_to IN ("I", "C") && ?t != am:associatedWith))
            FILTER(!(?_from = "I" && ?_to = "C" && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_from = "C" && ?_to = "I" && ?t NOT IN (am:assignedTo, am:associatedWith)))
            # … to and from relationships
            FILTER(!(?_to = "R" && ?_fromGathers && ?t NOT IN (am:composedOf, am:aggregates, am:associatedWith)))
            FILTER(!(?_to = "R" && !?_fromGathers && ?t != am:associatedWith))
            FILTER(!(?_from = "R" && ?t != am:associatedWith))
            # … by the kind of relationship and of element
            FILTER(!(?t = am:influences && ?_to != "M"))
            FILTER(!(?t = am:accesses && !?_passiveTo))
            FILTER(!(!?_passiveFrom && ?_passiveTo && ?t NOT IN (am:accesses, am:assignedTo, am:associatedWith)))
            FILTER(!(?_passiveFrom && ?_passiveTo && ?t NOT IN (am:realizes, am:associatedWith)))
            FILTER(!(?_passiveFrom && !?_passiveTo && ?t NOT IN (am:realizes, am:influences, am:associatedWith)))
            # … through an element of a third domain (but Core between I and M or S), or a grouping or location between I and M or S
            FILTER(!(BOUND(?_through) && ?_from != "J" && ?_through != "J" && ?_to != "J" && ?_through != ?_from && ?_through != ?_to && !(?_from = "I" && ?_through = "C" && ?_to IN ("M", "S"))))
            FILTER(!(BOUND(?_viaGroups) && ?_from = "I" && ?_to IN ("M", "S") && ?_viaGroups))
            # The derivation's resource: the relationship's class, and an IRI in the model's namespace;
            # its derivation activity's, and the association naming the rule as its plan, from the same key.
            OPTIONAL { ?_class arch:unqualifiedForm ?t ; rdfs:subClassOf+ arch:QualifiedRelationship . FILTER NOT EXISTS { ?_class rdfs:subClassOf+ ?_general . ?_general arch:unqualifiedForm ?t } }
            OPTIONAL { SELECT (IF(COUNT(DISTINCT ?_namespace) = 1, SAMPLE(?_namespace), "urn:linked-archi:") AS ?_modelNamespace) WHERE { ?_model a arch:Model ; vann:preferredNamespaceUri ?_namespace } }
            BIND(COALESCE(STR(?_modelNamespace), "urn:linked-archi:") AS ?_base)
            BIND(SHA1(CONCAT("PDR2", " ", STR($this), " ", STR(am:specializes), " ", STR(?b), " ", STR(?c), " ", STR(?t), " ", STR(?b))) AS ?_key)
            BIND(IRI(CONCAT(?_base, "derivation-", ?_key)) AS ?_resource)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key)) AS ?_activity)
            BIND(IRI(CONCAT(?_base, "derivation-activity-", ?_key, "-association")) AS ?_association)
        }
    """ ;
.

:PDR3-SpecializationSourceAndOtherRelationship
    a sh:NodeShape ;
    sh:targetSubjectsOf am:specializes ;
    sh:rule :PDR3 ;
.

:PDR3
    a sh:SPARQLRule , prov:Plan ;
    skos:prefLabel "PDR3: Another relationship from the specialized element"@en ;
    skos:definition "a is a specialization of b and a has a structural, dependency or dynamic relationship to c: b may have it to c."@en ;
    dcterms:source <https://pubs.opengroup.org/architecture/archimate3-doc/ch-relationships-Normative.html> ;
    sh:prefixes <https://meta.linked.archi/archimate3/derivation#> ;
    sh:construct """
        CONSTRUCT {
            ?_resource a ?_class ;
                arch:source ?b ;
                arch:target ?c ;
                rdf:reifies <<( ?b ?t ?c )>> ;
                :derivationCertainty :Potential ;
                prov:wasDerivedFrom ?_premise1 , ?_premise2 ;
