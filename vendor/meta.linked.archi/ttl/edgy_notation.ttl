@prefix edgy:    <https://meta.linked.archi/edgy/onto#> .
@prefix arch:    <https://meta.linked.archi/core#> .
@prefix arch-vis:<https://meta.linked.archi/core-vis#> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://meta.linked.archi/edgy/notation#>
    a owl:Ontology ;
    owl:imports <https://meta.linked.archi/core#> ,
                <https://meta.linked.archi/core-vis#> ;
    cc:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    vann:preferredNamespaceUri    "https://meta.linked.archi/edgy/notation#" ;
    vann:preferredNamespacePrefix "edgynot" ;
    dcterms:title "Linked.Archi EDGY 23 Visual Notation Set"@en ;
    dcterms:description "Updated visual notation descriptors for EDGY 23 enterprise design elements, relationships, and labels. This set corrects the EDGY base shapes, facet/intersection colours, relationship line semantics, and icon/glyph references for Linked.Archi renderers."@en ;
    dcterms:creator "Kalin Maldzhanski"^^xsd:string ;
    dcterms:created "2025-06-27"^^xsd:date ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source <https://enterprise.design/wiki/Enterprise_Elements> ,
                   <https://enterprise.design/wiki/Enterprise_Design_Facets> ,
                   <https://www.hosiaisluoma.fi/EDGY-elements-and-relationships.pdf> ,
                   <https://enterprise.design/wiki/Tools> ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:rights '''Pictures and glyphs by Intersection Group: 18 of the element pictures in
https://meta.linked.archi/edgy/icons/ (activity, asset, brand, capability, channel, content, journey,
metrics, object, organisation, outcome, people, process, product, purpose, story, tagging, task) and 19
of the glyphs in https://meta.linked.archi/edgy/icons/glyphs/ (activity, asset, brand, capability,
channel, content, facet-architecture, facet-experience, facet-identity, journey, object, organisation,
outcome, people, process, product, purpose, story, task) are the EDGY 23 SVG shapes and icons of
Enterprise Design with EDGY (https://enterprise.design/wiki/Tools), used unchanged under CC BY-SA 4.0.
The other pictures and glyphs are drawn for Linked.Archi after the EDGY documentation, under the same
licence.'''@en ;
    owl:versionIRI <https://meta.linked.archi/edgy/notation/23#> ;
    owl:versionInfo "23 updated draft"@en ;
    skos:changeNote "2026-10-10: activities, stories, processes and journeys use edgynot:RightArrow and tags and metrics edgynot:Pill — both declared here with a core fallback and their geometry as path templates; the tag pill has its label inside (white on black), and the elements with white borders declare a black label (arch-vis:fontColor). edgynot:TagPill and edgynot:MetricPill are deprecated in favour of edgynot:Pill."@en .

edgynot:EDGYStandardNotation
    a arch-vis:NotationSet ;
    skos:prefLabel "EDGY 23 Standard Notation"@en ;
    skos:definition "The standard EDGY visual notation set: people as a glyph, outcomes as rounded rectangles, objects as sharp rectangles, activities as right-arrow shapes, facet colours for identity, architecture and experience, and distinct colours for organisation, brand and product intersections."@en ;
    rdfs:seeAlso <https://enterprise.design/wiki/Enterprise_Elements> .

edgynot:RightArrow
    a                      arch-vis:ShapeType ;
    skos:prefLabel         "Right Arrow"@en ;
    skos:definition        "A rectangle whose right side comes to a point at mid-height, h x 0.3 deep (24 in EDGY's 123 x 80 shape), at most w / 2. EDGY's activity, story, process and journey."@en ;
    arch-vis:fallbackShape arch-vis:Rectangle ;
    arch-vis:shapeVariables "d = min(h * 0.3, w / 2)" ;
    arch-vis:outlinePath   "M0,0 L{w - d},0 L{w},{h / 2} L{w - d},{h} L0,{h} Z" ;
    arch-vis:contentBox    "0 0 {w - d} {h}" ;
.

edgynot:Pill
    a                      arch-vis:ShapeType ;
    skos:prefLabel         "Pill"@en ;
    skos:definition        "A rectangle whose short ends are semicircles. EDGY's tags and metrics, with the label inside."@en ;
    arch-vis:fallbackShape arch-vis:RoundedRectangle ;
    arch-vis:shapeVariables "r = min(w, h) / 2" ;
    arch-vis:outlinePath   "M{r},0 L{w-r},0 A{r},{r} 0 0 1 {w},{r} L{w},{h-r} A{r},{r} 0 0 1 {w-r},{h} L{r},{h} A{r},{r} 0 0 1 0,{h-r} L0,{r} A{r},{r} 0 0 1 {r},0 Z" ;
    arch-vis:contentBox    "{r / 2} 0 {w - r} {h}" ;
.

edgynot:PeopleGlyph
    a arch-vis:ShapeType ;
    skos:prefLabel "People glyph"@en ;
    skos:definition "EDGY people element rendered as a person glyph rather than a container shape."@en .

edgynot:TagPill
    a arch-vis:ShapeType ;
    skos:prefLabel "Tag pill"@en ;
    skos:definition "EDGY black rounded pill used for tag labels."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy edgynot:Pill .

edgynot:MetricPill
    a arch-vis:ShapeType ;
    skos:prefLabel "Metric pill"@en ;
    skos:definition "EDGY coloured rounded pill used for metric labels."@en ;
    owl:deprecated true ;
    dcterms:isReplacedBy edgynot:Pill .

